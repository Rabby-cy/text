<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="FurnitureBase">
    <defName>Kiiro_CatmintCenser</defName>
    <label>catmint censer</label>
    <description>a specially censer made by kiiros, which is usually used to heat catmint.</description>
    <graphicData>
      <texPath>Kiiro/Building/CatmintCenser/CatmintCenser</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.8</drawSize>
	  <drawOffset>(0,0,0.2)</drawOffset>
      <shadowData>
        <volume>(0.4, 0.7, 0.4)</volume>
        <offset>(0.0, 0.0, -0.1)</offset>
      </shadowData>
      <damageData>
        <rect>(0,0.75,1.0,0.5)</rect>
      </damageData>
    </graphicData>
    <uiIconScale>0.85</uiIconScale>
    <costList>
      <Steel>45</Steel>
      <Kiiro_Nepetalactone>20</Kiiro_Nepetalactone>
    </costList>
	<costStuffCount>75</costStuffCount>
	<stuffCategories>
		<li>Woody</li>
	</stuffCategories>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>1.2</fuelConsumptionRate>
        <fuelCapacity>20.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>Kiiro_Nepetalactone</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
	  <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(184,136,83,0)</glowColor>
      </li>
    </comps>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <statBases>
      <MarketValue>275</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Beauty>15</Beauty>
      <Mass>12</Mass>
      <WorkToBuild>2000</WorkToBuild>
    </statBases>
    <fillPercent>0.2</fillPercent>
    <pathCost>30</pathCost>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
	<thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <specialDisplayRadius>29.9</specialDisplayRadius>
    <tradeability>Sellable</tradeability>
    <tickerType>Normal</tickerType>
	<drawerType>RealtimeOnly</drawerType>
	<researchPrerequisites>
		<li>Kiiro_NepetalactoneExtract</li>
	</researchPrerequisites>
  </ThingDef>



</Defs>