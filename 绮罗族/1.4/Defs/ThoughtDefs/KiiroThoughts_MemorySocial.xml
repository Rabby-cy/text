<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThoughtDef>
    <defName>Kiiro_PaperFoldingReceived</defName>
    <thoughtClass>Thought_MemorySocialCumulative</thoughtClass>
    <stackLimit>300</stackLimit>
	<stackLimitForSameOtherPawn>3</stackLimitForSameOtherPawn>
    <maxCumulatedOpinionOffset>30</maxCumulatedOpinionOffset>
	<stackedEffectMultiplier>0.9</stackedEffectMultiplier>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <socialTargetDevelopmentalStageFilter>Baby, Child, Adult</socialTargetDevelopmentalStageFilter>
    <stages>
      <li>
        <label>paperfolding received</label>
        <baseOpinionOffset>10</baseOpinionOffset>
      </li>
    </stages>
	<thoughtToMake>Kiiro_PaperFoldingReceivedMood</thoughtToMake>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Kiiro_PaperFoldingReceivedMood</defName>
