<!-- 绮罗猫猫斜挎包 -->
<ThingDef ParentName="Kiiro_MiddleBaseII">
	<defName>Kiiro_MessengerBag</defName>
	<label>kiiro messenger bag</label>
	<description>A messenger bag with a cat pattern, not very spacious, can hold some small items.</description>
	<costStuffCount>35</costStuffCount>
	<stuffCategories>
		<li>Leathery</li>
	</stuffCategories>
	<graphicData>
		<texPath>Kiiro/Apparel/Middle/MessengerBag/MessengerBag</texPath>
		<shaderType>CutoutComplex</shaderType>
	</graphicData>
	<statBases>
		<MaxHitPoints>60</MaxHitPoints>
		<WorkToMake>3200</WorkToMake>
		<StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
		<StuffEffectMultiplierInsulation_Cold>0</StuffEffectMultiplierInsulation_Cold>
		<StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
	</statBases>
	<apparel>
		<useWornGraphicMask>false</useWornGraphicMask>
		<developmentalStageFilter>Child, Adult</developmentalStageFilter>
		<layers Inherit="false">
			<li>Kiiro_Bag</li>
		</layers>
		<bodyPartGroups>
			<li>Shoulders</li>
		</bodyPartGroups>
		<wornGraphicPath>Kiiro/Apparel/Middle/MessengerBag/MessengerBag</wornGraphicPath>
		<tags>
		  <li>Kiiro_Bag</li>
		  <li>Kiiro_Shoulders</li>
		  <li>Kiiro_Messenger</li>
		</tags>
	</apparel>
	<equippedStatOffsets>
		<CarryingCapacity>10</CarryingCapacity>
	</equippedStatOffsets>
</ThingDef>

