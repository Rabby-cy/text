<!--=Arknights=-->
<ThingDef ParentName="Kiiro_OnSkinBaseCos"><!--厚重法官大衣-->
	<defName>Kiiro_Penance</defName>
	<label>judge's coat</label>
	<description>The clothing once worn by an upright and kind-hearted judge.</description>
	<costList>
		<DevilstrandCloth>55</DevilstrandCloth>
	</costList>
	<costStuffCount>220</costStuffCount>
	<stuffCategories>
		<li>Fabric</li>
		<li>Leathery</li>
	</stuffCategories>
	<graphicData>
		<texPath>Kiiro/Apparel/Special/Penance/Penance</texPath>
		<shaderType>CutoutComplex</shaderType>
	</graphicData>
	<statBases>
		<MaxHitPoints>360</MaxHitPoints>
		<WorkToMake>16000</WorkToMake>
		<StuffEffectMultiplierArmor>0.5</StuffEffectMultiplierArmor>
		<StuffEffectMultiplierInsulation_Cold>0.65</StuffEffectMultiplierInsulation_Cold>
		<StuffEffectMultiplierInsulation_Heat>0.65</StuffEffectMultiplierInsulation_Heat>
	</statBases>
	<apparel>
		<useWornGraphicMask>true</useWornGraphicMask>
		<layers>
			<li>Kiiro_Pants</li>
			<li>Middle</li>
			<li>Kiiro_Shell</li>
		</layers>
		<bodyPartGroups>
			<li>Torso</li>
			<li>Legs</li>
			<li>Arms</li>
			<li>Neck</li>
			<li>Shoulders</li>
			<li>Feet</li>
			<li>Hands</li>
		</bodyPartGroups>
		<wornGraphicPath>Kiiro/Apparel/Special/Penance/Penance</wornGraphicPath>
	</apparel>
	<equippedStatOffsets>
		<MentalBreakThreshold>-0.08</MentalBreakThreshold>
	</equippedStatOffsets>
</ThingDef>

