<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ApparelBase">
    <defName>Kiiro_PackJump</defName>
    <label>kiiro jump pack</label>
    <description>The petite kiiros couldn't fit into a human jumping pack, so they made their own lighter version.</description>
    <techLevel>Industrial</techLevel>
    <comps>
      <li Class="CompProperties_Reloadable">
        <maxCharges>5</maxCharges>
        <ammoDef>Chemfuel</ammoDef>
        <ammoCountPerCharge>10</ammoCountPerCharge>
        <baseReloadTicks>60</baseReloadTicks>
        <soundReload>Standard_Reload</soundReload>
        <hotKey>Misc4</hotKey>
        <chargeNoun>jump</chargeNoun>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
      </li>
    </comps>
    <verbs>
      <li>
        <verbClass>Verb_Jump</verbClass>
        <label>jump</label>
        <violent>false</violent>
        <hasStandardCommand>true</hasStandardCommand>
        <onlyManualCast>True</onlyManualCast>
        <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
        <warmupTime>0.3</warmupTime>
        <warmupEffecter>JumpWarmupEffect</warmupEffecter>
        <requireLineOfSight>true</requireLineOfSight>
        <flightEffecterDef>JumpFlightEffect</flightEffecterDef>
        <soundLanding>JumpPackLand</soundLanding>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetPawns>false</canTargetPawns>
          <canTargetBuildings>false</canTargetBuildings>
        </targetParams>
      </li>
    </verbs>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
      <researchPrerequisites>
        <li>JumpPack</li>
        <li>Kiiro_Machining</li>
      </researchPrerequisites>
      <recipeUsers>
        <li>Kiiro_MachiningBench</li>
      </recipeUsers>
      <useIngredientsForColor>false</useIngredientsForColor>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <displayPriority>330</displayPriority>
    </recipeMaker>
    <costList>
      <Plasteel>15</Plasteel>
      <ComponentIndustrial>5</ComponentIndustrial>
      <Chemfuel>50</Chemfuel>
    </costList>
    <graphicData>
      <texPath>Kiiro/Apparel/VanillaRe/JumpPack/JumpPack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>2</drawSize>
	  <drawOffset>(0,0,0.2)</drawOffset>
    </graphicData>
    <tickerType>Normal</tickerType>
    <statBases>
      <WorkToMake>12500</WorkToMake>
      <Mass>1.8</Mass>
      <Flammability>0.4</Flammability>
      <EquipDelay>1.5</EquipDelay>
      <JumpRange>23.9</JumpRange>
    </statBases>
    <thingCategories>
      <li>Kiiro_Apparel_Utility</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <scoreOffset>4</scoreOffset>
	  <wornGraphicData>
	    <renderUtilityAsPack>true</renderUtilityAsPack>
	  </wornGraphicData>
      <wornGraphicPath>Kiiro/Apparel/VanillaRe/JumpPack/JumpPack</wornGraphicPath>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>PackJump</li>
      </tags>
    </apparel>
    <tradeTags>
    </tradeTags>
    <allowedArchonexusCount>1</allowedArchonexusCount>
  </ThingDef>

  <ThingDef ParentName="ApparelNoQualityBase">
    <thingClass>Kiiro.DeploymentPack</thingClass>
    <defName>Kiiro_LowShieldPack</defName>
    <label>kiiro low shield pack</label>
    <description>A compact low shield backpack suitable for the kiiro equipment. When deployed, a low shield is generated to block bullets</description>
    <techLevel>Industrial</techLevel>
    <comps>
      <li Class="CompProperties_Reloadable">
        <maxCharges>1</maxCharges>
        <destroyOnEmpty>true</destroyOnEmpty>
        <soundReload>Standard_Reload</soundReload>
        <hotKey>Misc4</hotKey>
        <chargeNoun>shield</chargeNoun>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
      </li>
	  <li Class="Kiiro.CompProperties_Deplyment">
        <thingToDeploy>Kiiro_BroadshieldProjector</thingToDeploy>
        <deployFleck>Smoke</deployFleck>
      </li>
    </comps>
    <verbs>
      <li>
        <verbClass>Kiiro.Verb_DeployThing</verbClass>
        <label>deplay low shield</label>
        <violent>false</violent>
        <hasStandardCommand>true</hasStandardCommand>
        <targetable>false</targetable>
        <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
        <onlyManualCast>True</onlyManualCast>
      </li>
    </verbs>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
	  <researchPrerequisites>
        <li>ShieldBelt</li>
        <li>Kiiro_Machining</li>
      </researchPrerequisites>
      <recipeUsers>
        <li>Kiiro_MachiningBench</li>
      </recipeUsers>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <displayPriority>340</displayPriority>
    </recipeMaker>
    <costList>
      <BroadshieldCore>1</BroadshieldCore>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <graphicData>
      <texPath>Kiiro/Apparel/VanillaRe/BroadShieldPack/BroadShieldPack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>2</drawSize>
	  <drawOffset>(0,0,0.2)</drawOffset>
    </graphicData>
    <tickerType>Normal</tickerType>
    <statBases>
      <WorkToMake>12000</WorkToMake>
      <Mass>2.1</Mass>
      <Flammability>0.4</Flammability>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <thingCategories>
      <li>Kiiro_Apparel_Utility</li>
    </thingCategories>
    <generateAllowChance>0.15</generateAllowChance>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <scoreOffset>4</scoreOffset>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
	    <li>Kiiro_LowShieldPack</li>
      </tags>
      <wornGraphicPath>Kiiro/Apparel/VanillaRe/BroadShieldPack/BroadShieldPack</wornGraphicPath>
    </apparel>
    <tradeTags>
    </tradeTags>
    <allowedArchonexusCount>1</allowedArchonexusCount>
  </ThingDef>

  <ThingDef ParentName="ApparelBase">
    <defName>Kiiro_ArcShieldBelt</defName>
    <label>kiiro arc shield Belt</label>
    <description>A specially-made shield belt that can only be broken through when the damage it receives in an instant exceeds a certain threshold. It will immediately malfunction if hit by an EMP. /n it is incredible for a race which only has the pimary industrial production technology to achieve such a function.</description>
    <thingClass>Apparel</thingClass>
    <graphicData>
      <texPath>Kiiro/Apparel/VanillaRe/ShieldBelt_Arc/ShieldBeltArc</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Normal</tickerType>
    <techLevel>Spacer</techLevel>
    <statBases>
      <Mass>3</Mass>
      <WorkToMake>36000</WorkToMake>
      <Flammability>0.4</Flammability>
      <EnergyShieldRechargeRate>5.00</EnergyShieldRechargeRate>
      <EnergyShieldEnergyMax>0.50</EnergyShieldEnergyMax>
      <EquipDelay>1.2</EquipDelay>
    </statBases>
    <costList>
      <Kiiro_LowShieldPack>1</Kiiro_LowShieldPack>
	  <ComponentSpacer>4</ComponentSpacer>
      <Plasteel>60</Plasteel>
    </costList>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedBelt</unfinishedThingDef>
      <researchPrerequisites>
	    <li>ShieldBelt</li>
		<li>Kiiro_Machining</li>
		<li>Kiiro_Apparel_IV</li>
	  </researchPrerequisites>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers>
        <li>Kiiro_MachiningBench</li>
      </recipeUsers>
      <useIngredientsForColor>false</useIngredientsForColor>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <displayPriority>300</displayPriority>
    </recipeMaker>
    <thingCategories>
      <li>Kiiro_Apparel_Utility</li>
    </thingCategories>
    <apparel>
	  <wornGraphicPath>Kiiro/Apparel/VanillaRe/ShieldBelt_Arc/ShieldBeltArc</wornGraphicPath>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
	  <wornGraphicData>
	    <renderUtilityAsPack>true</renderUtilityAsPack>
	  </wornGraphicData>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>Kiiro_ShieldBelt</li>
      </tags>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    </apparel>
    <comps>
      <li Class="CompProperties_Shield" />
    </comps>
    <allowedArchonexusCount>1</allowedArchonexusCount>
  </ThingDef>

</Defs>