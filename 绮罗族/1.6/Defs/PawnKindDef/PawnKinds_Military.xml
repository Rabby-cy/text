<Defs>

  <!--=游击队=-->
  <PawnKindDef ParentName="Kiiro_PawnBase">    <!--绮罗游击队-->
    <defName>Kiiro_Guerrilla</defName>
    <label>kiiro guerrilla</label>
    <combatPower>110</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>true</isFighter>
    <factionLeader>false</factionLeader>
    <maxGenerationAge>45</maxGenerationAge>
    <minGenerationAge>20</minGenerationAge>
    <apparelMoney>800~2000</apparelMoney>
    <apparelTags>
      <li>Kiiro_GuerrillaHelmet</li>
      <li>Kiiro_GuerrillaHeadgear</li>
      <li>Kiiro_NormalArmor</li>
      <li>Kiiro_FirefoamPopPack</li>
    </apparelTags>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <requiredTag>Kiiro_GuerrillaWear</requiredTag>
      </li>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <requiredTag>Kiiro_Underwear</requiredTag>
      </li>
    </specificApparelRequirements>
    <apparelDisallowTags>
    </apparelDisallowTags>
    <apparelAllowHeadgearChance>0.5</apparelAllowHeadgearChance>
    <weaponTags>
      <li>Kiiro_TRWeapon</li>
    </weaponTags>
    <weaponMoney>600~1500</weaponMoney>
    <backstoryFiltersOverride>
      <li>
        <categories>
          <li>Kiiro_Guerrilla</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
    <inventoryOptions>
      <skipChance>0.85</skipChance>
      <subOptionsChooseOne>
        <li>
          <choiceChance>100</choiceChance>
          <thingDef>Silver</thingDef>
          <countRange>
            <min>20</min>
            <max>75</max>
          </countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
  </PawnKindDef>

