<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="MedicineBase">
    <defName>Kiiro_MixMedicineHerbal</defName>
    <label>schizonepeta mixed herbs</label>
    <description>A paste of herbs obtained by mixing and pounding Schizonepeta with herbs in a certain ratio which has a better therapeutic effect than ordinary herbs.</description>
    <graphicData>
      <texPath>Kiiro/Items/Resources/Medicine</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <statBases>
      <MarketValue>14</MarketValue>
      <Mass>0.38</Mass>
      <WorkToMake>200</WorkToMake>
      <Flammability>1.3</Flammability>
      <MedicalPotency>0.85</MedicalPotency>
      <MedicalQualityMax>1.10</MedicalQualityMax>
      <DeteriorationRate>4</DeteriorationRate>
    </statBases>
    <costList>
      <MedicineHerbal>1</MedicineHerbal>
      <Kiiro_SchizonepetaLeaf>8</Kiiro_SchizonepetaLeaf>
    </costList>
    <recipeMaker>
      <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
      <workSkill>Medicine</workSkill>
      <recipeUsers>
        <li>DrugLab</li>
      </recipeUsers>
      <researchPrerequisite>Kiiro_MixedMedicineHerbal</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
        <Medicine>4</Medicine>
      </skillRequirements>
      <bulkRecipeCount>5</bulkRecipeCount>
    </recipeMaker>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>90</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <allowedArchonexusCount>20</allowedArchonexusCount>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>Kiiro_Nepetalactone</defName>
    <label>nepetalactone powder</label>
