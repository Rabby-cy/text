  <ThingDef ParentName="MakeableShellBase">
    <defName>Shell_Flare</defName>
    <label>flare shell</label>
    <description>An artillery shell that, when detonated, can generate a bright area that lasts for a while.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Kiiro/Items/Resources/Ammo/FlareShell</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <costList>
      <Steel>15</Steel>
      <Chemfuel>15</Chemfuel>
    </costList>
    <costListForDifficulty>
      <difficultyVar>classicMortars</difficultyVar>
      <costList>
        <Steel>25</Steel>
        <Chemfuel>15</Chemfuel>
      </costList>
    </costListForDifficulty>
    <recipeMaker>
      <researchPrerequisite>Mortars</researchPrerequisite>
      <recipeUsers>
        <li>Kiiro_MachiningBench</li>
      </recipeUsers>
    </recipeMaker>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>2.9</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <explosiveExpandPerStackcount>0.4</explosiveExpandPerStackcount>
        <startWickHitPointsPercent>0.7</startWickHitPointsPercent>
        <wickTicks>30~60</wickTicks>
      </li>
    </comps>
    <projectileWhenLoaded>KiiroBullet_Shell_Flare</projectileWhenLoaded>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>KiiroBullet_Shell_Flare</defName>
    <label>flare shell</label>
    <graphicData>
      <texPath>Things/Projectile/ShellHighExplosive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>Smoke</damageDef>
      <speed>41</speed>
      <explosionRadius>0.1</explosionRadius>
      <flyOverhead>true</flyOverhead>
      <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
      <soundExplode>Kiiro_GrenadeDrop</soundExplode>
      <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
      <soundAmbient>MortarRound_Ambient</soundAmbient>
      <postExplosionSpawnThingDef>KiiroProjectile_Flare_Releasing</postExplosionSpawnThingDef>
    </projectile>
  </ThingDef>
  <ThingDef>
    <defName>KiiroProjectile_Flare_Releasing</defName>
    <label>flare glow</label>
    <graphicData>
      <texPath>Kiiro/Mote/FlareGlow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>2</drawSize>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <selectable>false</selectable>
    <tickerType>Normal</tickerType>
    <thingClass>ThingWithComps</thingClass>
    <useHitPoints>false</useHitPoints>
    <rotatable>false</rotatable>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>15</glowRadius>
        <glowColor>(217,217,208,0)</glowColor>
      </li>
      <li Class="CompProperties_DestroyAfterDelay">
        <delayTicks>6000</delayTicks>        <!-- 100 sec -->
      </li>
    </comps>
  </ThingDef>

</Defs>