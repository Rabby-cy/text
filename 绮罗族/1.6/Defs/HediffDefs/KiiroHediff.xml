<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
		<defName>Kiiro_FireRetardant</defName>
		<label>fire retardant clothing</label>
		<description>Covered in a fire-retardant clothing.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<stages>
			<li>
				<statFactors>
					<Flammability>0</Flammability>
				</statFactors>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_RemoveIfApparelDropped"/>
		</comps>
		<isBad>false</isBad>
	</HediffDef>

  <HediffDef>
    <defName>Kiiro_AteCatmint</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>intake catmint </label>
    <description>catmint makes kiiro feel good.</description>
    <defaultLabelColor>(0.6,0.8,0.6)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.95</painFactor>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>0.05</offset>
          </li>
        </capMods>
        <statOffsets>
          <GlobalLearningFactor>0.1</GlobalLearningFactor>
          <GeneralLaborSpeed>0.1</GeneralLaborSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef MayRequire="Ludeon.RimWorld.Odyssey">
		<defName>Kiiro_OxygenTank</defName>
		<label>oxygen tank</label>
		<description>The oxygen tank carried by this creature provides its oxygen supply.</description>
		<hediffClass>AncotLibrary.HediffWithSeverityLabel</hediffClass>
    <maxSeverity>1</maxSeverity>
    <minSeverity>0.01</minSeverity>
		<initialSeverity>0.1</initialSeverity>
		<isBad>false</isBad>
		<stages>
			<li>
        <minSeverity>0.01</minSeverity>
        <statOffsets>
					<VacuumResistance>0</VacuumResistance>
				</statOffsets>
      </li>
			<li>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
					<VacuumResistance>0.3</VacuumResistance>
				</statOffsets>
      </li>
			<li>
        <minSeverity>0.4</minSeverity>
        <statOffsets>
					<VacuumResistance>0.4</VacuumResistance>
				</statOffsets>
      </li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_RemoveIfApparelDropped"/>
			<li Class="AncotLibrary.HediffCompProperties_SeverityChangeByVacuum">
        <severityPerTick_High>0.00005</severityPerTick_High>
        <severityPerTick_Low>0.000025</severityPerTick_Low>
      </li>
		</comps>
	</HediffDef>


</Defs>