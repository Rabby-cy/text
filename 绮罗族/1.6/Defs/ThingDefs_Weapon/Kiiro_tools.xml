  <ThingDef ParentName="Kiiro_ToolBase">
    <defName>Kiiro_Pickaxe</defName>
    <label>kiiro pickaxe</label>
    <description>The pickaxe used to extract minerals can easily chisel through the rock.</description>
    <graphicData>
      <texPath>Kiiro/Weapon/Tool/Pickaxe</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1.0</drawSize>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <weaponTags Inherit="false">
      <li>Kiiro_Miner</li>
      <li>Kiiro_WorkerTool</li>
    </weaponTags>
    <costList>
      <WoodLog>45</WoodLog>
    </costList>
    <costStuffCount>50</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <statBases>
      <WorkToMake>8400</WorkToMake>
      <Mass>1.8</Mass>
    </statBases>
    <equippedStatOffsets>
      <MiningSpeed>0.45</MiningSpeed>
      <MiningYield>0.25</MiningYield>
    </equippedStatOffsets>
    <equippedAngleOffset>-15</equippedAngleOffset>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2.5</cooldownTime>
      </li>
    </tools>
  </ThingDef>

