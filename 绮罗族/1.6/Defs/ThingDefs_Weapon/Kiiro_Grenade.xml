<?xml version="1.0" encoding="utf-8" ?>

<Defs>
  <ThingDef Name="Kiiro_GrenadesBase" ParentName="BaseMakeableGrenade" Abstract="True">
	<recipeMaker>
	  <researchPrerequisite>Kiiro_Grenades</researchPrerequisite>
	  <recipeUsers Inherit="false">
	    <li>Kiiro_FueledSmithy</li>
	    <li>Kiiro_ElectricSmithy</li>
	  </recipeUsers>
	</recipeMaker>
	<techLevel>Industrial</techLevel>
	<soundInteract>Interact_Grenade</soundInteract>
	<thingCategories>
      <li>Grenades</li>
    </thingCategories>
	<smeltable>true</smeltable>
	<comps>
    </comps>
  </ThingDef>
  
  
  <ThingDef ParentName="Kiiro_GrenadesBase">
    <defName>Kiiro_GrenadeFrag</defName>
    <label>kiiro wooden handle grenade</label>
    <description>The wooden-handled grenade, developed according to the fragmentation grenades used by humans, is inferior in power, but benefits from a shape that is easier to throw over longer distances.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Kiiro/Weapon/Industry/GrenadeFrag</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>0.4</drawSize>
    </graphicData>
    <uiIconScale>1.0</uiIconScale>
    <statBases>
      <Mass>0.8</Mass>
      <RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
      <WorkToMake>9600</WorkToMake>
    </statBases>
    <costList>
      <Steel>20</Steel>
      <Chemfuel>35</Chemfuel>
	  <WoodLog>40</WoodLog>
    </costList>
    <weaponTags>
      <li>Kiiro_GrenadeFrag</li>
    </weaponTags>
    <verbs>
      <li>
        <label>throw</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>14.9</range>
        <forcedMissRadius>1.2</forcedMissRadius>
        <warmupTime>1.0</warmupTime>
        <noiseRadius>2</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>KiiroProjectile_GrenadeFrag</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
	<comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>2.4</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="BaseFragGrenadeProjectile">
    <defName>KiiroProjectile_GrenadeFrag</defName>
    <label>kiiro frag grenade</label>
    <graphicData>
      <texPath>Kiiro/Weapon/Industry/Projectile/GrenadeFragThrown</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>0.7</drawSize>
    </graphicData>
    <projectile>
	  <speed>21</speed>
      <arcHeightFactor>2</arcHeightFactor>
      <shadowSize>0.4</shadowSize>
	  <explosionRadius>1.9</explosionRadius>
      <damageAmountBase>12</damageAmountBase>
	  <armorPenetrationBase>0.22</armorPenetrationBase>
      <stoppingPower>1.2</stoppingPower>
	  <explosionDelay>30</explosionDelay>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="Kiiro_GrenadesBase">
    <defName>Kiiro_GrenadeSmoke</defName>
    <label>kiiro smoke grenade</label>
    <description>Grenades filled with special drugs, although the explosion will not cause any damage, but will release a lot of blinding smoke.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Kiiro/Weapon/Industry/GrenadeSmoke</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>0.4</drawSize>
    </graphicData>
    <uiIconScale>1.0</uiIconScale>
	<equippedAngleOffset>-55</equippedAngleOffset>
    <statBases>
      <Mass>0.8</Mass>
      <RangedWeapon_Cooldown>2.8</RangedWeapon_Cooldown>
      <WorkToMake>10800</WorkToMake>
    </statBases>
    <costList>
      <Steel>15</Steel>
      <Chemfuel>50</Chemfuel>
    </costList>
    <weaponTags>
      <li>Kiiro_GrenadeSmoke</li>
    </weaponTags>
	<recipeMaker>
	  <researchPrerequisites>
	    <li>SmokepopBelt</li>
	  </researchPrerequisites>
    </recipeMaker>
    <verbs>
      <li>
        <label>throw</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>11.9</range>
        <forcedMissRadius>1.2</forcedMissRadius>
        <warmupTime>1.6</warmupTime>
        <noiseRadius>2</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>KiiroProjectile_GrenadeSmoke</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
	<comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>2.4</explosiveRadius>
        <explosiveDamageType>Smoke</explosiveDamageType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="BaseFragGrenadeProjectile">
    <defName>KiiroProjectile_GrenadeSmoke</defName>
    <label>kiiro smoke grenade</label>
    <graphicData>
      <texPath>Kiiro/Weapon/Industry/Projectile/GrenadeSmokeThrown</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>0.7</drawSize>
    </graphicData>
    <projectile>
	  <speed>21</speed>
      <arcHeightFactor>2</arcHeightFactor>
      <shadowSize>0.4</shadowSize>
	  <explosionRadius>0.1</explosionRadius>
      <damageDef>Smoke</damageDef>
	  <postExplosionGasType>BlindSmoke</postExplosionGasType>
	  <ai_IsIncendiary>true</ai_IsIncendiary>
	  <explosionDelay>30</explosionDelay>
	  <postExplosionSpawnThingDef>KiiroGrenade_Smoke_Releasing</postExplosionSpawnThingDef>
    </projectile>
  </ThingDef>
  <ThingDef>
    <defName>KiiroGrenade_Smoke_Releasing</defName>
	<label>Smoke Grenade</label>
    <graphicData>
      <texPath>Kiiro/Weapon/Industry/Projectile/GrenadeSmokeThrown</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>0.8</drawSize>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <selectable>false</selectable>
    <tickerType>Normal</tickerType>
    <thingClass>ThingWithComps</thingClass>
    <useHitPoints>false</useHitPoints>
    <rotatable>false</rotatable>
    <comps>
      <li Class="CompProperties_ReleaseGas">
        <gasType>BlindSmoke</gasType>
        <cellsToFill>55</cellsToFill>
        <durationSeconds>6</durationSeconds>
        <effecterReleasing>BlindSmokeReleasing</effecterReleasing>
      </li>
      <li Class="CompProperties_DestroyAfterDelay">
        <delayTicks>480</delayTicks><!-- 8 sec -->
      </li>
    </comps>
  </ThingDef>
  
  <ThingDef ParentName="Kiiro_GrenadesBase">
    <defName>Kiiro_GrenadeFlash</defName>
    <label>kiiro flash grenade</label>
    <description>A grenade used in special operations that emits a bright light when it explodes.</description>
    <tickerType>Normal</tickerType>
	<generateCommonality>0.3</generateCommonality>
    <graphicData>
      <texPath>Kiiro/Weapon/Industry/GrenadeFlash</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>0.4</drawSize>
    </graphicData>
    <uiIconScale>1.0</uiIconScale>
	<equippedAngleOffset>-55</equippedAngleOffset>
	<techLevel>Industrial</techLevel>
    <statBases>
      <Mass>0.8</Mass>
      <RangedWeapon_Cooldown>5.80</RangedWeapon_Cooldown>
      <WorkToMake>14400</WorkToMake>
    </statBases>
    <costList>
      <Steel>45</Steel>
	  <Chemfuel>20</Chemfuel>
    </costList>
	<recipeMaker>
		<skillRequirements>
		  <Crafting>8</Crafting>
		</skillRequirements>
	</recipeMaker>
    <weaponTags>
      <li>Kiiro_GrenadeFlash</li>
    </weaponTags>
    <verbs>
      <li>
        <label>throw</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>11.9</range>
        <forcedMissRadius>1.2</forcedMissRadius>
        <warmupTime>2.5</warmupTime>
        <noiseRadius>2</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>KiiroProjectile_GrenadeFlash</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
	<comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>2.4</explosiveRadius>
        <explosiveDamageType>Stun</explosiveDamageType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="BaseFragGrenadeProjectile">
    <defName>KiiroProjectile_GrenadeFlash</defName>
    <label>kiiro flash grenade</label>
    <graphicData>
      <texPath>Kiiro/Weapon/Industry/Projectile/GrenadeFlashThrown</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>0.7</drawSize>
    </graphicData>
    <projectile>
	  <speed>21</speed>
      <arcHeightFactor>2</arcHeightFactor>
      <shadowSize>0.4</shadowSize>
	  <explosionRadius>3.6</explosionRadius>
	  <damageDef>Stun</damageDef>
      <damageAmountBase>10</damageAmountBase>
	  <armorPenetrationBase>0.22</armorPenetrationBase>
      <stoppingPower>1.2</stoppingPower>
	  <explosionDelay>30</explosionDelay>
    </projectile>
  </ThingDef>





</Defs>