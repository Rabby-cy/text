  <!--机制生效心情-->
  <ThoughtDef>
    <defName>Kiiro_FactionHostility</defName>
    <workerClass>Kiiro.ThoughtWorker_HostileToKiiroFaction</workerClass>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>Be hostile with kiiros</label>
        <description>There must be some misunderstanding in all of this. If we have a proper conversation, things will surely get better...</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>Kiiro_FactionHostilityForever</defName>
    <!--这个是派系完全消失的心情，这个需要在世界class写一个bool，避免疯狂检测心情是否加上-->
    <workerClass>Kiiro.ThoughtWorker_FactionHostilityForever</workerClass>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <!-- <durationDays>15</durationDays> -->
    <stages>
      <li>
        <label>Break with kiiros</label>
        <description>Why do we have to do such things...? I'm no longer sure if staying here is the right choice.</description>
        <baseMoodEffect>-15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>Kiiro_FactionFriendly</defName>
    <!--<durationDays>15</durationDays>-->
    <workerClass>Kiiro.ThoughtWorker_FactionFriendly</workerClass>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>Be alliance with kiiros</label>
        <description>May our friendship last for generations to come.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
