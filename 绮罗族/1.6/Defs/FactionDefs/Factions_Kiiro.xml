<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <FactionDef Name="Kiiro_PlayerFaction" ParentName="PlayerFactionBase">
    <defName>Kiiro_PlayerFaction</defName>
    <label>kiiro new home</label>
    <description>A new settlement of kiiro. Where will the story lead it to?</description>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <categoryTag>Kiiro_PlayerFaction</categoryTag>
    <colorSpectrum>
      <li>(1, 1, 1)</li>
    </colorSpectrum>
    <isPlayer>true</isPlayer>
    <basicMemberKind>Kiiro_Colonist</basicMemberKind>
    <pawnSingular>kiiro inhabitant</pawnSingular>
    <pawnsPlural>kiiro inhabitants</pawnsPlural>
    <techLevel>Medieval</techLevel>
    <melaninRange>0</melaninRange>
    <allowedCultures>
      <li>KiiroTraditionalCulture</li>
    </allowedCultures>
    <disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Transhumanist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Guilty</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">PainIsVirtue</li>
    </disallowedMemes>
    <backstoryFilters>
      <li>
        <categories>
          <li>Kiiro_General</li>
        </categories>
        <commonality>1</commonality>
      </li>
    </backstoryFilters>
    <factionIconPath>Kiiro/Faction/Faction_Icon_2</factionIconPath>
    <playerInitialSettlementNameMaker>NamerInitialSettlementColony</playerInitialSettlementNameMaker>
    <factionNameMaker>NamerFactionOutlander</factionNameMaker>
    <settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
    <!-- <settlementNameMaker>Kiiro_NamerFaction_KiiroSettlement</settlementNameMaker> -->
    <!-- <geneticVariance>1</geneticVariance> -->
    <startingResearchTags>
      <li>KiiroRefugeeStart</li>
      <li>KiiroRefugeeStart</li>
    </startingResearchTags>
    <startingTechprintsResearchTags>
      <li>KiiroRefugeeStart</li>
    </startingTechprintsResearchTags>
    <apparelStuffFilter>
      <stuffCategoriesToAllow>
        <li>Metallic</li>
        <li>Fabric</li>
      </stuffCategoriesToAllow>
      <disallowedThingDefs>
        <li>Synthread</li>
        <li>Hyperweave</li>
        <li>Silver</li>
        <li>Gold</li>
        <li>Uranium</li>
      </disallowedThingDefs>
    </apparelStuffFilter>
  </FactionDef>


