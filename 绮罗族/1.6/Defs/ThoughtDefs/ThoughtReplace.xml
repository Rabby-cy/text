<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--===================== 朋友/仇人 =====================-->
  <ThoughtDef ParentName="DeathMemory">
    <defName>Kiiro_PawnWithGoodOpinionDied</defName>
    <durationDays>10</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <nullifyingTraits>
      <li>Psychopath</li>
    </nullifyingTraits>
    <stages>
      <li>
        <label>My friend {0} passed away</label>
        <description>This shouldn't be your outcome.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="DeathMemory">
    <defName>Kiiro_PawnWithBadOpinionDied</defName>
    <durationDays>5</durationDays>
    <stackLimit>5</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>My enemy {0} passed away</label>
        <description>Should I... feel happy about it?</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

