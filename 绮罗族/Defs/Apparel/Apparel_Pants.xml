<!-- 绮罗热裤 -->
<ThingDef ParentName="Kiiro_PantsBaseI">
	<defName>Kiiro_HotPant</defName>
	<label>kiiro hotpants</label>
	<description>Short pants that show legs.</description>
	<costStuffCount>35</costStuffCount>
	<stuffCategories>
		<li>Fabric</li>
		<li>Leathery</li>
	</stuffCategories>
	<graphicData>
		<texPath>Kiiro/Apparel/Pants/HotPant/HotPant</texPath>
	</graphicData>
	<statBases>
		<MaxHitPoints>100</MaxHitPoints>
		<WorkToMake>3400</WorkToMake>
		<StuffEffectMultiplierArmor>0.05</StuffEffectMultiplierArmor>
		<StuffEffectMultiplierInsulation_Cold>0.1</StuffEffectMultiplierInsulation_Cold>
		<StuffEffectMultiplierInsulation_Heat>0.2</StuffEffectMultiplierInsulation_Heat>
	</statBases>
	<apparel>
		<useWornGraphicMask>false</useWornGraphicMask>
		<bodyPartGroups>
			<li>Legs</li>
		</bodyPartGroups>
		<wornGraphicPath>Kiiro/Apparel/Pants/HotPant/HotPant</wornGraphicPath>
	</apparel>
	<equippedStatOffsets>
		<MentalBreakThreshold>-0.03</MentalBreakThreshold>
		<SocialImpact>0.03</SocialImpact>
	</equippedStatOffsets>
</ThingDef>

