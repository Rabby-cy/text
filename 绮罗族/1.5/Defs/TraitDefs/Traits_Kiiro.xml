<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- 小懒猫 -->
  <TraitDef>
    <defName>LazyCat</defName>
	<commonality>0.9</commonality>
    <degreeDatas>
      <li>
        <label>lazy cat</label>
        <description>{PAWN_nameDef} loves to sleep and always feels like {PAWN_pronoun} hasn't had enough rest.</description>
        <statOffsets>
          <RestRateMultiplier>-0.2</RestRateMultiplier>
        </statOffsets>
      </li>
    </degreeDatas>
	<conflictingTraits>
      <li>QuickSleeper</li>
	  <li>GreedyCat</li>
    </conflictingTraits>
  </TraitDef>

<!-- 小馋猫 -->
  <TraitDef>
    <defName>GreedyCat</defName>
	<commonality>0.9</commonality>
    <degreeDatas>
      <li>
        <label>greedy cat</label>
        <description>{PAWN_nameDef} always carries a lot of snacks with {PAWN_pronoun}, and {PAWN_pronoun} never stops munching on them.</description>
		<theOnlyAllowedMentalBreaks>
          <li>Binging_Food</li>
        </theOnlyAllowedMentalBreaks>
        <hungerRateFactor>1.25</hungerRateFactor>
		<skillGains>
          <Cooking>2</Cooking>
        </skillGains>
      </li>
    </degreeDatas>
	<conflictingTraits>
      <li>Gourmand</li>
	  <li>LazyCat</li>
    </conflictingTraits>
  </TraitDef>

<!-- 畏火 -->
  <TraitDef>
    <defName>FireFear</defName>
	<commonality>0.001</commonality>
	<disabledWorkTags>Firefighting</disabledWorkTags>
    <degreeDatas>
      <li>
        <label>fire fear</label>
        <description>From some experience, {PAWN_nameDef} is very afraid of fire.</description>
		<skillGains>
          <Cooking>-5</Cooking>
        </skillGains>
      </li>
    </degreeDatas>
  </TraitDef>

<!-- 抵抗力 -->
  <TraitDef>
    <defName>ToxicResistance</defName>
	<commonality>0.001</commonality>
    <degreeDatas>
      <li>
        <label>toxic resistance</label>
        <description>{PAWN nameDef} has innate resistance to toxic.</description>
        <statOffsets>
          <ToxicEnvironmentResistance>0.25</ToxicEnvironmentResistance>
        </statOffsets>
      </li>
    </degreeDatas>
  </TraitDef>

<!-- 锐瞳 -->
  <TraitDef>
    <defName>SharpEye</defName>
	<commonality>0.9</commonality>
    <degreeDatas>
      <li>
        <label>sharp eye</label>
        <description>{PAWN_nameDef} has exceptional eyesight.</description>
		<skillGains>
          <Shooting>2</Shooting>
        </skillGains>
        <statOffsets>
          <ShootingAccuracyPawn>8.0</ShootingAccuracyPawn>
        </statOffsets>
      </li>
    </degreeDatas>
  </TraitDef>

<!-- 旧伤 -->
  <TraitDef>
    <defName>OldWound</defName>
	<commonality>0.005</commonality>
    <degreeDatas>
      <li>
        <label>old wound</label>
        <description>{PAWN_nameDef}'s body has suffered severe wound that has caused irreparable damage.</description>
        <statOffsets>
		  <MoveSpeed>-0.15</MoveSpeed>
		  <PainShockThreshold>-0.08</PainShockThreshold>
        </statOffsets>
		<statFactors>
          <IncomingDamageFactor>1.05</IncomingDamageFactor>
        </statFactors>
      </li>
    </degreeDatas>
  </TraitDef>

<!-- 猫咪勇者！ -->
  <TraitDef>
    <defName>KittyValor</defName>
    <commonality>0.0001</commonality>
    <degreeDatas>
      <li>
        <label>kitty valor!</label>
        <description>{PAWN_nameDef}is a valor supported by kiiros.</description>
        <skillGains>
          <Melee>5</Melee>
        </skillGains>
        <statOffsets>
          <SocialImpact>0.25</SocialImpact>
          <MoveSpeed>0.15</MoveSpeed>
          <PainShockThreshold>0.3</PainShockThreshold>
          <MentalBreakThreshold>-0.4</MentalBreakThreshold>
          <MeleeDodgeChance>10.0</MeleeDodgeChance>
          <MeleeHitChance>5.0</MeleeHitChance>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.50</IncomingDamageFactor>
        </statFactors>
      </li>
    </degreeDatas>
  </TraitDef>


</Defs>