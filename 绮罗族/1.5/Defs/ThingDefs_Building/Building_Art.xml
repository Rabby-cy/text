<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase" Name="PaperArtBase" Abstract="True">
    <thingClass>Building_Art</thingClass>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
	  <clearBuildingArea>false</clearBuildingArea>
    <pathCost>20</pathCost>
    <useHitPoints>true</useHitPoints>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsArt</li>
    </thingCategories>
    <thingSetMakerTags>
	  <!--<li>RewardStandardLowFreq</li>-->
	</thingSetMakerTags>
    <statBases>
      <Flammability>2.0</Flammability>
      <SellPriceFactor>1.25</SellPriceFactor>
      <MeditationFocusStrength>0.0</MeditationFocusStrength>
    </statBases>
	<building>
		<isEdifice>false</isEdifice>
		<ai_chillDestination>false</ai_chillDestination>
		<canPlaceOverWall>false</canPlaceOverWall>
	</building>
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_Art</li>
    </inspectorTabs>
    <tradeTags>
      <li>Art</li>
      <li>Kiiro_PaperArt</li>
    </tradeTags>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Artistic</workSkill>
      <unfinishedThingDef>UnfinishedPaperFolding</unfinishedThingDef>
      <effectWorking>Sculpt</effectWorking>
      <soundWorking>Recipe_Sculpt</soundWorking>
      <recipeUsers>
        <li>Kiiro_PaperArtBench</li>
      </recipeUsers>
      <defaultIngredientFilter>
        <categories>
          <li>Root</li>
        </categories>
        <disallowedThingDefs>
          <li>Gold</li>
          <li>Silver</li>
          <li>Plasteel</li>
          <li>Jade</li>
          <li>Uranium</li>
        </disallowedThingDefs>
      </defaultIngredientFilter>
    </recipeMaker>
  </ThingDef>


  <ThingDef ParentName="PaperArtBase">
    <defName>Kiiro_PaperArt</defName>
    <label>kiiro paper art</label>
    <description>delicate paper folding art.it is rare to see such artwork in a rimworld.</description>
    <castEdgeShadows>true</castEdgeShadows>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <texPath>Kiiro/Building/PaperArt</texPath>
      <drawSize>(0.6,0.6)</drawSize>
	  <drawOffset>(0,0,0)</drawOffset>
	  <shaderType>CutoutComplex</shaderType>
	  <shadowData>
		<volume>(0.2, 0.2, 0.2)</volume>
		<offset>(0,0,0)</offset>
	  </shadowData>
    </graphicData>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>10</MaxHitPoints>
      <Mass>0.5</Mass>
      <Beauty>85</Beauty>
      <WorkToMake>27000</WorkToMake>
    </statBases>
	<costList>
	  <Kiiro_Paper>2</Kiiro_Paper>
    </costList>
	<researchPrerequisites>
		<li>Kiiro_PaperFolding</li>
	</researchPrerequisites>
  </ThingDef>


</Defs>