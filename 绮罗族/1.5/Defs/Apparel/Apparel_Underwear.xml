<!-- 绮罗草药敷 -->
<ThingDef ParentName="Kiiro_UnderwearPropBase">
	<defName>Kiiro_Woundplast</defName>
	<label>kiiro woundplast</label>
	<description>A medicinal poultice made by wrapping a paste-like mixture of herbs in cloth, allowing the medicinal ingredients to slowly be absorbed through the skin. It can expedite the body's recovery.\nDo not post to weird areas!</description>
	<costList>
		<Cloth>5</Cloth>
		<Kiiro_MixMedicineHerbal>1</Kiiro_MixMedicineHerbal>
	</costList>
	<graphicData>
		<texPath>Kiiro/Apparel/Underwear/Props/Woundplast</texPath>
		<shaderType>CutoutComplex</shaderType>
		<drawSize>0.6</drawSize>
	</graphicData>
	<statBases>
		<MaxHitPoints>60</MaxHitPoints>
		<WorkToMake>3200</WorkToMake>
	</statBases>
	<recipeMaker>
		<researchPrerequisites>
		  <li>Kiiro_MixedMedicineHerbal</li>
		</researchPrerequisites>
	</recipeMaker>
	<apparel>
		<useWornGraphicMask>false</useWornGraphicMask>
		<bodyPartGroups>
			<li>Waist</li>
		</bodyPartGroups>
		<tags>
		  <li>Kiiro_Woundplast</li>
		</tags>
	</apparel>
	<equippedStatOffsets>
		<ImmunityGainSpeed>0.05</ImmunityGainSpeed>
	</equippedStatOffsets>
</ThingDef>

