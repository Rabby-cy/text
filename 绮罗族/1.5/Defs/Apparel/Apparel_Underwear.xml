<ThingDef Name="Kiiro_UnderwearPropBase" ParentName="Kiiro_ApparelBase" Abstract="True">
	<statBases>
		<Mass>0.2</Mass>
		<EquipDelay>1.0</EquipDelay>
	</statBases>
	<graphicData>
      <onGroundRandomRotateAngle>0</onGroundRandomRotateAngle>
	  <drawSize>1.0</drawSize>
	  <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
	<recipeMaker>
		<researchPrerequisite>Kiiro_Apparel_II</researchPrerequisite>
		<unfinishedThingDef>UnfinishedKiiroApparel</unfinishedThingDef>
	</recipeMaker>
	<apparel>
	    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
		<countsAsClothingForNudity>false</countsAsClothingForNudity>
		<careIfWornByCorpse>false</careIfWornByCorpse>
        <careIfDamaged>false</careIfDamaged>
        <wearPerDay>2</wearPerDay>
		<layers>
			<li>Kiiro_Underwear</li>
		</layers>
		<tags>
			<li>Kiiro_UnderwearProp</li>
			<li>Royal</li>
			<li>RoyalTier5</li>
		</tags>
	</apparel>
	<comps Inherit="false"><!--不继承品质-->
      <li Class="CompProperties_Forbiddable"/>
    </comps>
	<thingCategories>
      <li>Kiiro_Apparel_Utility</li>
    </thingCategories>
	<generateAllowChance>0</generateAllowChance>
</ThingDef>

<!-- 绮罗猫爪暖手宝 -->
<ThingDef ParentName="Kiiro_UnderwearPropBase">
	<defName>Kiiro_HandWarmer</defName>
	<label>kiiro handwarmer</label>
	<description>A small cloth bag embroidered with cat paw prints. It can hold hot water and keep it warm for a long time, providing a cozy warmth when held close.</description>
	<costList>
		<Cloth>40</Cloth>
	</costList>
	<graphicData>
		<texPath>Kiiro/Apparel/Underwear/Props/HandWarmer</texPath>
		<shaderType>CutoutComplex</shaderType>
		<drawSize>0.6</drawSize>
	</graphicData>
	<statBases>
		<MaxHitPoints>60</MaxHitPoints>
		<WorkToMake>3200</WorkToMake>
		<Insulation_Cold>10</Insulation_Cold>
		<Insulation_Heat>-10</Insulation_Heat>
	</statBases>
	<apparel>
		<useWornGraphicMask>false</useWornGraphicMask>
		<bodyPartGroups>
			<li>Waist</li>
		</bodyPartGroups>
		<tags>
		  <li>Kiiro_HandWarmer</li>
		</tags>
	</apparel>
</ThingDef>

