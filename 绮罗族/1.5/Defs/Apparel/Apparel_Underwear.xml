<Defs>

<ThingDef Name="Kiiro_UnderwearBase" ParentName="Kiiro_ApparelBase" Abstract="True">
	<defName>Kiiro_Apparel_Underwear</defName>
	<recipeMaker>
	    <!--<displayPriority>900</displayPriority>-->
		<researchPrerequisite>Kiiro_Apparel_I</researchPrerequisite>
	</recipeMaker>
	<costStuffCount>25</costStuffCount>
	<stuffCategories>
		<li>Fabric</li>
	</stuffCategories>
	<statBases>
		<Mass>0.2</Mass>
		<EquipDelay>1.2</EquipDelay>
		<MaxHitPoints>150</MaxHitPoints>
		<WorkToMake>3600</WorkToMake>
		<StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
		<Insulation_Cold>5</Insulation_Cold>
        <Insulation_Heat>5</Insulation_Heat>
		<StuffEffectMultiplierInsulation_Cold>0.20</StuffEffectMultiplierInsulation_Cold>
		<StuffEffectMultiplierInsulation_Heat>0.40</StuffEffectMultiplierInsulation_Heat>
	</statBases>
	<apparel>
	    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
		<layers>
			<li>Kiiro_Underwear</li>
		</layers>
		<tags>
			<li>Kiiro_Underwear</li>
			<li>Royal</li>
			<li>RoyalTier5</li>
		</tags>
	</apparel>
	<equippedStatOffsets>
		<MentalBreakThreshold>-0.02</MentalBreakThreshold>
	</equippedStatOffsets>
	<thingCategories>
		<li>Kiiro_Apparel_Underwear</li>
	</thingCategories>
	<tradeTags>
      <li>Kiiro_DailyClothing</li>
    </tradeTags>
</ThingDef>

