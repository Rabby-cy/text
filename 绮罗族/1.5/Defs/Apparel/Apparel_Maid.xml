<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<ThingDef Name="Kiiro_OnSkinBaseMaid" ParentName="Kiiro_OnSkinBase" Abstract="True">
	<recipeMaker>
		<researchPrerequisite>Kiiro_Apparel_Maid</researchPrerequisite>
	</recipeMaker>
	<statBases>
		<MaxHitPoints>180</MaxHitPoints>
		<WorkToMake>10200</WorkToMake>
		<ArmorRating_Sharp>0.10</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
        <ArmorRating_Heat>0.12</ArmorRating_Heat>
		<StuffEffectMultiplierArmor>0.15</StuffEffectMultiplierArmor>
		<Insulation_Cold>14</Insulation_Cold>
        <Insulation_Heat>12</Insulation_Heat>
		<StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
		<StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
	</statBases>
	<costList>
		<DevilstrandCloth>45</DevilstrandCloth>
	</costList>
	<costStuffCount>145</costStuffCount>
	<stuffCategories>
		<li>Fabric</li>
		<li>Leathery</li>
	</stuffCategories>
	<apparel>
	    <useWornGraphicMask>true</useWornGraphicMask>
		<layers>
			<li>Kiiro_Pants</li>
			<li>Middle</li>
			<li>Shell</li>
		</layers>
		<tags>
			<li>Kiiro_OnSkin</li>
			<li>Kiiro_Maid</li>
		</tags>
		<bodyPartGroups>
			<li>Torso</li>
			<li>Legs</li>
			<li>Arms</li>
			<li>Neck</li>
			<li>Shoulders</li>
			<li>Feet</li>
			<li>Hands</li>
		</bodyPartGroups>
		<drawData>
			<dataNorth><layer>40</layer></dataNorth>
		</drawData>
	</apparel>
	<tradeTags>
		<li>Kiiro_Maid</li>
	</tradeTags>
</ThingDef>

