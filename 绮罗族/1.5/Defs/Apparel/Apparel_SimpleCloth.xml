<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<ThingDef Name="Kiiro_SimpleBase" ParentName="Kiiro_ApparelBase" Abstract="True">
	<defName>Kiiro_Apparel_SimpleCloth</defName>
	<stuffCategories>
		<li>Fabric</li>
		<li>Leathery</li>
	</stuffCategories>
	<statBases>
		<Mass>0.2</Mass>
		<EquipDelay>1.2</EquipDelay>
		<MaxHitPoints>100</MaxHitPoints>
		<WorkToMake>1800</WorkToMake>
		<StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
		<StuffEffectMultiplierInsulation_Cold>0.20</StuffEffectMultiplierInsulation_Cold>
		<StuffEffectMultiplierInsulation_Heat>0.40</StuffEffectMultiplierInsulation_Heat>
	</statBases>
	<apparel>
	    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
		<tags>
			<li>Kiiro_Simplewear</li>
		</tags>
	</apparel>
	<recipeMaker>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<workSkill>Crafting</workSkill>
		<effectWorking>Tailor</effectWorking>
		<soundWorking>Recipe_Tailor</soundWorking>
		<!--<displayPriority>800</displayPriority>-->
		<recipeUsers>
			<li>CraftingSpot</li>
			<li>HandTailoringBench</li>
			<li>ElectricTailoringBench</li>
		</recipeUsers>
		<unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
		<defaultIngredientFilter>
			<categories>
				<li>Root</li>
			</categories>
			<disallowedThingDefs>
				<li>Gold</li>
				<li>Silver</li>
				<li>Plasteel</li>
				<li>Jade</li>
				<li>Uranium</li>
			</disallowedThingDefs>
		</defaultIngredientFilter>
	</recipeMaker>
</ThingDef>

<!-- 粗制遮羞布 -->
<ThingDef ParentName="Kiiro_SimpleBase">
	<defName>Kiiro_SimpleUnderwear</defName>
	<label>kiiro simple underwear</label>
	<description>A few strips of cloth and pieces of fabric, barely covering the private areas.</description>
	<graphicData>
		<texPath>Kiiro/Apparel/Simplewear/SimpleUnderwear</texPath>
	</graphicData>
	<costStuffCount>20</costStuffCount>
	<apparel>
	    <layers>
			<li>Kiiro_Underwear</li>
		</layers>
		<bodyPartGroups>
			<li>Torso</li>
			<li>Legs</li>
		</bodyPartGroups>
		<wornGraphicPath>Kiiro/Apparel/Simplewear/SimpleUnderwear</wornGraphicPath>
	</apparel>
	<thingCategories>
		<li>Kiiro_Apparel_Underwear</li>
	</thingCategories>
</ThingDef>

<!-- 粗制外套 -->
<ThingDef ParentName="Kiiro_SimpleBase">
	<defName>Kiiro_SimpleCoat</defName>
	<label>kiiro simple coat</label>
	<description>A tattered and worn rough cloak that barely provides warmth; essentially a larger piece of fabric with various mismatched patches stitched onto it.</description>
	<graphicData>
		<texPath>Kiiro/Apparel/Simplewear/SimpleCoat</texPath>
	</graphicData>
	<costStuffCount>60</costStuffCount>
	<apparel>
	    <layers>
			<!-- <li>Kiiro_Shell</li> -->
			<li>Shell</li>
			<li>Kiiro_Pants</li>
			<li>Middle</li>
			<li>OnSkin</li>
		</layers>
		<drawData>
			<dataNorth><layer>40</layer></dataNorth>
		</drawData>
		<useWornGraphicMask>false</useWornGraphicMask>
		<bodyPartGroups>
			<li>Torso</li>
			<li>Legs</li>
		</bodyPartGroups>
		<wornGraphicPath>Kiiro/Apparel/Simplewear/SimpleCoat</wornGraphicPath>
	</apparel>
	<statBases>
		<Mass>2.2</Mass>
		<EquipDelay>1.6</EquipDelay>
		<MaxHitPoints>150</MaxHitPoints>
		<WorkToMake>4200</WorkToMake>
		<StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
		<Insulation_Cold>16</Insulation_Cold>
        <Insulation_Heat>16</Insulation_Heat>
		<StuffEffectMultiplierInsulation_Cold>0.20</StuffEffectMultiplierInsulation_Cold>
		<StuffEffectMultiplierInsulation_Heat>0.20</StuffEffectMultiplierInsulation_Heat>
	</statBases>
	<thingCategories>
		<li>Kiiro_Apparel_Shell</li>
	</thingCategories>
</ThingDef>

</Defs>