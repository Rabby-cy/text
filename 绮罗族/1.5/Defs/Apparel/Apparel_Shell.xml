<!-- 绮罗魅影斗篷 -->
<ThingDef ParentName="Kiiro_ShellBaseIV">
	<defName>Kiiro_PhantomCloak</defName>
	<label>kiiro phantom cloak</label>
	<description>A black cloak, made of sturdy fabric, with a specially crafted outer layer that is fire-resistant.</description>
	<costList>
		<DevilstrandCloth>60</DevilstrandCloth>
	</costList>
	<costStuffCount>150</costStuffCount>
	<stuffCategories>
	    <li>Fabric</li>
		<li>Leathery</li>
	</stuffCategories>
	<graphicData>
		<texPath>Kiiro/Apparel/Shell/Cloak/Cloak</texPath>
	</graphicData>
	<statBases>
		<MaxHitPoints>280</MaxHitPoints>
		<WorkToMake>52800</WorkToMake>
		<ArmorRating_Sharp>0.1</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
        <ArmorRating_Heat>0.4</ArmorRating_Heat>
		<StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
		<Insulation_Cold>20</Insulation_Cold>
        <Insulation_Heat>10</Insulation_Heat>
		<StuffEffectMultiplierInsulation_Cold>0.8</StuffEffectMultiplierInsulation_Cold>
		<StuffEffectMultiplierInsulation_Heat>0.2</StuffEffectMultiplierInsulation_Heat>
	</statBases>
	<apparel>
		<useWornGraphicMask>true</useWornGraphicMask>
		<bodyPartGroups>
          <li>Torso</li>
          <li>Legs</li>
          <li>Arms</li>
          <li>Neck</li>
          <li>Shoulders</li>
          <li>Feet</li>
          <li>Hands</li>
        </bodyPartGroups>
		<wornGraphicPath>Kiiro/Apparel/Shell/Cloak/Cloak</wornGraphicPath>
		<tags>
			<li>Kiiro_PhantomCloak</li>
			<!-- <li>Kiiro_HideTail</li> -->
		</tags>
	</apparel>
	<equippedStatOffsets>
		<MentalBreakThreshold>-0.05</MentalBreakThreshold>
	</equippedStatOffsets>
	<comps>
	  <li Class="CompProperties_CauseHediff_Apparel">
		<hediff>KiiroCoveredByCloak</hediff>
		<part>Torso</part>
	  </li>
	</comps>
</ThingDef>
  <HediffDef>
    <defName>KiiroCoveredByCloak</defName>
	<label>covered in cloak</label>
    <description>Covered in a fire-retardant cloak.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <stages>
      <li>
        <statFactors>
          <Flammability>0</Flammability>
        </statFactors>
      </li>
    </stages>
    <comps>
	  <li Class="HediffCompProperties_RemoveIfApparelDropped"/>
	</comps>
	<isBad>false</isBad>
  </HediffDef>


</Defs>