<!-- 绮罗简易披肩 -->
<ThingDef ParentName="Kiiro_ShellBaseI">
	<defName>Kiiro_SimpleCape</defName>
	<label>kiiro simple shawl</label>
	<description>A small shawl.</description>
	<costStuffCount>65</costStuffCount>
	<stuffCategories>
	    <li>Fabric</li>
		<li>Leathery</li>
	</stuffCategories>
	<graphicData>
		<texPath>Kiiro/Apparel/Shell/SimpleCape/SimpleCape</texPath>
	</graphicData>
	<statBases>
		<MaxHitPoints>100</MaxHitPoints>
		<WorkToMake>5400</WorkToMake>
		<StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
		<Insulation_Cold>5</Insulation_Cold>
        <Insulation_Heat>3</Insulation_Heat>
		<StuffEffectMultiplierInsulation_Cold>0.2</StuffEffectMultiplierInsulation_Cold>
		<StuffEffectMultiplierInsulation_Heat>0.2</StuffEffectMultiplierInsulation_Heat>
	</statBases>
	<apparel>
		<useWornGraphicMask>false</useWornGraphicMask>
		<developmentalStageFilter>Child, Adult</developmentalStageFilter>
		<bodyPartGroups>
          <li>Torso</li>
          <li>Shoulders</li>
        </bodyPartGroups>
		<wornGraphicPath>Kiiro/Apparel/Shell/SimpleCape/SimpleCape</wornGraphicPath>
		<tags>
			<li>Kiiro_DailyCoat</li>
		</tags>
	</apparel>
	<equippedStatOffsets>
		<MentalBreakThreshold>-0.05</MentalBreakThreshold>
	</equippedStatOffsets>
</ThingDef>

