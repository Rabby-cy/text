<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <InteractionDef>
    <defName>Kiiro_PresentPaperFolding</defName>
    <label>present paperfolding</label>
    <workerClass>Kiiro.InteractionWorker_PresentPaperFolding</workerClass>
    <symbol>Kiiro/Mote/SpeechSymbols/PaperFoldingPresent</symbol>
	<initiatorThought>Kiiro_PaperFoldingPresent</initiatorThought>
	<recipientThought>Kiiro_PaperFoldingReceived</recipientThought>
	<initiatorXpGainSkill>Artistic</initiatorXpGainSkill>
    <initiatorXpGainAmount>240</initiatorXpGainAmount>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] gave [RECIPIENT_nameDef] a little folding paper thing.</li>
        <li>r_logentry->[INITIATOR_nameDef] made a paperfolding gift for [RECIPIENT_nameDef].</li>
		<li>r_logentry->[INITIATOR_nameDef] gave [RECIPIENT_nameDef] a paper boat to honor their friendship.</li>
		<li>r_logentry->[INITIATOR_nameDef] gave a paperfolding to[RECIPIENT_nameDef].</li>
      </rulesStrings>
    </logRulesInitiator>
  </InteractionDef>

  <InteractionDef>
    <defName>Kiiro_SingARhymeToKid</defName>
    <label>sing rhyme to kid</label>
    <workerClass>Kiiro.InteractionWorker_KiiroRhymeToKid</workerClass>
    <symbol>Kiiro/Mote/SpeechSymbols/SingARhyme</symbol>
	<recipientThought>Kiiro_HearingARhyme</recipientThought>
	<initiatorXpGainSkill>Artistic</initiatorXpGainSkill>
    <initiatorXpGainAmount>80</initiatorXpGainAmount>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef]gently croon nursery rhymes for[RECIPIENT_nameDef].</li>
        <li>r_logentry->[INITIATOR_nameDef]sing the songs of hometown for[RECIPIENT_nameDef].</li>
        <li>r_logentry->[INITIATOR_nameDef]sing kiiro lullaby gently, [RECIPIENT_nameDef]listen quietly.</li>
      </rulesStrings>
    </logRulesInitiator>
  </InteractionDef>


  <InteractionDef>
    <defName>Kiiro_KindWords</defName>
    <label>kind words</label>
    <workerClass>Kiiro.InteractionWorker_KiiroKindWords</workerClass>
    <symbol>Things/Mote/SpeechSymbols/KindWords</symbol>
    <recipientThought>KindWords</recipientThought>
	<initiatorXpGainSkill>Social</initiatorXpGainSkill>
    <initiatorXpGainAmount>120</initiatorXpGainAmount>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] [complimented] [RECIPIENT_nameDef]'s [PersonalCharacteristic].</li>
        
        <li>complimented(p=3)->complimented</li>
        <li>complimented->praised</li>
        <li>complimented->commended</li>
        <li>complimented->lauded</li>
        <li>complimented->applauded</li>
        <li>complimented->celebrated</li>
        <li>complimented->saluted</li>
        <li>complimented->spoke kindly of</li>
        <li>complimented->expressed good things about</li>
        <li>complimented->offered kinds words about</li>
        <li>complimented->verbally appreciated</li>
        <li>complimented->expressed appreciation for</li>
        <li>complimented->said good things about</li>
      </rulesStrings>
    </logRulesInitiator>
  </InteractionDef>


</Defs>