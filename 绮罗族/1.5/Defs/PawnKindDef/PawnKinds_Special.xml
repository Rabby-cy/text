<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--=勇者=-->
  <PawnKindDef ParentName="Kiiro_PawnBase">    <!--==-->
    <defName>Kiiro_Valor</defName>
    <label>kiiro valor</label>
    <combatPower>1000</combatPower>
    <maxPerGroup>1</maxPerGroup>
    <itemQuality>Masterwork</itemQuality>
    <isFighter>true</isFighter>
    <factionLeader>true</factionLeader>
    <maxGenerationAge>35</maxGenerationAge>
	  <minGenerationAge>24</minGenerationAge>
    <apparelMoney>
      <min>0</min>
      <max>0</max>
    </apparelMoney>
    <apparelTags>
    </apparelTags>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <requiredTag>Kiiro_Underwear</requiredTag>
      </li>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <requiredTag>Kiiro_ValorArmor</requiredTag>
      </li>
      <li>
        <bodyPartGroup>FullHead</bodyPartGroup>
        <requiredTag>Kiiro_ValorTiara</requiredTag>
      </li>
    </specificApparelRequirements>
    <apparelDisallowTags>
    </apparelDisallowTags>
    <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
    <weaponTags>
      <li>Kiiro_ValorSabre</li>
    </weaponTags>
    <weaponMoney>
      <min>5000</min>
      <max>15000</max>
    </weaponMoney>
    <backstoryFiltersOverride>
      <li>
        <categoriesChildhood>
          <li>Kiiro_General</li>
        </categoriesChildhood>
        <categoriesAdulthood>
          <li>Kiiro_SpecialValor</li>
        </categoriesAdulthood>
      </li>
    </backstoryFiltersOverride>
    <inventoryOptions>
      <skipChance>0.25</skipChance>
      <subOptionsChooseOne>
        <li>
          <choiceChance>100</choiceChance>
          <thingDef>Silver</thingDef>
          <countRange>
            <min>20</min>
            <max>75</max>
          </countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
  </PawnKindDef>
  
