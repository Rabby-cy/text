<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--=猫罐头=-->
  <RecipeDef ParentName="CookMealBase">
    <defName>Kiiro_CookCannedCatFood</defName>
    <label>cook canned cat food</label>
    <description>Make a well-balanced canned cat food.</description>
    <jobString>cook canned cat food.</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <customSummary>protein</customSummary>
          <categories>
            <li>MeatRaw</li>
            <li>AnimalProductRaw</li>
          </categories>
        </filter>
        <count>0.30</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>0.25</count>
      </li>
    </ingredients>
    <products>
      <Kiiro_CannedCatFood>1</Kiiro_CannedCatFood>
    </products>
    <skillRequirements>
      <Cooking>5</Cooking>
    </skillRequirements>
	<recipeUsers>
	  <li>FueledStove</li>
	  <li>ElectricStove</li>
	</recipeUsers>
    <researchPrerequisite>Kiiro_Food</researchPrerequisite>
    <displayPriority>1410</displayPriority>
  </RecipeDef>

  <RecipeDef ParentName="CookMealBase">
    <defName>Kiiro_CookCannedCatFoodBulk</defName>
    <label>cook 4x canned cat food</label>
    <description>Make four balanced portions of canned cat food, which can be made in large quantities all at once to reduce the amount of food wasted.</description>
    <jobString>cook 4x canned cat food.</jobString>
    <workAmount>1500</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <customSummary>protein</customSummary>
          <categories>
            <li>MeatRaw</li>
            <li>AnimalProductRaw</li>
          </categories>
        </filter>
        <count>1.1</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>0.9</count>
      </li>
    </ingredients>
    <products>
      <Kiiro_CannedCatFood>4</Kiiro_CannedCatFood>
    </products>
    <skillRequirements>
      <Cooking>6</Cooking>
    </skillRequirements>
	<recipeUsers>
	  <li>FueledStove</li>
	  <li>ElectricStove</li>
	</recipeUsers>
    <researchPrerequisite>Kiiro_Food</researchPrerequisite>
    <displayPriority>1411</displayPriority>
  </RecipeDef>

  
  <!--=薄荷猫罐头=-->
