<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThoughtDef>
    <defName>Kiiro_CatmintStimulate</defName>
    <workerClass>Kiiro.ThoughtWorker_CatmintCenser</workerClass>
    <!--<effectMultiplyingStat>Breathing</effectMultiplyingStat>-->
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>fragrance of catmint</label>
        <description>I can smell the lingering scent of catmint in the air.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Kiiro_CatmintFragrance</defName>
    <workerClass>Kiiro.ThoughtWorker_CatmintCenser</workerClass>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>fragrance of grass leaves</label>
        <description>The air is filled with a subtle and elusive fragrance of grass leaves... Well, not bad.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Kiiro_AteCatmintMeal</defName>
    <durationDays>0.5</durationDays>
    <stages>
      <li>
        <label>ate catmint meal</label>
        <description>The food is mixed with catmint.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  
  <ThoughtDef>
    <defName>Kiiro_AteCatmintPill</defName>
    <durationDays>0.5</durationDays>
    <stages>
      <li>
        <label>ate catmint pill</label>
        <description>I took a pill that is supposed to make me healthier... and it's catmint-flavored!</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Kiiro_AteBabyFood</defName>
    <durationDays>0.5</durationDays>
    <stages>
      <li>
        <label>ate baby cat treat</label>
        <description>I'm not a baby anymore...</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>