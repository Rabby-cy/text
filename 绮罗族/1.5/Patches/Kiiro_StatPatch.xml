<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/StatDef[defName="MeleeDodgeChance"]/postProcessStatFactors</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/StatDef[defName="MeleeDodgeChance"]</xpath>
			<value>
				<postProcessStatFactors>
				</postProcessStatFactors>
			</value>
		</nomatch>
	</Operation>
	
	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
			<li Class="PatchOperationAdd">
				<xpath>Defs/StatDef[defName="MeleeDodgeChance"]/postProcessStatFactors</xpath>
				<value>
					<li>Kiiro_DodgePostProcessFactor</li>
				</value>
			</li>
		</operations>
	</Operation>

	<!-- 打到al前置里的 -->
	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
			<li Class="PatchOperationAdd">
				<xpath>Defs/StatDef[defName="Ancot_RangeDodgeChance"]/parts</xpath>
				<value>
					<li Class="Kiiro.StatPart_KiiroRangeDodge"/>
				</value>
			</li>
		</operations>
	</Operation>
	
</Patch>