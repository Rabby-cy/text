  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>Kiiro_PackControl</defName>
    <label>kiiro control pack</label>
    <description>Equipped with a small and lightweight machine control auxiliary computer, it provides a small amount of bandwidth while allowing the mechanic to have an additional control group.</description>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
	  <researchPrerequisites>
        <li>BasicMechtech</li>
        <li>Kiiro_Machining</li>
      </researchPrerequisites>
      <recipeUsers>
        <li>Kiiro_MachiningBench</li>
      </recipeUsers>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
    <costList>
      <Steel>85</Steel>
      <ComponentIndustrial>9</ComponentIndustrial>
    </costList>
    <graphicData>
      <texPath>Kiiro/Apparel/VanillaRe/PackControl/PackControl</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>2</drawSize>
	  <drawOffset>(0,0,0.2)</drawOffset>
    </graphicData>
    <tickerType>Normal</tickerType>
    <statBases>
      <WorkToMake>3800</WorkToMake>
      <Mass>2.1</Mass>
      <Flammability>0.4</Flammability>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <equippedStatOffsets>
      <MechControlGroups>1</MechControlGroups>
	  <MechBandwidth>4</MechBandwidth>
	  <WorkSpeedGlobal>-0.09</WorkSpeedGlobal>
	  <MoveSpeed>-0.1</MoveSpeed>
    </equippedStatOffsets>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <scoreOffset>4</scoreOffset>
      <mechanitorApparel>true</mechanitorApparel>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <wornGraphicPath>Kiiro/Apparel/VanillaRe/PackControl/PackControl</wornGraphicPath>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
      </wornGraphicData>
    </apparel>
    <tradeability>Sellable</tradeability>
    <tradeTags>
    </tradeTags>
  </ThingDef>

