<Defs>
 <ThingDef ParentName="BuildingBase">
    <defName>OA_RK_Turret_A</defName>
    <label>Oberonia Aurea Rocket Array</label>
    <description>The rocket array developed by the Oberonia Aurea Empire for colonial defense. Although its range cannot be compared to military weapons, its rocket grenades can easily cause devastating damage to light armored units in a large area.</description>
    <thingClass>Building_TurretRocket</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Building/OA_RK_Turret_A</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3, 2)</drawSize>
      <drawOffset>(0,0,-0.1)</drawOffset>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(1.5,0.35,1.4)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <uiIconPath>Building/OA_RK_TurretGun_AA</uiIconPath>
	<uiIconScale>1.3</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
	<rotatable>false</rotatable>
    <size>(3,2)</size>
    <statBases>
      <MaxHitPoints>460</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <WorkToBuild>22000</WorkToBuild>
      <Mass>18</Mass>
      <Beauty>-4</Beauty>
      <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
    </statBases>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>火箭榴弹</fuelLabel>
        <fuelGizmoLabel>火箭榴弹</fuelGizmoLabel>
        <outOfFuelMessage>缺少火箭榴弹</outOfFuelMessage>
        <fuelFilter><thingDefs><li>OA_RK_TurretGun_Bullet</li></thingDefs></fuelFilter>
        <fuelCapacity>35</fuelCapacity>
        <fuelMultiplier>1</fuelMultiplier>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>24</minimumFueledThreshold>
        <factorByDifficulty>false</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>Things/Item/Resource/Chemfuel</fuelIconPath>
      </li>
      <li Class="CompProperties_Interactable">
        <compClass>CompInteractableRocketswarmLauncher</compClass>
        <activeTicks>1</activeTicks>
        <cooldownTicks>4800</cooldownTicks>
        <ticksToActivate>135</ticksToActivate>
        <jobString>激活</jobString>
        <onCooldownString>冷却中</onCooldownString>
        <cooldownFleck>FlashRed</cooldownFleck>
        <cooldownFleckSpawnIntervalTicks>135</cooldownFleckSpawnIntervalTicks>
        <cooldownFleckScale>0.7</cooldownFleckScale>
        <cooldownPreventsRefuel>true</cooldownPreventsRefuel>
        <activateTexPath>UI/Commands/ActivateTurret</activateTexPath>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
    </comps>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <Plasteel>50</Plasteel>
	  <Uranium>150</Uranium>
      <Steel>100</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <Chemfuel>100</Chemfuel>
	  <OA_RK_TurretGun_Bullet>35</OA_RK_TurretGun_Bullet>
    </costList>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Security</designationCategory>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <building>
      <combatPower>5</combatPower>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>OA_RK_TurretGun_A</turretGunDef>
      <turretTopDrawSize>2.2</turretTopDrawSize>
      <turretBurstCooldownTime>0.1</turretBurstCooldownTime>
      <playTargetAcquiredSound>false</playTargetAcquiredSound>
      <turretBurstWarmupTime>0</turretBurstWarmupTime>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <designationHotKey>Misc2</designationHotKey>
    <researchPrerequisites>
      <li>OA_RK_GunTurrets</li>
    </researchPrerequisites>
  </ThingDef>
  
