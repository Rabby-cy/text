<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>OA_RK_hediff_SkyWarmth</defName>
        <label>Warm glow</label>
        <description>The coagulation factor continuously regulates hormones and heals cells in the body, producing a warm and comfortable feeling.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <maxSeverity>2</maxSeverity>
        <defaultLabelColor>(1, 1, 0.5)</defaultLabelColor>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <stages>
            <li>
                <label></label>
                <hungerRateFactor>0.85</hungerRateFactor>
                <statFactors>
                    <InjuryHealingFactor>1.25</InjuryHealingFactor>
                    <ImmunityGainSpeed>1.1</ImmunityGainSpeed>
                    <MoveSpeed>0.95</MoveSpeed>
                </statFactors>
                <statOffsets>
                    <ComfyTemperatureMin>-5</ComfyTemperatureMin>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.1</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <label>共鸣（金鸢尾兰花茶）</label>
                <minSeverity>1.1</minSeverity>
                <hungerRateFactor>0.85</hungerRateFactor>
                <statFactors>
                    <InjuryHealingFactor>1.66</InjuryHealingFactor>
                    <ImmunityGainSpeed>1.25</ImmunityGainSpeed>
                    <MoveSpeed>0.95</MoveSpeed>
                </statFactors>
                <statOffsets>
                    <ComfyTemperatureMin>-18</ComfyTemperatureMin>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.1</offset>
                    </li>
                </capMods>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>250</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
            <li Class="HediffCompProperties_DisappearsOnDeath"/>
            <li Class="HediffCompProperties_Link">
                <requireLinkOnOtherPawn>false</requireLinkOnOtherPawn>
            </li>
        </comps>
        <isBad>false</isBad>
    </HediffDef>

</Defs>