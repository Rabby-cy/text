<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef Name="OA_RK_HediffBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <alwaysAllowMothball>True</alwaysAllowMothball>
    <alwaysAllowMothballCached>True</alwaysAllowMothballCached>
  </HediffDef>

  <HediffDef ParentName="OA_RK_HediffBase">
    <defName>OA_RK_hediff_Detect</defName>
    <label>Searching</label>
    <description>desc</description>
    <alwaysAllowMothball>true</alwaysAllowMothball>
    <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
      <li MayRequire="Ludeon.RimWorld.Ideology" Class="HediffCompProperties_GiveHediffsInRange">
        <range>5.9</range>
        <hideMoteWhenNotDrafted>true</hideMoteWhenNotDrafted>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetColonists>true</onlyTargetColonists>
        </targetingParameters>
        <hediff>CombatCommandBuff</hediff>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="OA_RK_HediffBase">
    <defName>OA_RK_hediff_LifeStasis</defName>
    <label>Coagulation state</label>
    <description>A healthy deep coma-like state caused by coagulation factors, where the speed of biological function operation is significantly slowed down, but some beneficial tissues are stimulated and work efficiency is greatly improved.</description>
    <alwaysAllowMothball>true</alwaysAllowMothball>
    <alwaysAllowMothballCached>true</alwaysAllowMothballCached>

    <stages>
      <li>
        <painFactor>0.10</painFactor>
        <hungerRateFactor>0.25</hungerRateFactor>
        <totalBleedFactor>0.10</totalBleedFactor>
        <naturalHealingFactor>1.25</naturalHealingFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.05</setMax>
            <offset>0.10</offset>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>0.25</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>0.25</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>0.25</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>True</showRemainingTime>
        <disappearsAfterTicks>45000</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>OA_RK_SandWich</defName>
    <label>Shock alleviaton</label>
    <description>The impact force on the limbs and torso has been greatly alleviated.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <alwaysAllowMothball>true</alwaysAllowMothball>
    <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>0.80</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
    <isBad>false</isBad>
  </HediffDef>

  <HediffDef>
    <defName>OA_RK_SandWichB</defName>
    <label>Hemostatic fabric</label>
    <description>The fabric of the clothing equiped has a hemostatic function, and emergency treatment can be taken when bleeding occurs.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <alwaysAllowMothball>true</alwaysAllowMothball>
    <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
    <stages>
      <li>
        <totalBleedFactor>0.75</totalBleedFactor>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
    <isBad>false</isBad>
  </HediffDef>

  <HediffDef>
    <defName>OA_RK_SandWichC</defName>
    <label>Multi layer impact reducing structure</label>
    <description>The anti impact and pressure sharing structure inside the armor can greatly alleviate the impact force received.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <alwaysAllowMothball>true</alwaysAllowMothball>
    <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>0.75</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
    <isBad>false</isBad>
  </HediffDef>

  <HediffDef>
    <defName>OA_RK_SandWichD</defName>
    <label>Heavy armor structure</label>
    <description>The extremely heavy armor and pressure sharing structure can greatly alleviate the impact force received.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <alwaysAllowMothball>true</alwaysAllowMothball>
    <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>0.7</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
    <isBad>false</isBad>
  </HediffDef>

</Defs>