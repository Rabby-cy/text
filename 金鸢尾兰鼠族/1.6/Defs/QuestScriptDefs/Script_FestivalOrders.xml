<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <QuestScriptDef>
        <defName>OA_FestivalOrders</defName>
        <rootSelectionWeight>0.3</rootSelectionWeight>
        <defaultChallengeRating>1</defaultChallengeRating>
        <expireDaysRange>8~14</expireDaysRange>
        <minRefireDays>50</minRefireDays>
        <questNameRules>
            <rulesStrings>
                <li>questName->Golden Iris Festival Order</li>
                <li>questName->Urgent flower cake order</li>
                <li>questName->Festival Order</li>
                <li>questName->[OAFaction_leaderTitle] Flower cake order</li>
                <li>questName->Assistance request for [asker_nameFull]</li>
                <li>questName->Flower cake problem</li>
                <li>questName->Orders for festivals</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <li>questDescription->A traditional cultural festival of [OAFaction_name] is coming. On this day in previous years, the palace of [OAFaction_name] will distribute flower cakes to the citizens of the place to share the joy of the festival and enhance the festive atmosphere. However, this year's [OAFaction_name] encountered a problem.\nDue to [Reasonfortask], somewhere the golden iris court industry Department is currently facing a serious rat hand shortage, so that they can not even meet the holiday flower cake demand. Therefore, [OAFaction_leaderTitle], [asker_nameFull] of the Golden Iris hope that you can assist the local court to complete the flower cake needs of the festival, which will significantly improve the local court's perception of you. \n\n According to the local department as a whole, they are probably still have [requestedThingCount] a [requestedThing_label] the number of gap (total: [requestedThingMarketValue_money].) If we accept this request, [OAFaction_name] will provide the raw materials required for production and a flower cake processing machine, and a shuttle will arrive shortly to collect the flower cake. \n\nIf we complete the order, the willingness of [OAFaction_name] to assist us will increase. But if we fail to fulfill the order, [OAFaction_name] and the local Golden Iris citizens will be very disappointed in us.</li>
                <li>Reasonfortask->A series of construction projects are underway</li>
                <li>Reasonfortask->a series of production facilities are being manufactured</li>
                <li>Reasonfortask->Some staff were recruited from the newly established settlement</li>
                <li>Reasonfortask->A production workshop is being set up</li>
                <li>Reasonfortask->A large number of construction projects in the settlement site withdrew most of the personnel</li>
                <li>Reasonfortask->Extreme snowstorms cause the settlement to be urgently reinforced</li>
                <li>Reasonfortask->A large number of Ministry of Industry personnel were hospitalized with food poisoning</li>
                <li>Reasonfortask->A lot of new people are being trained</li>
            </rulesStrings>
        </questDescriptionRules>
        <root Class="QuestNode_Sequence">
            <nodes>
                <li Class="OberoniaAurea_Frame.QuestNode_EarliestDayPassed">
                    <earliestDayPassed>60</earliestDayPassed>
                </li>

                <li Class="QuestNode_GetMap" />

                <li Class="QuestNode_GetMapWealth">
                    <map>$map</map>
                    <storeAs>mapWealth</storeAs>
                </li>
                <li Class="QuestNode_GreaterOrFail">
                    <value1>$mapWealth</value1>
                    <value2>80000</value2>
                </li>

                <li Class="OberoniaAurea.QuestNode_GetOberoniaAureaFaction">                    <!-- 获取金鼠鼠派系 -->
                    <storeAs>OAFaction</storeAs>
                    <allowAlly>true</allowAlly>
                    <allowNeutral>true</allowNeutral>
                    <allowHostile>false</allowHostile>
                </li>
                <li Class="OberoniaAurea_Frame.QuestNode_GetFactionLeader">
                    <faction>$OAFaction</faction>
                    <storeAs>asker</storeAs>
                </li>

                <li Class="OberoniaAurea_Frame.QuestNode_RequestThingCount">
                    <storeAs>requestedThingCount</storeAs>
                    <baseRange>150</baseRange>
                    <preOffsetWealth>10000</preOffsetWealth>
                    <preOffsetCount>15</preOffsetCount>
                    <maxCountLimit>1350</maxCountLimit>
                </li>

                <li Class="OberoniaAurea_Frame.QueseNode_GetExpectedThingMarketValue">
                    <expectedThingDef>Oberonia_Aurea_Chanwu_AC</expectedThingDef>
                    <expectedThingCount>$requestedThingCount</expectedThingCount>
                    <storeThingDefAs>requestedThing</storeThingDefAs>
                    <storeMarketValueAs>requestedThingMarketValue</storeMarketValueAs>
                </li>

                <li Class="QuestNode_GenerateThing">
                    <def>Oberonia_Aurea</def>
                    <stackCount>$($requestedThingCount * 12)</stackCount>
                    <addToList>FoodIngredients</addToList>
                </li>
                <li Class="QuestNode_GenerateThing">
                    <def>RawRice</def>
                    <stackCount>$($requestedThingCount * 6)</stackCount>
                    <addToList>FoodIngredients</addToList>
                </li>
                <li Class="QuestNode_GenerateThing">
                    <def>Oberonia_Aurea_Chanwu_D</def>
                    <stackCount>$($requestedThingCount * 0.3)</stackCount>
                    <addToList>FoodIngredients</addToList>
                </li>
                <li Class="QuestNode_GenerateThing">
                    <def>OA_OberoniaCakeProducter</def>
                    <stackCount>1</stackCount>
                    <storeAs>CakeProducter</storeAs>
                </li>
                <li Class="QuestNode_MakeMinified">
                    <thing>$CakeProducter</thing>
                    <storeAs>CakeProducterMini</storeAs>
                </li>
                <li Class="QuestNode_AddToList">
                    <name>FoodIngredients</name>
                    <value>$CakeProducterMini</value>
                </li>

                <li Class="OberoniaAurea_Frame.QuestNode_GetDropSpot">
                    <storeAs>dropSpot</storeAs>
                    <useTradeSpot>true</useTradeSpot>
                    <preferCenterClose>true</preferCenterClose>
                    <preferCloseColony>true</preferCloseColony>
                    <minDistanceFromEdge>20</minDistanceFromEdge>
                </li>
                <li Class="QuestNode_DropPods">
                    <contents>$FoodIngredients</contents>
                    <dropSpot>$dropSpot</dropSpot>
                </li>

                <!-- Quest Delay -->
                <li Class="QuestNode_Set">
                    <name>questEndDelayTicks</name>
                    <value>$(roundToTicksRough(randFloat(22, 24)*60000))</value>
                </li>
                <li Class="QuestNode_Delay">
                    <delayTicks>$($questEndDelayTicks + 600)</delayTicks>
                    <outSignalComplete>questTimeout</outSignalComplete>
                    <isQuestTimeout>true</isQuestTimeout>
                </li>

                <!-- Shuttle -->
                <li Class="OberoniaAurea_Frame.QuestNode_GenerateThingDefCount">
                    <thingDef>$requestedThing</thingDef>
                    <count>$requestedThingCount</count>
                    <storeAs>requiredItems</storeAs>
                </li>
                <li Class="QuestNode_ShuttleDelay">
                    <delayTicks>$($questEndDelayTicks - 180000)</delayTicks>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_SubScript">
                                <def>Util_TransportShip_Pickup</def>
                                <parms>
                                    <leaveDelayTicks>180000</leaveDelayTicks>
                                    <requiredItems>$requiredItems</requiredItems>
                                    <leaveImmediatelyWhenSatisfied>true</leaveImmediatelyWhenSatisfied>
                                </parms>
                            </li>
                            <li Class="QuestNode_Letter">
                                <label TKey="LetterLabelShuttleArrived">穿梭机到达</label>
                                <text TKey="LetterTextShuttleArrived">穿梭机到达来收集 [requestedThing_label].</text>
                            </li>
                        </nodes>
                    </node>
                </li>

                <!-- Rewards -->

                <li Class="QuestNode_Signal">
                    <inSignal>pickupShipThing.SentSatisfied</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_Set">
                                <name>rewardValue</name>
                                <value>$($requestedThingMarketValue * randFloat(0.35, 0.45))</value>
                            </li>
                            <li Class="QuestNode_GiveRewards">
                                <parms>
                                    <rewardValue>$rewardValue</rewardValue>
                                    <thingRewardItemsOnly>true</thingRewardItemsOnly>
                                </parms>
                                <variants>3</variants>
                                <useDifficultyFactor>false</useDifficultyFactor>                                <!-- we only care about requested total market value -->
                            </li>
                            <li Class="OberoniaAurea.QuestNode_OaAssistPointsChange">
                                <change>20</change>
                                <isReward>true</isReward>
                            </li>
                            <li Class="QuestNode_End">
                                <outcome>Success</outcome>
                                <sendStandardLetter>true</sendStandardLetter>
                            </li>
                        </nodes>
                    </node>
                </li>

                <!-- End conditions -->
                <li Class="QuestNode_Letter">
                    <inSignal>OAFaction.BecameHostileToPlayer</inSignal>
                    <label TKey="LetterLabelQuestFailed">任务失败：[resolvedQuestName]</label>
                    <text TKey="LetterTextQuestFailed">[OAFaction_name]开始与你敌对了。</text>
                </li>
                <li Class="QuestNode_AnySignal">
                    <inSignals>
                        <li>OAFaction.BecameHostileToPlayer</li>
                        <li>pickupShipThing.SentUnsatisfied</li>
                        <li>pickupShipThing.Destroyed</li>
                        <li>pickupShipThing.LeftBehind</li>
                        <li>questTimeout</li>
                    </inSignals>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_ChangeFactionGoodwill">
                                <faction>$OAFaction</faction>
                                <change>-50</change>
                            </li>
                            <li Class="OberoniaAurea.QuestNode_OaAssistPointsChange">
                                <change>-20</change>
                            </li>
                            <li Class="QuestNode_Letter">
                                <letterDef>NegativeEvent</letterDef>
                                <label TKey="LetterLabelQuestFailed">支援点数减少：[resolvedQuestName]</label>
                                <text TKey="LetterTextQuestFailed">由于你没能完成你的承诺，[asker_nameFull]对你非常失望，[OAFaction_name]已扣除你20支援点数。</text>
                            </li>
                            <li Class="QuestNode_End">
                                <outcome>Fail</outcome>
                            </li>
                        </nodes>
                    </node>
                </li>
            </nodes>
        </root>
    </QuestScriptDef>

</Defs>