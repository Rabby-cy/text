<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <DamageDef>
        <defName>OA_RKDA_ChargeBullet</defName>
        <label>charge shot</label>
        <!-- 电荷弹 -->
        <deathMessage>{0} shot dead by charge shot.</deathMessage>
        <!-- 被电荷弹射死了。 -->
        <workerClass>DamageWorker_AddInjury</workerClass>
        <impactSoundType>OA_RKST_ChargeImpact</impactSoundType>
        <armorCategory>Sharp</armorCategory>
        <externalViolence>true</externalViolence>
        <hediff>Gunshot</hediff>
        <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
        <overkillPctToDestroyPart>0~0.7</overkillPctToDestroyPart>
        <isRanged>true</isRanged>
        <makesAnimalsFlee>true</makesAnimalsFlee>
    </DamageDef>

    <DamageDef>
        <defName>OA_RKDA_ChargeDriverExplosion</defName>
        <label>unstable charge cluster</label>
        <!-- 不稳定电荷团 -->
        <deathMessage>{0} killed in an unstable charge cluster blast.</deathMessage>
        <!-- 被不稳定电荷团的爆炸炸死了。 -->
        <workerClass>DamageWorker_AddInjury</workerClass>
        <impactSoundType>OA_RKST_ChargeImpact</impactSoundType>
        <soundExplosion>OA_RKSO_UnstableChargeDriverExplosion</soundExplosion>
        <armorCategory>Sharp</armorCategory>
        <externalViolence>true</externalViolence>
        <hasForcefulImpact>true</hasForcefulImpact>
        <hediff>Burn</hediff>
        <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
        <overkillPctToDestroyPart>0~0.7</overkillPctToDestroyPart>
        <isRanged>true</isRanged>
        <makesAnimalsFlee>true</makesAnimalsFlee>
        <defaultDamage>162</defaultDamage>
        <minDamageToFragment>15</minDamageToFragment>
        <buildingDamageFactorImpassable>2.5</buildingDamageFactorImpassable>
        <buildingDamageFactorPassable>1.5</buildingDamageFactorPassable>
        <plantDamageFactor>8</plantDamageFactor>
        <corpseDamageFactor>0.1</corpseDamageFactor>
        <defaultStoppingPower>5</defaultStoppingPower>
        <defaultArmorPenetration>1.62</defaultArmorPenetration>
        <explosionHeatEnergyPerCell>90</explosionHeatEnergyPerCell>
        <expolosionPropagationSpeed>1</expolosionPropagationSpeed>
    </DamageDef>

    <DamageDef>
        <defName>OA_RKDA_ChargeThrowerExplosion</defName>
        <label>unstable charge cluster</label>
        <!-- 不稳定电荷团 -->
        <deathMessage>{0} killed in an unstable charge cluster blast.。</deathMessage>
        <!-- 被不稳定电荷团的爆炸炸死了。 -->
        <workerClass>DamageWorker_AddInjury</workerClass>
        <impactSoundType>OA_RKST_ChargeImpact</impactSoundType>
        <soundExplosion>OA_RKSO_UnstableChargeThrowerExplosion</soundExplosion>
        <armorCategory>Sharp</armorCategory>
        <externalViolence>true</externalViolence>
        <hasForcefulImpact>true</hasForcefulImpact>
        <hediff>Burn</hediff>
        <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
        <overkillPctToDestroyPart>0~0.7</overkillPctToDestroyPart>
        <isRanged>true</isRanged>
        <makesAnimalsFlee>true</makesAnimalsFlee>
        <defaultDamage>43</defaultDamage>
        <minDamageToFragment>5</minDamageToFragment>
        <buildingDamageFactorImpassable>2.5</buildingDamageFactorImpassable>
        <buildingDamageFactorPassable>1.5</buildingDamageFactorPassable>
        <plantDamageFactor>8</plantDamageFactor>
        <corpseDamageFactor>0.1</corpseDamageFactor>
        <defaultStoppingPower>5</defaultStoppingPower>
        <defaultArmorPenetration>1.62</defaultArmorPenetration>
        <explosionHeatEnergyPerCell>90</explosionHeatEnergyPerCell>
        <expolosionPropagationSpeed>1</expolosionPropagationSpeed>
    </DamageDef>

    <DamageDef ParentName="Bomb">
        <defName>OA_RK_Bomb</defName>
        <buildingDamageFactorImpassable>1.5</buildingDamageFactorImpassable>
        <buildingDamageFactorPassable>0.75</buildingDamageFactorPassable>
    </DamageDef>

</Defs>