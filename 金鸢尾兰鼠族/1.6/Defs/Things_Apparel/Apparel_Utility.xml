        <defName>OA_RK_BlitzBelt</defName>
        <label>Blitz combat belt</label>
        <description>An ergonomically designed combat belt slightly increases protection and carrying capacity.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_BlitzBelt</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <tickerType>Normal</tickerType>
        <techLevel>Spacer</techLevel>
        <statBases>
            <Mass>0.10</Mass>
            <WorkToMake>15200</WorkToMake>
            <EquipDelay>1.25</EquipDelay>
            <MaxHitPoints>250</MaxHitPoints>
            <ArmorRating_Sharp>0.52</ArmorRating_Sharp>
        </statBases>
        <equippedStatOffsets>
            <MoveSpeed>0.15</MoveSpeed>
            <CarryingCapacity>8</CarryingCapacity>
        </equippedStatOffsets>
        <costList>
            <Synthread>10</Synthread>
            <ComponentIndustrial>1</ComponentIndustrial>
            <Uranium>40</Uranium>
        </costList>
        <apparel>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <wearPerDay>0.10</wearPerDay>
            <bodyPartGroups>
                <li>Torso</li>
            </bodyPartGroups>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <tags>
                <li>OARatkin_AssaulterArmor</li>
            </tags>
        </apparel>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
            <researchPrerequisite>OA_RK_Apparel_C</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <!-- 多功能工作腰带 -->
