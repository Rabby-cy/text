<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- 突袭作战防弹插板 -->
    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_UtilityMakeableBase">
        <defName>OA_RK_Middle</defName>
        <label>Blitz combat ballistic plate</label>
        <description>Specialized ballistic platesheet that are thin and lightweight but provide extra ballistic protection. Barely visable from outside, the thin plate is inserted inside the outer layer clothes when equiped.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_Middle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <costList>
            <Synthread>10</Synthread>
            <ComponentIndustrial>1</ComponentIndustrial>
            <Uranium>25</Uranium>
        </costList>
        <statBases>
            <MaxHitPoints>300</MaxHitPoints>
            <WorkToMake>11400</WorkToMake>
            <Mass>0.15</Mass>
            <EquipDelay>0.75</EquipDelay>
            <ArmorRating_Sharp>0.42</ArmorRating_Sharp>
        </statBases>
        <apparel>
            <bodyPartGroups Inherit="False">
                <li>Torso</li>
            </bodyPartGroups>
            <layers Inherit="False">
                <li>OARatkin_Middle_Layer</li>
            </layers>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <tags>
                <li>OARatkin_AssaulterArmor</li>
            </tags>
        </apparel>
        <recipeMaker>
            <useIngredientsForColor>false</useIngredientsForColor>
            <researchPrerequisite>OA_RK_Apparel_C</researchPrerequisite>
            <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
        </recipeMaker>
    </ThingDef>

    <!-- 突袭作战腰带 -->
