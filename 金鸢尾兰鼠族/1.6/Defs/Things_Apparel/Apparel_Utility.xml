        <graphicData>
            <texPath>Apparel/OA_RK_Belt</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <tickerType>Normal</tickerType>
        <techLevel>Spacer</techLevel>
        <statBases>
            <Mass>0.15</Mass>
            <WorkToMake>17000</WorkToMake>
            <EquipDelay>1.5</EquipDelay>
            <MaxHitPoints>250</MaxHitPoints>
            <ArmorRating_Sharp>0.24</ArmorRating_Sharp>
        </statBases>
        <equippedStatOffsets>
            <CarryingCapacity>16</CarryingCapacity>
            <GeneralLaborSpeed>0.10</GeneralLaborSpeed>
            <WorkSpeedGlobal>0.05</WorkSpeedGlobal>
        </equippedStatOffsets>
        <costList>
            <Synthread>10</Synthread>
            <ComponentIndustrial>6</ComponentIndustrial>
            <Uranium>20</Uranium>
        </costList>
        <apparel>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <wearPerDay>0.14</wearPerDay>
            <bodyPartGroups>
                <li>Torso</li>
            </bodyPartGroups>
            <tags>
                <li>OA_RK_Belt</li>
            </tags>
        </apparel>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
            <researchPrerequisite>OA_RK_Apparel_B</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <!-- 电子对抗设备 -->
    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_UtilityMakeableBase">
        <defName>OA_RK_Component_D</defName>
        <label>ECM device</label>
        <description>A jamming device capable of disrupting the operation of electronic items. Significantly reduces the accuracy of automatic defenses such as turrets.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_Component_D</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <MaxHitPoints>75</MaxHitPoints>
            <Mass>1.80</Mass>
            <WorkToMake>27000</WorkToMake>
            <EquipDelay>2</EquipDelay>
        </statBases>
        <costList>
            <Synthread>10</Synthread>
            <ComponentIndustrial>9</ComponentIndustrial>
            <Uranium>55</Uranium>
        </costList>
        <apparel>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <tags>
                <li>OARatkin_Belt</li>
            </tags>
            <wearPerDay>0</wearPerDay>
        </apparel>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
            <researchPrerequisite>OA_RK_Apparel_C</researchPrerequisite>
        </recipeMaker>
        <comps>
            <li Class="OberoniaAurea_Hyacinth.CompProperties_ApparelRangeEffect">
                <compClass>OberoniaAurea_Hyacinth.CompRatkinHarmTurret</compClass>
                <aiEffectiveUse>true</aiEffectiveUse>
                <radius>39.9</radius>
            </li>
        </comps>
    </ThingDef>

    <!-- 金鸢尾兰远行套装 -->
    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_UtilityMakeableBase">
        <defName>OA_RK_Component_F</defName>
        <label>Oberonia Aurea traveler's Kit</label>
        <description>Essential items for Oberonia Aurea travelers. Includes a signal beacon, a communication device, an electronic analyzer, an encyclopedia, and a range of other common survival equipment.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_Component_F</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <Mass>1.00</Mass>
            <WorkToMake>17000</WorkToMake>
            <EquipDelay>2</EquipDelay>
        </statBases>
        <costList>
            <Synthread>20</Synthread>
            <ComponentIndustrial>5</ComponentIndustrial>
            <Uranium>35</Uranium>
        </costList>
        <equippedStatOffsets>
            <FoodPoisonChance>-0.2</FoodPoisonChance>
            <CookSpeed>2.00</CookSpeed>
            <ButcheryFleshSpeed>0.15</ButcheryFleshSpeed>
            <AnimalGatherSpeed>0.15</AnimalGatherSpeed>
            <ConstructionSpeed>0.15</ConstructionSpeed>
            <HuntingStealth>0.75</HuntingStealth>
            <PlantHarvestYield>0.15</PlantHarvestYield>
            <CarryingCapacity>10</CarryingCapacity>
            <ForagedNutritionPerDay>0.75</ForagedNutritionPerDay>
        </equippedStatOffsets>
        <apparel>
            <tags>
                <li>OARatkin_Belt</li>
            </tags>
            <wearPerDay>0</wearPerDay>
        </apparel>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
            <researchPrerequisite>OA_RK_Apparel_D</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <!-- 突袭发烟器 -->
    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_UtilityMakeableBase">
        <defName>OA_RK_Component_E</defName>
        <label>Blitz combat smoke launcher</label>
        <description>A launcher capable of projecting smoke shells over long distances, often carried by Oberonia Aurea assualt squad during the assaults on plains terrains.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_Component_E</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <MaxHitPoints>75</MaxHitPoints>
            <Mass>2.00</Mass>
            <WorkToMake>22800</WorkToMake>
            <EquipDelay>2</EquipDelay>
        </statBases>
        <costList>
            <ComponentIndustrial>8</ComponentIndustrial>
            <Uranium>90</Uranium>
        </costList>
        <comps>
            <li Class="CompProperties_ApparelReloadable">
                <maxCharges>4</maxCharges>
                <ammoDef>Shell_Smoke</ammoDef>
                <ammoCountPerCharge>1</ammoCountPerCharge>
                <baseReloadTicks>90</baseReloadTicks>
                <soundReload>Standard_Reload</soundReload>
                <hotKey>Misc4</hotKey>
                <chargeNoun>烟雾弹</chargeNoun>
                <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
            </li>
        </comps>
        <verbs>
            <li>
                <label>发射烟雾弹</label>
                <verbClass>Verb_LaunchProjectileStatic</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <onlyManualCast>True</onlyManualCast>
                <range>27.9</range>
                <forcedMissRadius>2.9</forcedMissRadius>
                <warmupTime>0.6</warmupTime>
                <noiseRadius>4</noiseRadius>
                <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
                <soundCast>Shot_IncendiaryLauncher</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>6</muzzleFlashScale>
                <drawHighlightWithLineOfSight>true</drawHighlightWithLineOfSight>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
                <defaultProjectile>OA_RK_Smoke</defaultProjectile>
                <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
            </li>
        </verbs>
        <apparel>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <tags>
                <li>OARatkin_Belt</li>
            </tags>
            <wearPerDay>0</wearPerDay>
        </apparel>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
            <researchPrerequisite>OA_RK_Apparel_C</researchPrerequisite>
        </recipeMaker>
    </ThingDef>
    <!-- 突袭烟雾弹 -->
    <ThingDef ParentName="BaseBullet">
        <defName>OA_RK_Smoke</defName>
        <label>突袭烟雾弹</label>
        <graphicData>
            <texPath>Things/Projectile/LauncherShot</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
            <color>(140,135,156)</color>
        </graphicData>
        <thingClass>Projectile_Explosive</thingClass>
        <projectile>
            <speed>110</speed>
            <damageDef>Smoke</damageDef>
            <explosionRadius>5.9</explosionRadius>
            <postExplosionGasType>BlindSmoke</postExplosionGasType>
            <ai_IsIncendiary>true</ai_IsIncendiary>
            <arcHeightFactor>0.2</arcHeightFactor>
            <shadowSize>0.6</shadowSize>
            <screenShakeFactor>0.5</screenShakeFactor>
        </projectile>
    </ThingDef>

    <!-- 金鸢尾兰矿物探测仪 -->
