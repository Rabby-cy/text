	<!-- 金鸢尾兰船员发饰 -->
	<ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_HatMakeableBase">
        <defName>OA_RK_New_Hat_E</defName>
        <label>Oberonia Aurea Crew Hair Accessory</label>
        <description>The standard crew hair accessory of the Oberonia Aurea Navigation Department can generate an extremely weak force field around the wearer in vacuum environments. While insufficient for independent space activity, it adequately compensates for minor sealing deficiencies in crew uniforms. Additionally, thanks to its precise construction and information detection capabilities, the hair accessory effectively assists crew members with routine technical operations.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Hat_E</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <techLevel>Spacer</techLevel>
        <costList>
			<Uranium>30</Uranium>
            <Steel>25</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <statBases>
            <MaxHitPoints>125</MaxHitPoints>
            <WorkToMake>22800</WorkToMake>
            <Mass>0.25</Mass>
            <EquipDelay>0.75</EquipDelay>
            <ArmorRating_Sharp>0.18</ArmorRating_Sharp>
            <ArmorRating_Heat>0.46</ArmorRating_Heat>
            <Insulation_Cold>5.0</Insulation_Cold>
            <Insulation_Heat>3.0</Insulation_Heat>
        </statBases>
        <equippedStatOffsets>
			<MechRepairSpeed MayRequire="Ludeon.RimWorld.Biotech">0.5</MechRepairSpeed>
			<MechFormingSpeed MayRequire="Ludeon.RimWorld.Biotech">0.1</MechFormingSpeed>
			<FixBrokenDownBuildingSuccessChance>0.25</FixBrokenDownBuildingSuccessChance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.16</VacuumResistance>
        </equippedStatOffsets>
        <apparel>
            <wornGraphicPath>Apparel/OA_RK_New_Hat_E</wornGraphicPath>
