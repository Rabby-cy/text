    <!-- 金鸢尾兰技术官制服 -->
    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_CourtApparelMakeableBase">
        <defName>OA_RK_New_Professional_Uniforms_C</defName>
        <label>Oberonia Aurea Technical Officer Uniform</label>
        <description>The uniform customized by the Jin Yuan Lan Palace for technical officials has a more complex production process compared to the normal technical department uniform. In addition, in order to facilitate the management of personnel by technical officers, this uniform focuses on strengthening communication and management capabilities. \n\nUnits within 15 squares of the wearer will receive an increase in work speed.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Professional_Uniforms_C</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>33000</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>1.5</Mass>
            <ArmorRating_Heat>0.60</ArmorRating_Heat>
            <ArmorRating_Blunt>0.46</ArmorRating_Blunt>
            <StuffEffectMultiplierArmor>0.39</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.70</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.55</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3.0</EquipDelay>
        </statBases>
        <tickerType>Normal</tickerType>
        <costList>
            <Synthread>80</Synthread>
            <ComponentIndustrial>5</ComponentIndustrial>
        </costList>
        <costStuffCount>70</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <equippedStatOffsets>
            <ResearchSpeed>0.25</ResearchSpeed>
        </equippedStatOffsets>
        <comps>
            <li MayRequire="Ludeon.RimWorld.Ideology" Class="OberoniaAurea.CompProperties_GiveHediffsInRange">
                <range>19.9</range>
                <checkInterval>250</checkInterval>
                <hediffDisappearTick>300</hediffDisappearTick>
                <mote>Mote_CombatCommand</mote>
                <hideMoteWhenNotDrafted>true</hideMoteWhenNotDrafted>
                <targetingParameters>
                    <canTargetBuildings>false</canTargetBuildings>
                    <canTargetAnimals>false</canTargetAnimals>
                    <canTargetMechs>false</canTargetMechs>
                    <onlyTargetColonists>true</onlyTargetColonists>
                </targetingParameters>
                <hediff>OA_RK_Jishu_Hediff</hediff>
            </li>
        </comps>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
                <li>Neck</li>
                <li>Arms</li>
                <li>Legs</li>
                <li>Feet</li>
            </bodyPartGroups>
            <wornGraphicPath>Apparel/OA_RK_New_Professional_Uniforms_C</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>OARatkin_TechnicalApparel_Officer</li>
            </tags>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>OA_RK_Apparel_E</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <!-- 金鸢尾兰勤务船员制服 -->
	<ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_CourtApparelMakeableBase">
        <defName>OA_RK_New_Professional_Uniforms_D</defName>
        <label>Oberonia Aurea Service Crew Uniform</label>
        <description>One of the standard uniforms of the Oberonia Aurea Court's Navigation Department, typically issued to basic crew members responsible for piloting or daily service work. The striking white uniform bears the Navigation Department's eight-pointed star emblem, while the gray lining beneath the pristine white exterior is a vacuum-sealed spacesuit capable of withstanding space environments.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Professional_Uniforms_D</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>34400</WorkToMake>
            <MaxHitPoints>220</MaxHitPoints>
            <Mass>2.8</Mass>
			<ArmorRating_Sharp>0.36</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.22</ArmorRating_Blunt>
			<ArmorRating_Heat>1.20</ArmorRating_Heat>
			<Insulation_Cold>58</Insulation_Cold>
			<Insulation_Heat>40</Insulation_Heat>
			<EquipDelay>7.0</EquipDelay>
        </statBases>
        <costList>
			<Synthread>125</Synthread>
			<Uranium>10</Uranium>
			<ComponentIndustrial>4</ComponentIndustrial>
        </costList>
        <equippedStatOffsets>
            <PilotingAbility MayRequire="Ludeon.RimWorld.Odyssey">0.15</PilotingAbility>
            <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.78</VacuumResistance>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
                <li>Neck</li>
                <li>Arms</li>
                <li>Legs</li>
                <li>Hands</li>
                <li>Feet</li>
            </bodyPartGroups>
            <wornGraphicPath>Apparel/OA_RK_New_Professional_Uniforms_D</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>OARatkin_NavigateApparel</li>
            </tags>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>OA_RK_Apparel_E</researchPrerequisite>
        </recipeMaker>
    </ThingDef>
	
