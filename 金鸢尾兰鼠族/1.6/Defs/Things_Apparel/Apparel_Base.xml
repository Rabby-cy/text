<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- 金鸢尾兰衣物基类 -->
	<ThingDef Class="NewRatkin.CustomThingDef" Name="OARatkin_ApparelBase" Abstract="True">
		<thingClass>Apparel</thingClass>
		<graphicData>
			<onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
		</graphicData>
		<uiIconScale>1.4</uiIconScale>
		<drawGUIOverlay>true</drawGUIOverlay>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<DeteriorationRate>1.5</DeteriorationRate>
			<Beauty>6</Beauty>
		</statBases>
		<pathCost>11</pathCost>
		<selectable>True</selectable>
		<useHitPoints>True</useHitPoints>
		<alwaysHaulable>True</alwaysHaulable>
		<followStuffColor>false</followStuffColor>
		<category>Item</category>
		<techLevel>Industrial</techLevel>
		<tickerType>Never</tickerType>
		<altitudeLayer>Item</altitudeLayer>
		<tradeTags>
			<li>OARatkin_Apparel</li>
		</tradeTags>
		<thingCategories Inherit="false">
			<li>OARatkin_Apparel</li>
		</thingCategories>
		<comps>
			<li Class="CompProperties_Forbiddable" />
			<li>
				<compClass>CompColorable</compClass>
			</li>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
		<apparel>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
			<tags>
				<li>Royal</li>
				<li>RoyalTier2</li>
				<li>RoyalTier5</li>
			</tags>
		</apparel>
	</ThingDef>

	<!-- 可制作衣物基类 -->
	<ThingDef Class="NewRatkin.CustomThingDef" Name="OARatkin_ApparelMakeableBase" ParentName="OARatkin_ApparelBase" Abstract="True">
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Tailor</effectWorking>
			<soundWorking>Recipe_Tailor</soundWorking>
			<recipeUsers Inherit="false">
				<li>RK_ElectricTailoringBench</li>
				<li>RK_HandTailoringBench</li>
				<li>OA_RK_Tailor</li>
			</recipeUsers>
			<unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
			<skillRequirements>
				<Crafting>10</Crafting>
			</skillRequirements>
		</recipeMaker>
	</ThingDef>

	<!-- 一般衣物基类-->
	<ThingDef Class="NewRatkin.CustomThingDef" Name="OARatkin_CommonApparelMakeableBase" ParentName="OARatkin_ApparelMakeableBase" Abstract="True">
		<apparel>
			<tags>
				<li>OARatkin_Apparel</li>
			</tags>
		</apparel>
	</ThingDef>

	<!-- 宫廷衣物基类-->
	<ThingDef Class="NewRatkin.CustomThingDef" Name="OARatkin_CourtApparelMakeableBase" ParentName="OARatkin_ApparelMakeableBase" Abstract="True">
		<apparel>
			<tags>
				<li>OARatkin_CourtApparel</li>
			</tags>
		</apparel>
	</ThingDef>

	<!-- 军事衣物基类-->
	<ThingDef Class="NewRatkin.CustomThingDef" Name="OARatkin_ArmorMakeableBase" ParentName="OARatkin_ApparelMakeableBase" Abstract="True">
		<thingCategories Inherit="false">
			<li>OARatkin_Armor</li>
		</thingCategories>
		<apparel>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
	</ThingDef>

	<!-- 头部装备基类-->
	<ThingDef Class="NewRatkin.CustomThingDef" Name="OARatkin_HatMakeableBase" ParentName="OARatkin_ApparelMakeableBase" Abstract="True">
		<thingCategories Inherit="False">
			<li>OARatkin_Headgear</li>
		</thingCategories>
		<apparel>
			<renderSkipFlags>
				<li>None</li>
			</renderSkipFlags>
			<bodyPartGroups>
				<li>UpperHead</li>
			</bodyPartGroups>
			<layers>
				<li>Overhead</li>
			</layers>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
		</apparel>
	</ThingDef>

	<!-- 一般头部装备基类 -->
	<ThingDef Class="NewRatkin.CustomThingDef" Name="OARatkin_CommonHatMakeableBase" ParentName="OARatkin_HatMakeableBase" Abstract="True">
		<apparel>
			<tags>
				<li>OARatkin_Apparel</li>
			</tags>
		</apparel>
	</ThingDef>

	<!-- 宫廷头部装备基类 -->
	<ThingDef Class="NewRatkin.CustomThingDef" Name="OARatkin_CourtHatMakeableBase" ParentName="OARatkin_HatMakeableBase" Abstract="True">
		<apparel>
			<tags>
				<li>OARatkin_CourtApparel</li>
			</tags>
		</apparel>
	</ThingDef>

	<!-- 军事头部装备基类-->
	<ThingDef Class="NewRatkin.CustomThingDef" Name="OARatkin_ArmorHatMakeableBase" ParentName="OARatkin_HatMakeableBase" Abstract="True">
		<thingCategories Inherit="False">
			<li>OARatkin_ArmorHeadgear</li>
		</thingCategories>
		<apparel>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
	</ThingDef>

	<!-- 配件基类（默认腰部）-->
	<ThingDef Class="NewRatkin.CustomThingDef" Name="OARatkin_UtilityMakeableBase" ParentName="OARatkin_CommonApparelMakeableBase" Abstract="True">
		<thingCategories Inherit="False">
			<li>OARatkin_Utility</li>
		</thingCategories>
		<uiIconScale>1.6</uiIconScale>
		<apparel>
			<tags Inherit="false">
			</tags>
			<bodyPartGroups>
				<li>Waist</li>
			</bodyPartGroups>
			<layers>
				<li>Belt</li>
			</layers>
		</apparel>
		<recipeMaker>
			<recipeUsers Inherit="false">
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
		<comps Inherit="false">
			<li Class="CompProperties_Forbiddable" />
			<li>
				<compClass>CompColorable</compClass>
			</li>
		</comps>
	</ThingDef>

	<ApparelLayerDef>
		<defName>OARatkin_Middle_Layer</defName>
		<label>plugboard</label>
		<drawOrder>250</drawOrder>
	</ApparelLayerDef>

</Defs>