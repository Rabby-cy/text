        <defName>OA_RK_Hat_D</defName>
        <label>Oberonia Aurea scouter</label>
        <description>A compact monocle with analytical capability. It can analyze the compositions of objects, or provide varies of assistance in reasearches. \n\n"You have a power level of only five. Huh, pitiful."</description>
        <graphicData>
            <texPath>Apparel/OA_RK_Hat_D</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <costList>
            <Steel>40</Steel>
            <ComponentIndustrial>6</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToMake>19200</WorkToMake>
            <Mass>0.05</Mass>
            <EquipDelay>0.75</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <ResearchSpeed>0.50</ResearchSpeed>
        </equippedStatOffsets>
        <apparel>
            <wornGraphicPath>Apparel/OA_RK_Hat_D</wornGraphicPath>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>OA_RK_Apparel_B</researchPrerequisite>
            <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
        </recipeMaker>
    </ThingDef>

