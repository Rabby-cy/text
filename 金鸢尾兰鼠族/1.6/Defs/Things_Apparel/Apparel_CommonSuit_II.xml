<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- 金鸢尾兰长摆风衣 -->
    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_CommonApparelMakeableBase">
        <defName>OA_RK_Windbreaker_A</defName>
        <label>Oberonia Aurea long trench coat</label>
        <description>A common type of coat found in Oberonia Aurea Empire. The long tail is designed to keep out of the wind and insulate.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_Windbreaker_A</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <costList>
            <Synthread>60</Synthread>
        </costList>
        <costStuffCount>50</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <statBases>
            <MaxHitPoints>200</MaxHitPoints>
            <WorkToMake>19000</WorkToMake>
            <Mass>3.5</Mass>
            <StuffEffectMultiplierArmor>0.32</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.95</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
            <Insulation_Cold>4</Insulation_Cold>
            <EquipDelay>2.0</EquipDelay>
        </statBases>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Apparel/OA_RK_Windbreaker_A</wornGraphicPath>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <layers>
                <li>Shell</li>
            </layers>
            <drawData>
                <defaultData>
                    <layer>30</layer>
                </defaultData>
            </drawData>
            <tags>
                <li>OARatkin_TravellerApparel</li>
                <li>OARatkin_CourtApparel</li>
                <li>OARatkin_Noble_Tier1</li>
            </tags>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>OA_RK_Apparel_A</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

