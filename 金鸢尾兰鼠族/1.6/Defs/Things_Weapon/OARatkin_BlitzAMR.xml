    <graphicData>
        <texPath>Weapons/OA_BlitzAMR_B</texPath>
    </graphicData>
    <statBases>
        <WorkToMake>102000</WorkToMake>
        <Mass>11</Mass>
        <AccuracyTouch>0.80</AccuracyTouch>
        <AccuracyShort>0.92</AccuracyShort>
        <AccuracyMedium>0.90</AccuracyMedium>
        <AccuracyLong>0.87</AccuracyLong>
        <RangedWeapon_Cooldown>4.50</RangedWeapon_Cooldown>
