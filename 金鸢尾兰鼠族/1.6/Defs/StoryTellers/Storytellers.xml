<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<StorytellerDef ParentName="BaseStoryteller">
		<defName>Begonia_Oberonia_Aurea</defName>
		<label>"Ruler" Begonia Oberonia Aurea</label>
		<description>If you want to wear the crown, you must bear its weight. \n As one of the Crown Princes of the Oberonia Aurea Empire, Begonia kept improving her studying on rule and management, which makes her tend to focus on the major events that are urgent most of the time, rather than procrastinating too much on the minor events. \n\nThe stories she recounts will often involve other factions, whether it be diplomacy or wars, which are things that need to paid attention to; while minor events have a relatively low probability of occurring. \n\nInteractions with other factions are routine here, and turmoil will occur from time to time, an experienced ruler will be a duck to water in such situations.</description>
		<portraitLarge>Storyteller/Begonia_Oberonia_Aurea</portraitLarge>
		<portraitTiny>Storyteller/Begonia_Oberonia_Aurea_TINY</portraitTiny>
		<listOrder>64</listOrder>
		<comps>
			<!-- Home all -->
			<li Class="StorytellerCompProperties_RandomMain">
				<allowedTargetTags>
					<li>Map_PlayerHome</li>
				</allowedTargetTags>
				<minDaysPassed>1</minDaysPassed>
				<mtbDays>1.10</mtbDays>
				<maxThreatBigIntervalDays>15</maxThreatBigIntervalDays>
				<minIncChancePopulationIntentFactor>0.2</minIncChancePopulationIntentFactor>
				<randomPointsFactorRange>1.2~2.6</randomPointsFactorRange>
				<skipThreatBigIfRaidBeacon>true</skipThreatBigIfRaidBeacon>
				<categoryWeights>
					<Misc>4.55</Misc>
					<ThreatBig>0.96</ThreatBig>
					<OrbitalVisitor>1.25</OrbitalVisitor>
					<FactionArrival>1.80</FactionArrival>
					<ThreatSmall>1.0</ThreatSmall>
					<ShipChunkDrop>0.28</ShipChunkDrop>
				</categoryWeights>
			</li>
			<li Class="StorytellerCompProperties_Disease">
				<category>DiseaseHuman</category>
				<minDaysPassed>4</minDaysPassed>
			</li>
			<li Class="StorytellerCompProperties_Disease">
				<category>DiseaseAnimal</category>
				<minDaysPassed>4</minDaysPassed>
			</li>
			<!-- Home special threats -->
			<li Class="StorytellerCompProperties_ThreatsGenerator">
