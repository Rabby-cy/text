<?xml version="1.0" encoding="UTF-8"?>
<Patch>

   <Operation Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName = "ElectricTailoringBench" or defName = "RK_ElectricTailoringBench" or defName = "RK_HandTailoringBench"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
      <value>
         <li>OA_RK_Cloth_Processing</li>
         <li>OA_RK_Cloth_Processing_B</li>
      </value>
   </Operation>

   <Operation Class="PatchOperationFindMod">
      <mods>
         <li>Vanilla Furniture Expanded - Production</li>
      </mods>
      <match Class="PatchOperationAdd">
         <xpath>/Defs/ThingDef[defName = "VFE_TableTailorLarge"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
         <value>
            <li>OA_RK_Cloth_Processing</li>
            <li>OA_RK_Cloth_Processing_B</li>
         </value>
      </match>
   </Operation>

   <Operation Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName = "HiTechResearchBench"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
      <value>
         <li>OA_RK_Rese_B</li>
         <li>OA_RK_Rese_A</li>
         <li>OA_RK_Rese_C</li>
      </value>
   </Operation>

</Patch>