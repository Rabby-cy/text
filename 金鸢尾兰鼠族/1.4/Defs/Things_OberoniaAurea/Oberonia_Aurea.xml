<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="PlantBase">
    <defName>Plant_Oberonia_Aurea</defName>
    <label>Oberonia Aurea (ornamental)</label>
    <description>A golden variant from the genus of flowering plants in the family Orchidaceae. Originated on the soils of the home planet of the Oberonia Aurea Ratkin, hardy and able to grow on poor soil, is the symbol and national flower of the Oberonia Aurea Empire. Its color is bright but not vulgar, and exudes a subtle fragrance. The Oberonia Aurea Ratkins often pick it to brew tea.\n\nThis type of Oberonia Aurea will be automatically harvested.</description>
     <statBases>
      <MaxHitPoints>70</MaxHitPoints>
      <Nutrition>0.05</Nutrition>
	  <Beauty>23</Beauty>
      <BeautyOutdoors>23</BeautyOutdoors>
    </statBases>
	<altitudeLayer>Building</altitudeLayer>
    <graphicData>
      <texPath>Plant/Oberonia_Aurea</texPath>
      <graphicClass>Graphic_Random</graphicClass>
	 <drawSize>(1.26,1.26)</drawSize>
    </graphicData>
    <selectable>true</selectable>
    <!--pathCost>16</pathCost-->
    <ingestible />
    <plant>
	  <fertilitySensitivity>0.6</fertilitySensitivity>
      <dieIfLeafless>false</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
	  <sowWork>920</sowWork>
      <harvestedThingDef>Oberonia_Aurea</harvestedThingDef>
      <harvestYield>5</harvestYield>
      <sowTags>
        <li>Ground</li>
		<li>Decorative</li>
      </sowTags>
	  <autoHarvestable>false</autoHarvestable>
      <topWindExposure>0.08</topWindExposure>
	  <growMinGlow>0.3</growMinGlow>
      <growDays>4.25</growDays>
      <lifespanDaysPerGrowDays>5</lifespanDaysPerGrowDays>
      <visualSizeRange>0.3~0.8</visualSizeRange>
      <wildOrder>1</wildOrder>
      <purpose>Beauty</purpose>
      <humanFoodPlant>true</humanFoodPlant>
	  <sowResearchPrerequisites>
        <li>OA_RK_Oberonia_Aurea_Research</li>
      </sowResearchPrerequisites>
    </plant>
  </ThingDef>
  
