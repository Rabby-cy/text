<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <QuestScriptDef>
        <defName>OA_OpportunitySite_PunishmentExecutor</defName>
        <rootSelectionWeight>1.0</rootSelectionWeight>
        <rootMinPoints>350</rootMinPoints>
        <canGiveRoyalFavor>true</canGiveRoyalFavor>
        <expireDaysRange>4~8</expireDaysRange>
        <successHistoryEvent MayRequire="Ludeon.RimWorld.Ideology">Raided_BanditCamp</successHistoryEvent>
        <questNameRules>
            <rulesStrings>
                <li>questName->惩戒的执行者</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <li>questDescription->[asker_faction_name]的[asker_faction_leaderTitle]，[asker_nameFull]向我们发来一条消息，她告诉我们有一伙来自[siteFaction_name]的[enemyFaction_pawnsPlural]近期多次劫掠路过的金鸢尾兰的远行者与公民，已经对该地区公民的生活造成了严重影响，因此[asker_faction_name]决定彻底击溃这伙强盗以示惩戒。\n由于[asker_faction_name]需要处理的事务过于繁杂，因此他们没有多余的精力来专门针对这群匪徒，于是希望你能代为进行处理。\n[asker_nameDef]告诉我们这一批强盗近期在我们附近建立了一座[sitePart0_description]，因此她希望你能够帮助金鸢尾兰摧毁[label]以示惩罚。由于该行为可能导致[siteFaction_name]的报复袭击，因此[asker_nameDef]会赠予我们一个轨道能量束靶向器以防意外。\n\n摧毁该营地将可能招致[siteFaction_name]在数天内进行1~2波的报复性袭击。</li>
                <!--
                <li>groupsOf(raidCount==1,priority=1)-></li>
                <li>groupsOf-></li>
                <li>endingCommon(helpersCount==0)-></li>
                <li>endingCommon(helpersCount>=1)-></li>
                -->
            </rulesStrings>
        </questDescriptionRules>
        <root Class="QuestNode_Sequence">
            <nodes>
                <li Class="QuestNode_SubScript">
                    <def>Util_RandomizePointsChallengeRating</def>
                    <parms>
                        <pointsFactorTwoStar>1.5</pointsFactorTwoStar>
                        <pointsFactorThreeStar>2</pointsFactorThreeStar>
                    </parms>
                </li>
                <li Class="QuestNode_SubScript">
                    <def>Util_AdjustPointsForDistantFight</def>
                </li>
                <!-- 最终点数调整 -->
                <li Class="QuestNode_EvaluateSimpleCurve">
                    <value>$points</value>
                    <storeAs>points</storeAs>
                    <curve>
                        <points>
                            <li>0, 1500</li>
                            <li>1500, 1500</li>
                            <li>99999, 99999</li>
                        </points>
                    </curve>
                </li>

                <li Class="QuestNode_GetMap" />
                <li Class="OberoniaAurea.QuestNode_GetMapParent">
                    <storeAs>playerHome</storeAs>
                    <targetMap>$map</targetMap>
                </li>

                <li Class="OberoniaAurea.QuestNode_GetOberoniaAureaFaction"> <!-- 获取金鼠鼠派系 -->
                    <storeAs>OAFaction</storeAs>
                </li>

                <li Class="OberoniaAurea.QuestNode_GetSpecificFactionLeader"> <!-- 获取特定派系（金鼠鼠）的领导人 -->
                    <faction>$OAFaction</faction>
                    <storeAs>asker</storeAs>
                </li>

                <li Class="QuestNode_GetFaction"> <!-- does nothing if acceptable faction is already stored -->
                    <storeAs>enemyFaction</storeAs>
                    <allowEnemy>true</allowEnemy>
                    <mustBePermanentEnemy>true</mustBePermanentEnemy>
                    <mustBeHostileToFactionOf>$asker</mustBeHostileToFactionOf>
                </li>

                <li Class="QuestNode_GetSiteTile">
                    <storeAs>siteTile</storeAs>
                    <preferCloserTiles>true</preferCloserTiles>
                </li>

                <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
                    <storeAs>sitePartDefs</storeAs>
                    <storeFactionAs>siteFaction</storeFactionAs>
                    <sitePartsTags>
                        <li>
                            <tag>BanditCamp</tag>
                        </li>
                    </sitePartsTags>
                </li>

                <li Class="QuestNode_GetDefaultSitePartsParams">
                    <tile>$siteTile</tile>
                    <faction>$siteFaction</faction>
                    <sitePartDefs>$sitePartDefs</sitePartDefs>
                    <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
                </li>

                <li Class="QuestNode_GetSiteThreatPoints">
                    <storeAs>sitePoints</storeAs>
                    <sitePartsParams>$sitePartsParams</sitePartsParams>
                </li>

                <li Class="QuestNode_SubScript">
                    <def>Util_GetDefaultRewardValueFromPoints</def>
                    <parms>
                        <!-- Use the actual threat points generated (some site parts define a minimum threshold) -->
                        <points>$sitePoints</points>
                    </parms>
                </li>

                <!-- Inflate reward value. Since we're basing the reward value on the threat points generated, we need to do this
             even though the threat points was deflated from the input points already. -->
                <li Class="QuestNode_Multiply">
                    <value1>$rewardValue</value1>
                    <value2>1.75</value2>
                    <storeAs>rewardValue</storeAs>
                </li>

                <li Class="QuestNode_SubScript">
                    <def>Util_GenerateSite</def>
                </li>

                <li Class="QuestNode_GenerateThing">
                    <storeAs>powerBeam</storeAs>
                    <def>OrbitalTargeterPowerBeam</def>
                </li>
                <li Class="QuestNode_DropPods">
                    <contents>$powerBeam</contents>
                    <useTradeDropSpot>true</useTradeDropSpot>
                </li>

                <li Class="QuestNode_SpawnWorldObjects">
                    <worldObjects>$site</worldObjects>
                </li>

                <li Class="QuestNode_WorldObjectTimeout">
                    <worldObject>$site</worldObject>
                    <isQuestTimeout>true</isQuestTimeout>
                    <delayTicks>$(randInt(12,28)*60000)</delayTicks>
                    <inSignalDisable>site.MapGenerated</inSignalDisable>
                    <destroyOnCleanup>true</destroyOnCleanup>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_Letter">
                                <label TKey="LetterLabelQuestExpired">任务失败：[resolvedQuestName]</label>
                                <text TKey="LetterTextQuestExpired">匪徒们已收拾好行装，离开了这里。任务[resolvedQuestName]已经失败。</text>
                            </li>
                            <li Class="QuestNode_End">
                                <outcome>Fail</outcome>
                            </li>
                        </nodes>
                    </node>
                </li>

                <!-- If we enter and leave, the map is destroyed. Fail the quest. -->
                <li Class="QuestNode_SignalActivable">
                    <inSignal>site.Destroyed</inSignal>
                    <inSignalDisable>site.AllEnemiesDefeated</inSignalDisable> <!-- 成功摧毁据点后失效 -->
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_Letter">
                                <label TKey="LetterLabelQuestFailed">任务失败：[resolvedQuestName]</label>
                                <text TKey="LetterTextQuestFailed">这个匪徒营地被发现了，但现在它已经消失了。任务[resolvedQuestName]已经失败。</text>
                            </li>
                            <li Class="QuestNode_End">
                                <outcome>Fail</outcome>
                            </li>
                        </nodes>
                    </node>
                </li>

                <li Class="QuestNode_Signal">
                    <inSignal>site.AllEnemiesDefeated</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_Notify_PlayerRaidedSomeone">
                                <getRaidersFromMapParent>$site</getRaidersFromMapParent>
                            </li>
                            <li Class="QuestNode_Letter">
                                <label>匪徒营地被摧毁</label>
                                <text>你已经成功摧毁了匪徒营地！\n\n但当心，来自[enemyFaction_pawnsPlural]的报复袭击将很快到达！</text>
                            </li>
                            <!-- Helper(s) 
                            <!li Class="QuestNode_SubScript">
                                <def>Util_MaybeGenerateHelpers</def>
                                <parms>
                                    <helpersChance>0.4</helpersChance>
                                    <sendArrivalLetter>true</sendArrivalLetter>
                                    <helpersLeaveAfterTicks>-1</helpersLeaveAfterTicks>
                                </parms>
                            </li>
                            -->
                            <!-- Raid(s) -->
                            <li Class="QuestNode_GetRandomInRangeInt">
                                <storeAs>raidCount</storeAs>
                                <range>1~2</range>
                            </li>
                            <li Class="QuestNode_Set">
                                <name>firstRaidDelayTicks</name>
                                <value>$(roundToTicksRough(randInt(100000, 140000)))</value>
                            </li>
                            <li Class="QuestNode_Subscript">
                                <def>Util_RaidDelayRepeatable</def>
                                <parms>
                                    <map>$map</map>
                                    <points>$($points)</points>
                                </parms>
                            </li>
                        </nodes>
                    </node>
                </li>
                <!-- End -->
                <li Class="QuestNode_AllSignals">
                    <inSignals>
                        <li>AllRaidsSent</li> <!-- 所有袭击均已经来袭 -->
                        <li>raid$($raidCountMinusOne)/lord.AllEnemiesDefeated</li> <!-- 至少击败第一波袭击 -->
                    </inSignals>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_Delay">
                                <delayTicks>300</delayTicks> <!-- 延迟300tick -->
                                <node Class="QuestNode_Sequence">
                                    <nodes>
                                        <li Class="OberoniaAurea.QuestNode_OaAssistPointsChange">
                                            <changePoints>20</changePoints>
                                        </li>
                                        <li Class="QuestNode_GiveRewards">
                                            <parms>
                                                <allowGoodwill>true</allowGoodwill>
                                                <allowRoyalFavor>true</allowRoyalFavor>
                                                <chosenPawnSignal>ChosenPawnForReward</chosenPawnSignal>
                                            </parms>
                                            <addCampLootReward>true</addCampLootReward>
                                            <customLetterLabel TKey="LetterLabelPaymentArrived">奖励已送达</customLetterLabel>
                                            <customLetterText TKey="LetterTextPaymentArrived">你已经摧毁了匪徒营地，并击败了随之而来的报复部队！\n\n来自[asker_faction_name]的奖励已经送达。你因此获得了20支援点数。</customLetterText>  <!-- 改 -->
                                            <nodeIfChosenPawnSignalUsed Class="QuestNode_Letter">
                                                <letterDef>ChoosePawn</letterDef>
                                                <label TKey="LetterLabelFavorReceiver">[asker_faction_royalFavorLabel]</label>
                                                <text TKey="LetterTextFavorReceiver">殖民者们成功的完成了[resolvedQuestName]这项任务。 [asker_definite]想要知道谁应该接受这[royalFavorReward_amount] x [asker_faction_royalFavorLabel]。</text>
                                                <useColonistsOnMap>$playerHome</useColonistsOnMap>
                                                <chosenPawnSignal>ChosenPawnForReward</chosenPawnSignal>
                                            </nodeIfChosenPawnSignalUsed>
                                        </li>
                                        <li Class="QuestNode_End">
                                            <outcome>Success</outcome> <!-- 任务成功 -->
                                        </li>
                                    </nodes>
                                </node>
                            </li>
                        </nodes>
                    </node>
                </li>
            </nodes>
        </root>
    </QuestScriptDef>

</Defs>