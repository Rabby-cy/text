<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <QuestScriptDef>
        <defName>OA_OpportunitySite_MultiPartyTalks</defName>
        <rootSelectionWeight>1</rootSelectionWeight>
        <rootMinProgressScore>10</rootMinProgressScore>
        <autoAccept>true</autoAccept>
        <defaultChallengeRating>1</defaultChallengeRating>
        <questNameRules>
            <rulesStrings>
                <li>questName->[OAFaction_leader_nameDef]的[OA_MultiPartyTalks]</li>
                <li>questName->[OAFaction_leader_nameDef]举行的[OA_MultiPartyTalks]</li>
                <li>questName->[OA_MultiPartyTalks]</li>
                <li>questName->[OA_MultiPartyTalks]</li>
                <li>OA_MultiPartyTalks->多方会谈</li>
                <li>OA_MultiPartyTalks->多方外交</li>
                <li>OA_MultiPartyTalks->多方会晤</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <li>questDescription->[OAFaction_name]的[OAFaction_leaderTitle]，[OAFaction_leader_nameFull]给我们发来一条消息。[OAFaction_leader_pronoun]预计将会举行一场涉及多方势力的会谈，以协助各派系调和彼此之间的关系，促进星球上的和睦氛围。\n\n这是个改善派系之间关系以及为[OAFaction_name]做出贡献的极好机会， 但由于这场会谈涉及的要素与势力过多，因此如果你的谈判者不够出色，那么他将会有概率造成一场灾难。[extraLeaderPart][favorRewardDetails]</li>
                <li>favorRewardDetails(OAFaction_leader_royalInCurrentFaction==True,priority=1)->\n\n若是成功促进会谈进展将可以为 [OAFaction_name] 的谈判代表积累一部分个人 [OAFaction_royalFavorLabel]。</li>
                <li>favorRewardDetails-></li>
                <li MayRequire="Ludeon.RimWorld.Ideology">extraLeaderPart(priority=1)->\n\n[leaderRoleEffect] [leaderPawnInfo]</li>
                <li>extraLeaderPart-></li>
                <li>leaderRoleEffect->如果你派你的领袖去处理谈判，其他派系会更尊重你。</li>
                <li>leaderPawnInfo(playerFaction_hasLeader==True,priority=1)-> [playerFaction_leaderTitle] [playerFaction_leader_nameFull]将会获得额外的成功率。</li>
                <li>leaderPawnInfo-></li>
            </rulesStrings>
        </questDescriptionRules>
        <root Class="QuestNode_Sequence">
            <nodes>
                <li Class="QuestNode_Set">
                    <name>siteDistRange</name>
                    <value>5~13</value>
                </li>
                <li Class="QuestNode_GetPlayerFaction">
                    <storeAs>playerFaction</storeAs>
                </li>
                <li Class="OberoniaAurea.QuestNode_GetOberoniaAureaFaction"> <!-- 获取金鼠鼠派系 -->
                    <storeAs>OAFaction</storeAs>
                    <mustNotHostile>true</mustNotHostile>
                </li>

                <li Class="QuestNode_GetMap" />
                <li Class="OberoniaAurea.QuestNode_OAGetMutiFaction"> <!-- 获取参与多方会谈的派系 -->
                    <storeAs>factions</storeAs>
                    <factionCount>3~6</factionCount>
                    <allowEnemy>true</allowEnemy>
                    <allowPermanentEnemy>false</allowPermanentEnemy>
                    <playerCantBeAttackingCurrently>true</playerCantBeAttackingCurrently>
                    <leaderMustBeSafe>true</leaderMustBeSafe>
                    <mustHaveGoodwillRewardsEnabled>true</mustHaveGoodwillRewardsEnabled>
                    <exclude>$OAFaction</exclude>
                </li>

                <li Class="QuestNode_QuestUnique">
                    <tag>OA_RK_MultiPartyTalks</tag>
                    <faction>$OAFaction</faction>
                </li>

                <li Class="QuestNode_GetSiteTile">
                    <storeAs>tile</storeAs>
                </li>

                <li Class="OberoniaAurea.QuestNode_GenerateWorldObjectWithMutiFactions"> <!-- 生成大地图事件点（关联多个派系） -->
                    <def>OA_RK_MultiPartyTalks</def>
                    <tile>$tile</tile>
                    <faction>$OAFaction</faction>
                    <participantFactions>$factions</participantFactions>
                    <storeAs>OA_RK_MultiPartyTalks</storeAs>
                </li>
                <li Class="QuestNode_SpawnWorldObjects">
                    <worldObjects>$OA_RK_MultiPartyTalks</worldObjects>
                    <tile>$tile</tile>
                </li>

                <li Class="QuestNode_Delay">
                    <delayTicks>$(randInt(12,28)*60000)</delayTicks>
                    <outSignalComplete>OA_RK_MultiPartyTalksTimeout</outSignalComplete>
                </li>

                <li Class="QuestNode_DestroyWorldObject">
                    <inSignal>OA_RK_MultiPartyTalksTimeout</inSignal>
                    <worldObject>$OA_RK_MultiPartyTalks</worldObject>
                </li>
                <li Class="QuestNode_Signal">
                    <inSignal>OA_RK_MultiPartyTalksTimeout</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_Letter">
                                <label TKey="LetterLabelQuestExpired">任务已失效：[resolvedQuestName]</label>
                                <text TKey="LetterTextQuestExpired">[OAFaction_name]举行的多方会谈已过期。 任务已失效：[resolvedQuestName]。</text>
                            </li>
                            <li Class="QuestNode_End">
                                <outcome>Fail</outcome>
                            </li>
                        </nodes>
                    </node>
                </li>

                <li Class="QuestNode_End">
                    <inSignal>OA_RK_MultiPartyTalks.Resolved</inSignal>
                    <outcome>Success</outcome>
                </li>
            </nodes>
        </root>
    </QuestScriptDef>
</Defs>