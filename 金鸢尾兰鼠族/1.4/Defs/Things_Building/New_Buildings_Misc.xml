<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>OA_RK_Rese_A</defName>
    <label>Oberonia Aurea Optical Research Platform</label>
    <description>A research platform focused on optical research, equipped with optical instruments that can simulate different environments and achieve different effects, mainly used for research on brightness, high-energy light, and crystals. \n\nWhen the illumination is not less than 70%, provide a 15% research speed bonus for all research stations within a radius of 20 grids. Only one bonus of the same type is effective.</description>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <fillPercent>0.4</fillPercent>
    <graphicData>
      <texPath>Building/OA_RK_Rese_A</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.4,1.35)</drawSize>
      <shadowData>
        <volume>(0.8, 0.35, 0.8)</volume>
        <offset>(0, 0, -0.2)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2420</uiOrder>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>12000</WorkToBuild>
      <Mass>15</Mass>
      <Flammability>0</Flammability>
      <Beauty>20</Beauty>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>25</Steel>
      <Plasteel>60</Plasteel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>OA_RK_Constant_Temperature_Hydroponics</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>250</basePowerConsumption>
      </li>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <ResearchSpeedFactor>0.15</ResearchSpeedFactor>
        </statOffsets>
        <maxDistance>20</maxDistance>
      </li>
      <li Class="OB.CompProperties_IncreaseWorkingSpeed_AoE">
        <sunlight>0.7</sunlight>
        <range>20</range>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(200,180,120,0)</glowColor>
        <colorPickerEnabled>false</colorPickerEnabled>
        <darklightToggle>false</darklightToggle>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <placeWorkers>
      <li>OB.PlaceWorker_OA_ShowAoE</li>
      <!--li>PlaceWorker_NotUnderRoof</li-->
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
  </ThingDef>

  <ThingDef ParentName="BenchBase">
