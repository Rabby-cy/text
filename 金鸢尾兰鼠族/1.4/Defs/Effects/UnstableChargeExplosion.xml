<Defs>
<!-- Core -->
<ThingDef ParentName="OA_RKBase_Mote">
    <defName>OA_RKMote_UnstableChargeExplosion_Core</defName>
    <graphicData>
        <texPath>Effects/UnstableChargeExplosion/Core</texPath>
        <shaderType>MoteGlow</shaderType>
        <drawSize>3</drawSize>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
        <fadeInTime>0.0</fadeInTime>
        <solidTime>0.1</solidTime>
        <fadeOutTime>0.1</fadeOutTime>
        <growthRate>-1.5</growthRate>
        <collide>true</collide>
        <rotateTowardsMoveDirection>true</rotateTowardsMoveDirection>
    </mote>
</ThingDef>
