<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    
<ThingDef Name="OA_RKBase_Weapon" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
        <onGroundRandomRotateAngle>20</onGroundRandomRotateAngle>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>1.2</drawSize>
        <!-- On the ground. -->
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <statBases>
        <MaxHitPoints>100</MaxHitPoints>
        <DeteriorationRate>2</DeteriorationRate>
        <Flammability>0.1</Flammability>
        <Beauty>5</Beauty>
        <WorkToMake>60000</WorkToMake>
        <SellPriceFactor>0.2</SellPriceFactor>
    </statBases>
    <useHitPoints>true</useHitPoints>
    <tickerType>Never</tickerType>
    <drawerType>MapMeshOnly</drawerType>
    <drawGUIOverlay>true</drawGUIOverlay>
    <alwaysHaulable>true</alwaysHaulable>
    <selectable>true</selectable>
    <equipmentType>Primary</equipmentType>
    <category>Item</category>
    <pathCost>12</pathCost>
    <smeltable>true</smeltable>
    <!-- Can be recycled. -->
    <allowedArchonexusCount>0</allowedArchonexusCount>
    <relicChance>0</relicChance>
    <comps>
        <li>
            <compClass>CompEquippable</compClass>
        </li>
        <li>
            <compClass>CompQuality</compClass>
        </li>
        <li Class="CompProperties_Forbiddable"/>
        <li Class="CompProperties_Styleable"></li>
        <li Class="CompProperties_Biocodable"/>
        <li Class="CompProperties_Art">
            <nameMaker>NamerArtWeaponGun</nameMaker>
            <descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
            <minQualityForArtistic>Excellent</minQualityForArtistic>
        </li>
    </comps>
    <inspectorTabs>
        <li>ITab_Art</li>
    </inspectorTabs>
    <thingSetMakerTags>
        <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <weaponTags>
        <li>OA_RKTag_Weapon</li>
    </weaponTags>
</ThingDef>

<ThingDef Name="OA_RKBase_RangedWeapon" ParentName="OA_RKBase_Weapon" Abstract="True">
    <techLevel>Spacer</techLevel>
    <!-- Spacer -->
    <soundInteract>OA_RKSO_Interaction_RangedWeaponOn</soundInteract>
    <weaponClasses>
        <li>Ranged</li>
    </weaponClasses>
    <thingCategories>
        <li>WeaponsRanged</li>
    </thingCategories>
    <tradeTags>
        <li>WeaponRanged</li>
    </tradeTags>
    <tradeability>Sellable</tradeability>
    <!-- Only Sellable. -->
</ThingDef>

<ThingDef Name="OA_RKBase_RangedChargeWeapon" ParentName="OA_RKBase_Weapon" Abstract="True">
    <techLevel>Ultra</techLevel>
    <!-- Ultra -->
    <soundInteract>OA_RKSO_Interaction_ChargeRangedWeaponOn</soundInteract>
    <weaponClasses>
        <li>Ranged</li>
    </weaponClasses>
    <thingCategories>
        <li>WeaponsRanged</li>
    </thingCategories>
    <tradeTags>
        <li>WeaponRanged</li>
    </tradeTags>
    <tradeability>Sellable</tradeability>
    <!-- Only Sellable. -->
</ThingDef>

</Defs>