<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<ThingDef ParentName="OA_RKBase_RangedChargeWeapon">
    <defName>OA_RK_ChargeSSR</defName>
    <label>Unstable Charged Support Rifle</label>
    <description>The Oberonia Aurea Empire is the product of an emergency armament change after the First Galactic Contact. Although it was an emergency product, it was somehow quite successful, and the Unstable Charged's impressive lethal performance more than makes up for its lack of accuracy. \n\nUnstable Charged The actual damage of the weapon fluctuates between 40% and 120% due to the instability of the charge energy. \n\n "Compared to those two heavy as hell things, I'd rather use this weapon, at least it won't scare my teammates." A certain Blitz team member commented.</description>
    <graphicData>
        <texPath>Weapons/OA_ChargeSSR</texPath>
    </graphicData>
    <statBases>
        <WorkToMake>97200</WorkToMake>
        <Mass>5.5</Mass>
        <AccuracyTouch>0.64</AccuracyTouch>
        <AccuracyShort>0.74</AccuracyShort>
        <AccuracyMedium>0.60</AccuracyMedium>
        <AccuracyLong>0.32</AccuracyLong>
        <RangedWeapon_Cooldown>1.1</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
        <li>
            <verbClass>Verb_Shoot</verbClass>
            <defaultProjectile>OA_RK_ChargeSSRBullet</defaultProjectile>
            <soundCast>OA_RKSO_ChargeSSRFire</soundCast>
            <soundCastTail>OA_RKSO_LightUraniumBulletTail</soundCastTail>
            <hasStandardCommand>true</hasStandardCommand>
            <warmupTime>0.7</warmupTime>
            <range>39</range>
            <burstShotCount>1</burstShotCount>
            <ticksBetweenBurstShots>20</ticksBetweenBurstShots>
            <muzzleFlashScale>12</muzzleFlashScale>
        </li>
    </verbs>
    <tools>
        <li>
            <label>枪管</label>
            <!-- 枪管 -->
            <capacities>
                <li>Blunt</li>
            </capacities>
            <power>7</power>
            <cooldownTime>2.00</cooldownTime>
            <armorPenetration>0.16</armorPenetration>
            <chanceFactor>1</chanceFactor>
        </li>
        <li>
            <label>枪托</label>
            <!-- 枪托 -->
            <capacities>
                <li>Blunt</li>
            </capacities>
            <power>8</power>
            <cooldownTime>2.00</cooldownTime>
            <armorPenetration>0.20</armorPenetration>
            <chanceFactor>1</chanceFactor>
        </li>
    </tools>
    <weaponTags>
        <li>OA_RK_Advanced_Support_Weapon_II</li>
    </weaponTags>
	<recipeMaker>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Crafting</workSkill>
        <effectWorking>Smith</effectWorking>
        <soundWorking>Recipe_Smith</soundWorking>
        <recipeUsers>
            <li>FabricationBench</li>
        </recipeUsers>
        <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
        <researchPrerequisite>OA_RK_Weapon_E</researchPrerequisite>
        <skillRequirements>
            <Crafting>14</Crafting>
        </skillRequirements>
        <displayPriority>209</displayPriority>
    </recipeMaker>
    <costList>
		<Uranium>20</Uranium>
		<Plasteel>125</Plasteel>
		<ComponentSpacer>9</ComponentSpacer>
    </costList>
</ThingDef>
<ThingDef ParentName="OA_RKBase_ChargeBullet">
    <defName>OA_RK_ChargeSSRBullet</defName>
    <label>电荷弹</label>
    <!-- 电荷弹 -->
    <graphicData>
        <texPath>Bullets/OA_ChargeBullet</texPath>
    </graphicData>
    <projectile>
        <damageDef>OA_RKDA_ChargeBullet</damageDef>
        <damageAmountBase>46</damageAmountBase>
        <armorPenetrationBase>0.80</armorPenetrationBase>
        <stoppingPower>3</stoppingPower>
        <speed>120</speed>
    </projectile>
</ThingDef>
  
</Defs>
