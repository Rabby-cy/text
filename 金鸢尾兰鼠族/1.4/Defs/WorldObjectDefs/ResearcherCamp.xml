<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <SitePartDef ParentName="Outpost">
    <defName>OA_RK_ResearcherCamp</defName>
    <label>研究据点</label>
    <description>一个研究据点。</description>
    <siteTexture>World/OA_RK_ResearcherCamp</siteTexture>
    <expandingIconTexture>World/OA_RK_ResearcherCamp</expandingIconTexture>
    <selectionWeight>0</selectionWeight>
    <requiresFaction>false</requiresFaction>
    <approachOrderString>袭击 {0}</approachOrderString>
    <approachingReportString>袭击 {0}</approachingReportString>
    <arrivedLetter>几位倒霉的研究者在这个地区</arrivedLetter>
    <tags Inherit="False">
      <li>OA_RK_ResearcherCamp</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>OA_RK_ResearcherCamp</defName>
    <linkWithSite>OA_RK_ResearcherCamp</linkWithSite>
    <order>550</order>
    <genStep Class="OberoniaAurea.GenStep_ResearcherCamp" />
  </GenStepDef>

  <RuleDef>
    <defName>OA_ResearcherCamp</defName>
    <symbol>oa_researcherCamp</symbol>
    <resolvers>
      <li Class="OberoniaAurea.SymbolResolver_ResearcherCamp">
        <minRectSize>(12, 12)</minRectSize>
      </li>
    </resolvers>
  </RuleDef>

  <RuleDef>
    <defName>OA_SingleResearcher</defName>
    <symbol>oa_SingleResearcher</symbol>
    <resolvers>
      <li Class="OberoniaAurea.SymbolResolver_SingleResearcher" />
    </resolvers>
  </RuleDef>

</Defs>