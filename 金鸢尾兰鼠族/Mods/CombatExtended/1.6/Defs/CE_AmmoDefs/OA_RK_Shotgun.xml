	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_OAShot</defName>
		<label>12 Gauge</label>
		<ammoTypes>
			<Ammo_OAShot_Buck>Bullet_OAShot_Buck</Ammo_OAShot_Buck>
			<Ammo_OAShot_Slug>Bullet_OAShot_Slug</Ammo_OAShot_Slug>
			<Ammo_OAShot_Beanbag>Bullet_OAShot_Beanbag</Ammo_OAShot_Beanbag>
		</ammoTypes>
