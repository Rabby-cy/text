		<jobString>Making 10 gauge (Buck) shells.</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Uranium</li>
					</thingDefs>
				</filter>
				<count>38</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Uranium</li>
			</thingDefs>
		</fixedIngredientFilter>
