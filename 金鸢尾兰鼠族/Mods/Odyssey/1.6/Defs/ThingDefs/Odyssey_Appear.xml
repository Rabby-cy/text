<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="ApparelBase">
        <defName>OARK_Apparel_GravShieldBelt</defName>
        <label>Obernoia Aurea Vacuum Shield Belt</label>
        <description>A standard-issue belt uniformly distributed to all crew members by the Obernoia Aurea Navigation Department. This belt can form a self-adjusting gravitational field that surrounds the wearer, restraining surrounding gases and blocking high-speed projectiles.\n\nHowever, as the gravitational field requires time to stabilize, it is difficult to sustain against continuous interference, and its presence will also affect the wearer's shooting accuracy.</description>
        <thingClass>Apparel</thingClass>
        <graphicData>
            <texPath>Apparel/OARK_Apparel_GravShieldBelt</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <tickerType>Normal</tickerType>
        <techLevel>Spacer</techLevel>
        <statBases>
            <Mass>2.2</Mass>
            <WorkToMake>36000</WorkToMake>
            <Flammability>0</Flammability>
            <EnergyShieldRechargeRate>0.03</EnergyShieldRechargeRate>
            <EnergyShieldEnergyMax>0.72</EnergyShieldEnergyMax>
            <EquipDelay>3.5</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <VacuumResistance>0.8</VacuumResistance>
        </equippedStatOffsets>
        <thingSetMakerTags><!--可能的获取路径：高质量的任务奖励--><!--看不懂，但我想我最好别碰这个东西x-->
            <li>RewardStandardQualitySuper</li>
        </thingSetMakerTags>
        <costList>
            <ComponentIndustrial>6</ComponentIndustrial>
            <Uranium>20</Uranium>
            <Plasteel>50</Plasteel>
        </costList>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedBelt</unfinishedThingDef>
            <researchPrerequisite>OARK_Odyssey_GravityApplication</researchPrerequisite>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>Smith</effectWorking>
            <soundWorking>Recipe_Machining</soundWorking>
            <recipeUsers>
                <li>TableMachining</li>
            </recipeUsers>
            <useIngredientsForColor>false</useIngredientsForColor>
            <skillRequirements>
                <Crafting>12</Crafting>
            </skillRequirements>
            <displayPriority>300</displayPriority>
        </recipeMaker>
        <thingCategories>
            <li>ApparelUtility</li>
        </thingCategories>
        <apparel>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <careIfWornByCorpse>false</careIfWornByCorpse>
            <careIfDamaged>false</careIfDamaged>
            <wearPerDay>0</wearPerDay>
            <bodyPartGroups>
                <li>Waist</li>
            </bodyPartGroups>
            <layers>
                <li>Belt</li>
            </layers>
            <tags>
                <li>OARatkin_Spaceport_AssaulterArmor</li>
				<li>OARatkin_NavigateApparel</li>
            </tags>
            <developmentalStageFilter>Child, Adult</developmentalStageFilter>
        </apparel>
        <comps>
            <li Class="OberoniaAurea.CompProperties_GravShield">
                <hediffOnActive>OARK_Hediff_GravShieldBelt</hediffOnActive>
                <blocksRangedWeapons>false</blocksRangedWeapons>
            </li>
        </comps>
        <allowedArchonexusCount>1</allowedArchonexusCount>
        <tradeTags>
            <li>Armor</li>
        </tradeTags>
    </ThingDef>

</Defs>