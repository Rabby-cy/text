    <ThingDef ParentName="OA_SkyWarmthBase">
        <defName>OARK_GravFieldGenerator</defName>
        <label>Small Gravitational Field Generator</label>
        <description>A gravitational device that can continuously construct a gravitational field around it and attach to nearby units, often used by the Golden Iris Orchid Empire to provide temporary vacuum protection during the initial construction of an airport.\n\nWhen the airport is invaded, this device can also actively create a strong gravitational field to suppress all individuals within its range.</description>
        <size>(3,3)</size>
        <graphicData>
            <texPath>Building/OARK_GravFieldGenerator</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(3.9,3.9)</drawSize>
            <shadowData>
                <volume>(3.5,0.75,3.4)</volume>
                <offset>(0,0,0)</offset>
            </shadowData>
        </graphicData>
        <constructionSkillPrerequisite>15</constructionSkillPrerequisite>
        <researchPrerequisites>
            <li>OARK_Odyssey_GravFieldCore</li>
        </researchPrerequisites>
        <rotatable>false</rotatable>
        <uiOrder>2420</uiOrder>
        <statBases>
            <MaxHitPoints>500</MaxHitPoints>
            <WorkToBuild>82000</WorkToBuild>
            <Mass>125</Mass>
            <Flammability>0</Flammability>
            <Beauty>142</Beauty>
        </statBases>
        <costList>
            <Uranium>280</Uranium>
            <Plasteel>200</Plasteel>
            <ComponentSpacer>5</ComponentSpacer>
        </costList>
        <comps>
            <li Class="OberoniaAurea.CompProperties_GiveHediffInRange_Building">
                <compClass>OberoniaAurea.CompGiveHediffInRange_GravField</compClass>
                <range>55.9</range>
                <hediff>OARK_Hediff_GravField</hediff>
                <checkInterval>250</checkInterval>
            </li>
            <li Class="CompProperties_MoteEmitter">
                <mote>Mote_PsychicEmanatorEffect</mote>
                <emissionInterval>350</emissionInterval>
            </li>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>1400</basePowerConsumption>
            </li>
            <li Class="CompProperties_Glower">
                <glowRadius>8</glowRadius>
                <glowColor>(200,180,180,0)</glowColor>
                <colorPickerEnabled>false</colorPickerEnabled>
                <darklightToggle>false</darklightToggle>
            </li>
        </comps>
    </ThingDef>

</Defs>