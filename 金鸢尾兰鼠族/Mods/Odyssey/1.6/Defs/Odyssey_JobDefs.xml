    <reportString>对 TargetA. 进行引力调整</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
    <modExtensions>
      <li Class="OberoniaAurea_Frame.JobExtension">
        <jobExtensionRecord>
          <jobSkill>Intellectual</jobSkill>
          <skillXpPerTick>1.0</skillXpPerTick>
          <defaultWorkAmount>90</defaultWorkAmount>
          <jobStat>ResearchSpeed</jobStat>
