<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<WorkGiverDef Name="OAGene_CarryToBase" Abstract="true">
		<giverClass>OberoniaAureaGene.Ratkin.WorkGiver_CarryToBuildingEnterable</giverClass>
		<workType>Hauling</workType>
		<verb>基因提取</verb>
		<gerund>提取基因于</gerund>
		<priorityInType>90</priorityInType>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
		<canBeDoneByMechs>false</canBeDoneByMechs>
	</WorkGiverDef>

	<WorkGiverDef ParentName="OAGene_CarryToBase">
		<defName>OAGene_CarryToRatkinDestructiveGeneDiscriminator</defName>
		<label>鼠族破坏性基因提取仪</label>
		<modExtensions>
			<li Class="OberoniaAureaGene.Ratkin.WorkGiverHaulToExtension">
				<thingDef>OAGene_RatkinDestructiveGeneDiscriminator</thingDef>
			</li>
		</modExtensions>
	</WorkGiverDef>

	<WorkGiverDef MayRequire="OARK.RatkinFaction.OberoniaAurea" ParentName="OAGene_CarryToBase">
		<defName>OAGene_CarryToOAGeneFragmentInterceptor</defName>
		<label>带到金鸢尾兰基因片段截取仪</label>
		<modExtensions>
			<li Class="OberoniaAureaGene.Ratkin.WorkGiverHaulToExtension">
				<thingDef>OAGene_OAGeneFragmentInterceptor</thingDef>
			</li>
		</modExtensions>
	</WorkGiverDef>

	<WorkGiverDef MayRequire="OARK.RatkinFaction.OberoniaAurea" ParentName="OAGene_CarryToBase">
		<defName>OAGene_CarryToOAGeneRepairInstrument</defName>
		<label>带到金鸢尾兰基因修复仪</label>
		<modExtensions>
			<li Class="OberoniaAureaGene.Ratkin.WorkGiverHaulToExtension">
				<thingDef>OAGene_OAGeneRepairInstrument</thingDef>
			</li>
		</modExtensions>
	</WorkGiverDef>

	<WorkGiverDef>
		<defName>OAGene_CarryToRatkinGeneDiscriminator</defName>
		<label>带到鼠族基因辨析仪</label>
		<giverClass>OberoniaAureaGene.Ratkin.WorkGiver_HaulToGeneDiscriminat</giverClass>
		<workType>Hauling</workType>
		<verb>extract from</verb>
		<gerund>extracting from</gerund>
		<priorityInType>110</priorityInType>
		<requiredCapacities>
		  <li>Manipulation</li>
		</requiredCapacities>
		<modExtensions>
			<li Class="OberoniaAureaGene.Ratkin.WorkGiverHaulToExtension">
				<thingDef>OAGene_RatkinGeneDiscriminator</thingDef>
			</li>
		</modExtensions>
	</WorkGiverDef>

	<WorkGiverDef MayRequire="OARK.RatkinFaction.OberoniaAurea">
		<defName>OAGene_CarryToOARatkinGeneDiscriminator</defName>
		<label>带到金鸢尾兰基因辨析仪</label>
		<giverClass>OberoniaAureaGene.Ratkin.WorkGiver_HaulToGeneDiscriminat</giverClass>
		<workType>Hauling</workType>
		<verb>extract from</verb>
		<gerund>extracting from</gerund>
		<priorityInType>110</priorityInType>
		<requiredCapacities>
		  <li>Manipulation</li>
		</requiredCapacities>
		<modExtensions>
			<li Class="OberoniaAureaGene.Ratkin.WorkGiverHaulToExtension">
				<thingDef>OAGene_OARatkinGeneDiscriminator</thingDef>
			</li>
		</modExtensions>
	</WorkGiverDef>

</Defs>