<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>NewRatkinPlus</li>
            <li>NewRatkinPlus[1.6]</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationConditional">
                    <xpath>/Defs/FactionDef[@Name="RatkinFactionBase" or @Name="RK_PlayerFactionBase"]/modExtensions/li[@Class="OberoniaAurea_Frame.RatkinFactionFlag"]</xpath>
                    <nomatch Class="PatchOperationAddModExtension">
                        <xpath>/Defs/FactionDef[@Name="RatkinFactionBase" or @Name="RK_PlayerFactionBase"]</xpath>
                        <value>
                            <li Class="OberoniaAurea_Frame.RatkinFactionFlag"/>
                        </value>
                    </nomatch>
                </li>
                <li Class="PatchOperationConditional">
                    <xpath>/Defs/FactionDef[defName="Rakinia"]/modExtensions/li[@Class="OberoniaAurea_Frame.FactionTagsExtension"]</xpath>
                    <nomatch Class="PatchOperationAddModExtension">
                        <xpath>/Defs/FactionDef[defName="Rakinia"]</xpath>
                        <value>
                            <li Class="OberoniaAurea_Frame.FactionTagsExtension">
                                <factionTags>
                                    <li>RatkinKindom</li>
                                </factionTags>
                            </li>
                        </value>
                    </nomatch>
                </li>
            </operations>
        </match>

    </Operation>

</Patch>