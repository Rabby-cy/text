<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PreceptDef[defName="Skullspike_Disapproved"]/conflictingMemes</xpath>
        <value>
            <li>OAGene_TerritorialHegemony</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/PreceptDef[defName="IdeoDiversity_Respected" or defName="IdeoDiversity_Approved" or defName="IdeoDiversity_Exalted"]/conflictingMemes</xpath>
        <match Class="PatchOperationAdd">
            <xpath>Defs/PreceptDef[defName="IdeoDiversity_Respected" or defName="IdeoDiversity_Approved" or defName="IdeoDiversity_Exalted"]/conflictingMemes</xpath>
            <value>
                <li>OAGene_TerritorialHegemony</li>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/PreceptDef[defName="IdeoDiversity_Respected" or defName="IdeoDiversity_Approved" or defName="IdeoDiversity_Exalted"]</xpath>
            <value>
                <conflictingMemes>
                    <li>OAGene_TerritorialHegemony</li>
                </conflictingMemes>
            </value>
        </nomatch>
    </Operation>


    <!--Operation Class="PatchOperationConditional">
        <xpath>Defs/PreceptDef[defName="IdeoDiversity_Exalted"]/conflictingMemes</xpath>
        <match Class="PatchOperationAdd">
            <xpath>Defs/PreceptDef[defName="IdeoDiversity_Exalted"]/conflictingMemes</xpath>
            <value>
                <li>OAGene_TerritorialHegemony</li>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/PreceptDef[defName="IdeoDiversity_Exalted"]</xpath>
            <value>
                <conflictingMemes>
                    <li>OAGene_TerritorialHegemony</li>
                </conflictingMemes>
            </value>
        </nomatch>
    </Operation-->

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PreceptDef[defName = "Corpses_DontCare"]/associatedMemes</xpath>
        <value>
            <li>OAGene_TerritorialHegemony</li>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PreceptDef[defName = "Corpses_DontCare"]/requiredMemes</xpath>
        <value>
            <li>OAGene_TerritorialHegemony</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PreceptDef[defName = "IdeoRole_ShootingSpecialist" or defName = "IdeoRole_MeleeSpecialist"]/requiredMemes</xpath>
        <value>
            <li>OAGene_TerritorialHegemony</li>
        </value>
    </Operation>

</Patch>