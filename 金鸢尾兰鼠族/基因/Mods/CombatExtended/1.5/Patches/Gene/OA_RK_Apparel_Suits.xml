<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>NewRatkinPlus</li>
			<li>NewRatkinPlus[1.6]</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>Defs/GeneDef[defName="OAGene_RatkinTail"]/statOffsets/MeleeDodgeChance</xpath>
					<value>
						<MeleeDodgeChance>1.2</MeleeDodgeChance>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="OAGene_AgilityAction"]/statOffsets/MeleeDodgeChance</xpath>
		<value>
			<MeleeDodgeChance>1.5</MeleeDodgeChance>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="OAGene_AgilityAction"]/statFactors/MeleeDodgeChance</xpath>
		<value>
			<MeleeDodgeChance>1.5</MeleeDodgeChance>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="OAGene_MildNearsightedness"]/statFactors</xpath>
		<value>
			<statFactors>
				<ShootingAccuracyPawn>0.9</ShootingAccuracyPawn>
				<AimingAccuracy>0.75</AimingAccuracy>
			</statFactors>
		</value>
	</Operation>

</Patch>