<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <RulePackDef>
        <defName>OAGene_ColdSnowSpeech</defName>
        <rulePack>
            <rulesStrings>
                <li>speech_root->[speechSentence]</li>

                <li>speechSentence(speechSection==1)->冷...</li>
                <li>speechSentence(speechSection==1)->好冷...</li>
                <li>speechSentence(speechSection==1)->太冷了...</li>
                <li>speechSentence(speechSection==1)->啊...好冷。</li>
                <li>speechSentence(speechSection==1)->这个温度...</li>
                <li>speechSentence(speechSection==1)->比铁还要冰凉...</li>
                <li>speechSentence(speechSection==1)->为什么会这么冷？</li>
                <li>speechSentence(speechSection==1)->这里难道是极地吗...</li>
                <li>speechSentence(speechSection==1)->我会被冻死在这里吗？</li>

                <li>speechSentence(speechSection==2)->啊啊...</li>
                <li>speechSentence(speechSection==2)->阿嚏！！！</li>
                <li>speechSentence(speechSection==2)->阿...阿嚏！</li>

                <li>speechSentence(speechSection==3)->呃...好痛。</li>
                <li>speechSentence(speechSection==3)->这场雪好痛啊...</li>
                <li>speechSentence(speechSection==3)->我想取暖...</li>
                <li>speechSentence(speechSection==3)->也许我该先做个火把...</li>
                <li>speechSentence(speechSection==3)->感觉手没知觉了...</li>
                <li>speechSentence(speechSection==3)->身体逐渐失去了知觉...</li>
                <li>speechSentence(speechSection==3)->希望不会发烧。</li>
                <li>speechSentence(speechSection==3)->我需要更多衣服。</li>
                <li>speechSentence(speechSection==3)->好大的风...</li>
                <li>speechSentence(speechSection==3)->我想回家...</li>

                <li>speechSentence(speechSection==4)->（打颤）</li>
                <li>speechSentence(speechSection==4)->（哆嗦）</li>
                <li>speechSentence(speechSection==4)->（咳嗽声）</li>
                <li>speechSentence(speechSection==4)->（搓手取暖）</li>
                <li>speechSentence(speechSection==4)->（止不住的发抖）</li>
                <li>speechSentence(speechSection==4)->（晃脑袋保持清醒）</li>

            </rulesStrings>
        </rulePack>
    </RulePackDef>

</Defs>