<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThoughtDef>
        <defName>OAGene_Thought_SnowExtreme</defName>
        <workerClass>OberoniaAureaGene.ThoughtWorker_SnowExtreme</workerClass>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>Extreme blizzard</label>
                <description>If you get lost in this weather, it almost means death...</description>
                <baseMoodEffect>-8</baseMoodEffect>
            </li>
            <li>
                <label>Extreme blizzard</label>
                <description>Even the most steadfast belief appears vulnerable in this storm...</description>
                <baseMoodEffect>-4</baseMoodEffect>
            </li>
        </stages>
        <nullifyingTraits>
            <li>OAGene_ExtremeSnowSurvivor</li>
        </nullifyingTraits>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Thought_SnowExtremeSurvivor</defName>
        <workerClass>OberoniaAureaGene.ThoughtWorker_SnowExtremeSurvivor</workerClass>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>Facing the blizzard head-on</label>
                <description>Wind and snow, I am no longer afraid of you, you cannot blow me down again.</description><!-->\n来吧，让暴风雪来的更猛烈些吧。<-->
                <baseMoodEffect>4</baseMoodEffect>
            </li>
        </stages>
        <requiredTraits>
            <li>OAGene_ExtremeSnowSurvivor</li>
        </requiredTraits>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Thought_ColdSnow</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>Cold Snow</label>
                <description>It's so cold! so painful! Are these really snowflakes instead of blades?!!</description>
                <baseMoodEffect>-4</baseMoodEffect>
            </li>
        </stages>
        <nullifyingTraits>
            <li>OAGene_ExtremeSnowSurvivor</li>
        </nullifyingTraits>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Thought_SnowstormEnd</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <stackLimit>1</stackLimit>
        <durationDays>5</durationDays>
        <stages>
            <li>
                <label>度过了暴风雪</label>
                <description>哪怕是极端的暴风雪也没能够将我们吹垮。</description>
                <baseMoodEffect>5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>