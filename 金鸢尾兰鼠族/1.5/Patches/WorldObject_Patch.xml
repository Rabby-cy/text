        <value>
            <li Class="OberoniaAurea.WorldObjectCompProperties_ResearcherCamp" />
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/WorldObjectDef[defName="Settlement"]/comps</xpath>
