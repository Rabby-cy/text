<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <QuestScriptDef ParentName="OAFrame_HospitalityRefugeeBase_Female">
        <defName>OA_WoundedTraveler</defName>
        <rootSelectionWeight>1.0</rootSelectionWeight>
        <rootSelectionWeightFactorFromPointsCurve>
            <points>
                <li>(0,3)</li>
                <li>(200,3)</li>
                <li>(500,1)</li>
            </points>
        </rootSelectionWeightFactorFromPointsCurve>
        <expireDaysRange>4~8</expireDaysRange>
        <affectedByPoints>false</affectedByPoints>
        <affectedByPopulation>false</affectedByPopulation>
        <hideInvolvedFactionsInfo>false</hideInvolvedFactionsInfo>
        <questNameRules>
            <rulesStrings>
                <li>questName->[lodgerAdj][lodgerPlural]</li>
                <li>lodgerAdj->Wounded</li>
                <li>lodgerAdj->Tired</li>
                <li>lodgerAdj->Injured</li>
                <li>lodgerPlural->travelers</li>
                <li>lodgerPlural->voyagers</li>
                <li>lodgerPlural->explorers</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionAndNameRules>
            <rulesStrings>
                <li>lodgersLabel->voyager</li>
                <li>lodgersLabelPlural->voyagers</li>
            </rulesStrings>
        </questDescriptionAndNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <li>approachInfo->[asker_nameDef]和其他负伤的[faction_pawnSingular]正在靠近。</li>
               
                <li>approachInfo(lodgerCount>=3)->[lodgerCount]名负伤而疲倦的[faction_pawnsPlural]正在靠近， 她们的领袖是[asker_nameDef]。</li>

                <li>claimInfo->她们遇到了突发的地质灾害，尽管她们费尽体力成功逃出了这场灾难，但依然有一名同伴在逃难过程中受到了严重的摔伤，因此请求在你的殖民地进行疗养。当所有人的伤势全部恢复后，她们就会离开。</li>
            </rulesStrings>
        </questDescriptionRules>
        <questContentRules>
            <rulesStrings>
                <li>lodgersLeavingEarlyLetterLabel->[lodgersLabelSingularOrPlural] 提前离开</li>
                <li>lodgersLeavingEarlyLetterText->[asker_nameDef]感谢你允许{FACTION_leaderObjective}在[questDurationTicks_duration]里待在[map_definite]。 {FACTION_leaderPronoun}现在正与{FACTION_leaderPossessive}的伙伴们一同前进。\n\n[asker_nameDef]说{FACTION_leaderPronoun}永远不会忘记你做的这些事。</li>
            </rulesStrings>
        </questContentRules>
        <root Class="OberoniaAurea.QuestNode_Root_WoundedTraveler" />
    </QuestScriptDef>

</Defs>