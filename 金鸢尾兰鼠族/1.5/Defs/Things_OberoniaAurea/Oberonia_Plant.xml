  <ThingDef ParentName="PlantFoodRawBase">
    <defName>Oberonia_Aurea</defName>
    <label>Oberonia Aurea</label>
    <description>The petals of the Oberonia Aurea, which should be great for brewing tea.</description>
    <soundInteract>Grain_Drop</soundInteract>
    <soundDrop>Grain_Drop</soundDrop>
    <graphicData>
      <texPath>Item/Oberonia_Aurea</texPath>
    </graphicData>
    <statBases>
      <MarketValue>1.0</MarketValue>
    </statBases>
    <ingestible>
      <foodType>Seed</foodType>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>60</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>OA_RK_Rice</defName>
    <label>Oberonia Aurea hybrid rice</label>
    <description>This is a strain of rice developed by the Oberonia Aurea Empire utilizing their advanced genetical technology on the rice variants of the Galaxy. It is more sensitive to soil fertility compared to regular rice, yields higher, and features aesthetically pleasing gold and green interwoven panicles.</description>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
      <Beauty>2</Beauty>
      <BeautyOutdoors>2</BeautyOutdoors>
    </statBases>
    <graphicData>
      <texPath>Plant/OA_Rice</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <ingestible />
    <plant>
      <fertilitySensitivity>1.25</fertilitySensitivity>
      <dieIfLeafless>true</dieIfLeafless>
      <maxMeshCount>4</maxMeshCount>
      <harvestTag>Standard</harvestTag>
      <sowWork>425</sowWork>
      <harvestedThingDef>RawRice</harvestedThingDef>
      <harvestYield>9</harvestYield>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <topWindExposure>0.1</topWindExposure>
      <growDays>4</growDays>
      <visualSizeRange>0.3~0.8</visualSizeRange>
      <wildOrder>2</wildOrder>
      <purpose>Food</purpose>
      <humanFoodPlant>true</humanFoodPlant>
      <sowResearchPrerequisites>
        <li>OA_RK_Constant_Temperature_Hydroponics_B</li>
      </sowResearchPrerequisites>
    </plant>
  </ThingDef>

