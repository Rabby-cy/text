<Defs>

  <!-- 花茶 -->
  <ThingDef ParentName="DrugBase">
    <defName>Oberonia_Aurea_Tea</defName>
    <label>Oberonia Aurea tea</label>
    <description>The floral tea brewed with Oberonia Aurea petals, exudes a refreshing aroma. The clear and slightly golden color of the tea is able to settle the restless mind just by looking at it.</description>
    <descriptionHyperlinks>
      <HediffDef>OA_RK_Tea</HediffDef>
    </descriptionHyperlinks>
    <thingCategories>
      <li>OARatkin_FoodMeals</li>
    </thingCategories>
    <tickerType>Rare</tickerType>
    <socialPropernessMatters>false</socialPropernessMatters>
    <graphicData>
      <texPath>Item/Oberonia_Aurea_Tea</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <statBases>
      <MarketValue>4.6</MarketValue>
      <Mass>0.15</Mass>
      <DeteriorationRate>12</DeteriorationRate>
      <Nutrition>0.02</Nutrition>
    </statBases>
    <techLevel>Neolithic</techLevel>
    <ingestible>
      <baseIngestTicks>260</baseIngestTicks>
      <chairSearchRadius>21</chairSearchRadius>
      <preferability>DesperateOnly</preferability>
      <tasteThought></tasteThought>
      <foodType>Processed</foodType>
      <joyKind>Oberonia_Aurea_Tea_Joy</joyKind>
      <joy>0.04</joy>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <drugCategory>Social</drugCategory>
      <canAutoSelectAsFoodForCaravan>true</canAutoSelectAsFoodForCaravan>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>OA_RK_Tea</hediffDef>
          <severity>0.80</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>1.75</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_Drug">
        <listOrder>1000</listOrder>
        <overdoseSeverityOffset>0.08~0.14</overdoseSeverityOffset>
      </li>
    </comps>
    <rotatable>false</rotatable>
  </ThingDef>
  <JoyKindDef>
    <defName>Oberonia_Aurea_Tea_Joy</defName>
    <label>Fresh floral fragrance</label>
  </JoyKindDef>

