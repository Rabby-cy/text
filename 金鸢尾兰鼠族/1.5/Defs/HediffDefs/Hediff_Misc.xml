<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>OA_RK_ExtraStun</defName>
        <label>OA·额外眩晕</label>
        <description>OA_RK_ExtraStun</description>
        <hediffClass>HediffWithComps</hediffClass>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <stages>
            <li>
                <becomeVisible>false</becomeVisible>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_DisappearsOnDeath" />
            <li Class="OberoniaAurea.HediffCompProperties_ExtraStun">
                <extraStunTicks>300</extraStunTicks>
                <triggerDelay>60</triggerDelay>
            </li>
        </comps>
        <isBad>true</isBad>
    </HediffDef>

    <HediffDef>
        <defName>OARK_Hediff_ExplorationFatigue</defName>
        <label>体力耗竭</label>
        <description>体力耗竭。</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <stages>
            <li>
                <statFactors>
                    <WorkSpeedGlobal>0.5</WorkSpeedGlobal>
                    <MoveSpeed>0.8</MoveSpeed>
                    <RestFallRateFactor>6</RestFallRateFactor>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>60000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
            <li Class="HediffCompProperties_DisappearsOnDeath" />
        </comps>
    </HediffDef>

    <HediffDef ParentName="DiseaseBase">
        <defName>OARK_Hediff_SeriousInjury</defName>
        <label>严重受伤</label>
        <description>该单位的心理与生理皆受到了严重的损伤，需要一定的时间来进行修养才能缓解。</description>
        <initialSeverity>1</initialSeverity>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <stages>
            <li>
                <label>缓和</label>
                <statFactors>
                    <InjuryHealingFactor>0.35</InjuryHealingFactor>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.15</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <label>重度</label>
                <minSeverity>0.6</minSeverity>
                <statFactors>
                    <InjuryHealingFactor>0.15</InjuryHealingFactor>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.3</offset>
                    </li>
                </capMods>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.2</severityPerDay>                <!-- 5天 -->
                <showDaysToRecover>true</showDaysToRecover>
            </li>
        </comps>
    </HediffDef>

</Defs>