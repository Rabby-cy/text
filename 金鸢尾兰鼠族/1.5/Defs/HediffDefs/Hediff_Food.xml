<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>OA_RK_Tea</defName>
        <hediffClass>Hediff_High</hediffClass>
        <label>Clear Heart (Oberonia Aurea)</label>
        <description>That floral tea made me feel warm and relaxed...</description>
        <defaultLabelColor>(0.80,0.80,0.30)</defaultLabelColor>
        <scenarioCanAdd>true</scenarioCanAdd>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-3.60</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
            <li Class="OberoniaAurea.HediffCompProperties_TeaWithSkyWarmth">
                <hediff>OA_RK_hediff_SkyWarmth</hediff>
                <extraSeverity>1.0</extraSeverity>
            </li>
        </comps>
        <stages>
            <li>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.02</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.05</offset>
                    </li>
                </capMods>
                <statFactors>
                    <ImmunityGainSpeed>1.05</ImmunityGainSpeed>
                </statFactors>
                <statOffsets>
                    <ComfyTemperatureMin>-5</ComfyTemperatureMin>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

</Defs>