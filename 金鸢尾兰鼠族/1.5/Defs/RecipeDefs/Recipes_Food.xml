    <RecipeDef>
        <defName>Make_Oberonia_Aurea_Chanwu_AC</defName>
        <label>制作4份金鸢尾兰流心花糕</label>
        <description>制作4份金鸢尾兰流心花糕</description>
        <jobString>制作花糕</jobString>
        <workAmount>4320</workAmount>
        <workSpeedStat>CookSpeed</workSpeedStat>
        <requiredGiverWorkType>Cooking</requiredGiverWorkType>
        <effectWorking>Cook</effectWorking>
        <soundWorking>Recipe_CookMeal</soundWorking>
        <allowMixingIngredients>true</allowMixingIngredients>
        <fixedIngredientFilter>            <!--哦我明白了，这个影响的是生产列表右边的可用材料，如果disallowedthingDefs了就意味着这个材料不能用于制作该物品，但好像只能影响类型禁用，比如羊毛不能用于纤维类，而不能影响金鸢尾兰不能用于金鸢尾兰-->
            <categories>                <!--它应该是适用于 需要xx类材料的地方，而不适用于指定xx材料，因为它是用来指定哪些材料能充当这里的类的。-->
                <li>FoodRaw</li>                <!--好好好，我终于搞明白了-->                <!--而之前出现BUG则是因为没有设置选择范围，因此压根没有东西会被视作生食，尽管他们的确能够满足生食需求。-->
            </categories>
            <disallowedThingDefs>
                <li>Oberonia_Aurea</li>
                <li>Oberonia_Aurea_Chanwu_D</li>
            </disallowedThingDefs>
        </fixedIngredientFilter>
        <recipeUsers>
            <li>ElectricStove</li>
            <li>FueledStove</li>
        </recipeUsers>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Oberonia_Aurea</li>
                    </thingDefs>
                </filter>
                <count>40</count>
            </li>
            <li>
                <filter>
                    <categories>
                        <li>FoodRaw</li>                        <!--什么Shit代码，一份金鸢尾兰居然能同时满足金鸢尾兰与生食的需求，不是很绷-->
                    </categories>
                </filter>
                <count>20</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Oberonia_Aurea_Chanwu_D</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <products>
            <Oberonia_Aurea_Chanwu_AC>4</Oberonia_Aurea_Chanwu_AC>
        </products>
        <skillRequirements>
            <Cooking>8</Cooking>
        </skillRequirements>
        <defaultIngredientFilter>
            <categories>
                <li>FoodRaw</li>                <!--然后这个就意味着优先采用生食，尽管也可能随机到金鸢尾兰，但起码比优先采用金鸢尾兰好多了-->                <!--然后金鸢尾兰由于是强制性物品，因此不会受到优先级以及类别选择（上面那个）影响-->
            </categories>
            <!--thingDefs>
        <li>Oberonia_Aurea</li>
        <li>Oberonia_Aurea_Chanwu_D</li>
      </thingDefs-->            <!--这个影响角色是否会主动拿这些东西做，除非其他东西都没有了的情况下才会拿这个。加入这个就可以让角色在有其他生食的时候不会使用金鸢尾兰充当生食成分，但如果只有金鸢尾兰的话还是会出现40份金鸢尾兰同时满足了20生食的需求。和上面的那个的不同之处在于这个影响优先度，上面那个影响类型的可行度-->
        </defaultIngredientFilter>        <!--比如如果羊毛分别出现在这个和上面那个列表中，然后制作需要纤维，那么出现在上面那个意味着羊毛不能用于这个物品的纤维类成分，除非本身指定需要羊毛。而出现在下面这个意味着在有其他纤维成分的时候不会使用羊毛。-->
        <workSkill>Cooking</workSkill>        <!--啊不对我好像说反了，这个是预设会优先使用哪些材料，然后预设有生食就会优先用生食满足生食类？反正这个影响的应该是优先度，而不是强制性-->
        <researchPrerequisite>OA_RK_Oberonia_Aurea_Research_B</researchPrerequisite>
        <displayPriority>1445</displayPriority>
    </RecipeDef>

</Defs>