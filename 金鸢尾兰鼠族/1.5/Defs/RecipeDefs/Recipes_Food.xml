    <RecipeDef>
        <defName>Make_Oberonia_Aurea_Chanwu_C</defName>
        <label>制作10枚金鸢尾兰莓果花饼</label>
        <description>制作10枚金鸢尾兰莓果花饼</description>
        <jobString>制作莓果花饼</jobString>
        <workAmount>3200</workAmount>
        <workSpeedStat>CookSpeed</workSpeedStat>
        <requiredGiverWorkType>Cooking</requiredGiverWorkType>
        <effectWorking>Cook</effectWorking>
        <soundWorking>Recipe_CookMeal</soundWorking>
        <allowMixingIngredients>true</allowMixingIngredients>
        <fixedIngredientFilter>
            <categories>
                <li>FoodRaw</li>
            </categories>
            <disallowedThingDefs>
                <li>Oberonia_Aurea</li>
                <li>RawBerries</li>                <!--因为它已经强制性使用莓果了，所以这个判定应该是判定哪些生食用于foodraw选择，而在可行的情况下，莓果和金鸢尾兰不会被视为生食的选择。因此除非没有其他选择，否则不会出现金鸢尾兰\莓果同时满足生食的情况。-->
            </disallowedThingDefs>
        </fixedIngredientFilter>
        <recipeUsers>
            <li>ElectricStove</li>
            <li>FueledStove</li>
        </recipeUsers>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Oberonia_Aurea</li>
                    </thingDefs>
                </filter>
                <count>25</count>
            </li>
            <li>
                <filter>
                    <categories>
                        <li>FoodRaw</li>
                    </categories>
                </filter>
                <count>15</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>RawBerries</li>
                    </thingDefs>
                </filter>
                <count>10</count>
            </li>
        </ingredients>
        <products>
            <Oberonia_Aurea_Chanwu_C>10</Oberonia_Aurea_Chanwu_C>
        </products>
        <skillRequirements>
            <Cooking>10</Cooking>
        </skillRequirements>
        <defaultIngredientFilter>
            <categories>
                <li>FoodRaw</li>
            </categories>
            <thingDefs Inherit="false">
                <!--li>Oberonia_Aurea</li>
        <li>RawBerries</li-->                <!--同样的，由于莓果也是强制性成分，因此应当在选择其他生食后，最终再根据强制性要求加入莓果，而不是选择生食的时候选择莓果导致同时满足生食与莓果两个需求。-->
            </thingDefs>
            <disallowedThingDefs>
                <li>RawBerries</li>
                <li>Oberonia_Aurea</li>
            </disallowedThingDefs>
        </defaultIngredientFilter>
        <workSkill>Cooking</workSkill>
        <researchPrerequisite>OA_RK_Oberonia_Aurea_Research_B</researchPrerequisite>
        <displayPriority>1444</displayPriority>
    </RecipeDef>

