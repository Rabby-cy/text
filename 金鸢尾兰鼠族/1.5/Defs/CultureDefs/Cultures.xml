<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<CultureDef>
		<defName>OA_RK_RatkiniaTraditionCulture</defName>
		<label>Oberonia Aurea ratkin traditions</label>
		<description>Traditions of Oberonia Aurea ratkins.</description>
		<ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">OA_RK_NamerIdeo</ideoNameMaker>
		<deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeitySophian</deityNameMaker>
		<deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DeityTypeMakerSophian</deityTypeMaker>
		<leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">OA_RK_LeaderTitleMaker</leaderTitleMaker>
		<festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalSophian</festivalNameMaker>
		<allowedPlaceTags>
			<li>OriginTechnoFeudal</li>
		</allowedPlaceTags>
		<thingStyleCategories>
			<li MayRequire="Ludeon.RimWorld.Ideology">
				<category>Floristian</category>
				<priority>5</priority>
			</li>
		</thingStyleCategories>
		<iconPath>UI/Cultures/RK_DefaultColony</iconPath>
		<iconColor>(1.0, 1.0, 1.0)</iconColor>
		<styleItemTags>
			<li>
				<tag>RK_Style</tag>
				<baseWeight>0</baseWeight>
				<weightFactor>0</weightFactor>
			</li>
			<li>
				<tag>Urban</tag>
				<baseWeight>1</baseWeight>
				<weightFactor>1</weightFactor>
			</li>
			<li>
				<tag>Rural</tag>
				<baseWeight>1</baseWeight>
				<weightFactor>1</weightFactor>
			</li>
			<li>
				<tag>NoBeard</tag>
				<baseWeight>1</baseWeight>
				<weightFactor>1</weightFactor>
			</li>
			<li>
				<tag>NoTattoo</tag>
				<baseWeight>1</baseWeight>
				<weightFactor>1</weightFactor>
			</li>
		</styleItemTags>
	</CultureDef>
	
<RulePackDef>
    <defName>OA_RK_LeaderTitleMaker</defName>
    <rulePack>
      <rulesStrings>
        <li>r_leaderTitle->殖民总长</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>
  
  
  <RulePackDef>
    <defName>OA_RK_NamerIdeo</defName>
    <include>
      <li>GlobalUtility</li>
    </include>
    <rulePack>
      <rulesStrings>
        <li>r_ideoName->金鸢尾兰文化分支</li>
		  <li>r_ideoAdjective->[keyDeity]的</li>
		  <li>r_memberName->[keyDeity]者</li>
		  <li>r_memberName->[keyDeity]信徒</li>
		  <li>r_ideoAdjective(priority=1)->[packAdjective]</li>
		  <li>r_memberName->[packMember]</li>
		  <li>creed(priority=1)->[memeCreed]</li>
		  <li>creed->[genericCreed]</li>
		  <li>genericCreed->主义</li>
		  <li>hyphenPrefix->[globalHyphenPrefix]</li>
		  <li>hyphenPrefix->[memeHyphenPrefix]</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>
</Defs>
