<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="OARatkin_RangedWeaponBase">
        <defName>OA_RK_BlitzAMLMG</defName>
        <label>Blitz Anti-Armor LMG</label>
        <!-- 突袭作战反重甲机枪 -->
        <description>One of the Oberonia Aurea Empire's anti-machine specialties, the chamber pressurizer and special uranium rounds are designed to provide an impressive level of armor-piercing effectiveness and lethality. Even at medium to long ranges, it can provide stable anti-armor fire support.</description>
        <!-- 金鸢尾兰帝国的反机械体特化武器之一，枪膛加压器与特化铀弹的设计令其穿甲效能与杀伤能力都达到了一个惊人的水平。即便是在中远距离上，也可以提供较为稳定的反甲火力支援。 -->
        <graphicData>
            <texPath>Weapons/OA_BlitzAMLMG</texPath>
        </graphicData>
        <equippedAngleOffset>45</equippedAngleOffset>
        <equippedStatOffsets>
            <MoveSpeed>-0.40</MoveSpeed>
        </equippedStatOffsets>
        <statBases>
            <WorkToMake>116000</WorkToMake>
            <Mass>14</Mass>
            <AccuracyTouch>0.38</AccuracyTouch>
            <AccuracyShort>0.47</AccuracyShort>
            <AccuracyMedium>0.51</AccuracyMedium>
            <AccuracyLong>0.44</AccuracyLong>
            <RangedWeapon_Cooldown>2.25</RangedWeapon_Cooldown>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <defaultProjectile>OA_RK_BlitzAMLMGBullet</defaultProjectile>
                <soundCast>OA_RKSO_BlitzAMRFire</soundCast>
                <soundCastTail>OA_RKSO_HeavyUraniumBulletTail</soundCastTail>
                <hasStandardCommand>true</hasStandardCommand>
                <warmupTime>1.65</warmupTime>
                <range>45</range>
                <burstShotCount>8</burstShotCount>
                <ticksBetweenBurstShots>12</ticksBetweenBurstShots>
                <muzzleFlashScale>10</muzzleFlashScale>
            </li>
        </verbs>
        <tools>
            <li>
                <label>枪管</label>
                <!-- 枪管 -->
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>8.5</power>
                <cooldownTime>2.40</cooldownTime>
                <armorPenetration>0.16</armorPenetration>
                <chanceFactor>1</chanceFactor>
            </li>
            <li>
                <label>枪托</label>
                <!-- 枪托 -->
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>11</power>
                <cooldownTime>2.80</cooldownTime>
                <armorPenetration>0.24</armorPenetration>
                <chanceFactor>1</chanceFactor>
            </li>
        </tools>
        <weaponTags>
            <li>OA_RK_Anti_Amour_Weapon</li>
        </weaponTags>
        <recipeMaker>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>Smith</effectWorking>
            <soundWorking>Recipe_Smith</soundWorking>
            <recipeUsers>
                <li>FabricationBench</li>
            </recipeUsers>
            <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
            <researchPrerequisite>OA_RK_Weapon_D</researchPrerequisite>
            <skillRequirements>
                <Crafting>15</Crafting>
            </skillRequirements>
            <displayPriority>208</displayPriority>
        </recipeMaker>
        <costList>
            <Uranium>235</Uranium>
            <ComponentIndustrial>16</ComponentIndustrial>
            <ComponentSpacer>1</ComponentSpacer>
        </costList>
    </ThingDef>
    <ThingDef ParentName="OA_RKBase_Bullet">
        <defName>OA_RK_BlitzAMLMGBullet</defName>
        <label>铀弹</label>
        <!-- 铀弹 -->
        <graphicData>
            <texPath>Bullets/OA_HeavyUraniumBullet</texPath>
        </graphicData>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>22</damageAmountBase>
            <armorPenetrationBase>0.72</armorPenetrationBase>
            <stoppingPower>3</stoppingPower>
            <speed>60</speed>
        </projectile>
    </ThingDef>

</Defs>
