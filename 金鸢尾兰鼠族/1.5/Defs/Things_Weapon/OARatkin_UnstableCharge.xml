<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<ThingDef ParentName="OARatkin_RangedChargeWeaponBase">
    <defName>OA_RK_UnstableChargeDriver</defName>
    <label>Unstable Charged Cluster Shooter</label>
    <description>The Oberonia Aurea Empire is the product of an emergency armament change after contact with the First Galaxy. Although it was an emergency product, it was somehow quite successful. At the expense of accuracy and portability, the Unstable Charged Regiment's direct-fire projectors have reached the ultimate in lethality. \n\nBecause of the unstable charge energy, the actual damage of the weapon will fluctuate between 40% and 120%. \n\n "Big is beautiful." Another Oberonia Aurea researcher concurred.</description>
    <graphicData>
        <texPath>Weapons/OA_UnstableCharge/Driver</texPath>
    </graphicData>
    <statBases>
        <WorkToMake>208000</WorkToMake>
        <Mass>19.5</Mass>
        <AccuracyTouch>1</AccuracyTouch>
        <AccuracyShort>1</AccuracyShort>
        <AccuracyMedium>1</AccuracyMedium>
        <AccuracyLong>1</AccuracyLong>
        <RangedWeapon_Cooldown>5.50</RangedWeapon_Cooldown>
    </statBases>
    <equippedAngleOffset>45</equippedAngleOffset>
    <equippedStatOffsets>
        <MoveSpeed>-0.7</MoveSpeed>
    </equippedStatOffsets>
    <verbs>
        <li>
            <verbClass>Verb_Shoot</verbClass>
            <defaultProjectile>OA_RK_UnstableChargeDriverBullet</defaultProjectile>
            <soundCast>OA_RKSO_UnstableChargeDriverFire</soundCast>
            <soundCastTail>OA_RKSO_HeavyUraniumBulletTail</soundCastTail>
            <soundAiming>OA_RKSO_UnstableChargeDriverAim</soundAiming>
            <hasStandardCommand>true</hasStandardCommand>
            <warmupTime>2.80</warmupTime>
            <range>51</range>
            <forcedMissRadius>2.9</forcedMissRadius>
            <burstShotCount>1</burstShotCount>
            <ticksBetweenBurstShots>20</ticksBetweenBurstShots>
            <muzzleFlashScale>12</muzzleFlashScale>
            <ai_AvoidFriendlyFireRadius>6</ai_AvoidFriendlyFireRadius>
            <ai_RangedAlawaysShootGroundBelowTarget>true</ai_RangedAlawaysShootGroundBelowTarget>
            <ai_ProjectileLaunchingIgnoresMeleeThreats>true</ai_ProjectileLaunchingIgnoresMeleeThreats>
            <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
            <ai_TargetHasRangedAttackScoreOffset>50</ai_TargetHasRangedAttackScoreOffset>
            <targetParams>
                <canTargetLocations>true</canTargetLocations>
                <canTargetPawns>false</canTargetPawns>
            </targetParams>
            <aimingChargeMote>OA_RKMote_UnstableChargeFire_AimingCharge</aimingChargeMote>
            <aimingChargeMoteOffset>1.07</aimingChargeMoteOffset>
            <aimingLineMoteFixedLength>1</aimingLineMoteFixedLength>
            <beamTargetsGround>true</beamTargetsGround>
            <canGoWild>false</canGoWild>
        </li>
    </verbs>
    <tools>
        <li>
            <label>枪管</label>
            <capacities>
                <li>Blunt</li>
            </capacities>
            <power>9</power>
            <cooldownTime>2.60</cooldownTime>
            <armorPenetration>0.27</armorPenetration>
            <chanceFactor>1</chanceFactor>
        </li>
        <li>
            <label>枪托</label>
            <capacities>
                <li>Blunt</li>
            </capacities>
            <power>11</power>
            <cooldownTime>2.80</cooldownTime>
            <armorPenetration>0.31</armorPenetration>
            <chanceFactor>1</chanceFactor>
        </li>
    </tools>
    <weaponTags>
        <li>OA_RK_Anti_Amour_Weapon</li>
        <li>OA_RK_Super_Weapon</li>
    </weaponTags>
	<recipeMaker>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Crafting</workSkill>
        <effectWorking>Smith</effectWorking>
        <soundWorking>Recipe_Smith</soundWorking>
        <recipeUsers>
            <li>FabricationBench</li>
        </recipeUsers>
        <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
        <researchPrerequisite>OA_RK_Weapon_F</researchPrerequisite>
        <skillRequirements>
            <Crafting>16</Crafting>
        </skillRequirements>
        <displayPriority>210</displayPriority>
    </recipeMaker>
    <costList>
		<Uranium>160</Uranium>
		<Plasteel>600</Plasteel>
		<ComponentSpacer>38</ComponentSpacer>
    </costList>
</ThingDef>
<ThingDef ParentName="OA_RKBase_ChargeBullet">
    <defName>OA_RK_UnstableChargeDriverBullet</defName>
    <label>不稳定电荷团</label>
    <graphicData>
        <texPath>Bullets/OA_UnstableChargeDriver</texPath>
    </graphicData>
    <thingClass>OberoniaAurea.AstableExplosiveBullet</thingClass>
    <projectile>
        <damageDef>OA_RKDA_ChargeDriverExplosion</damageDef>
        <soundExplode>OA_RKSO_UnstableChargeDriverExplosion</soundExplode>
        <explosionEffect>OA_RKEffect_UnstableChargeDriverExplosion</explosionEffect>
        <damageAmountBase>244</damageAmountBase>
        <armorPenetrationBase>1.48</armorPenetrationBase>
        <explosionRadius>3.36</explosionRadius >
        <stoppingPower>5</stoppingPower>
        <speed>135</speed>
    </projectile>
</ThingDef>

