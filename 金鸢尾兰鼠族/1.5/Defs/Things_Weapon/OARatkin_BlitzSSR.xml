<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<ThingDef ParentName="OARatkin_RangedWeaponBase">
    <defName>OA_RK_BlitzSSR</defName>
    <label>Blitz Combat Support Rifle</label>
    <!-- 突袭作战支援步枪 -->
    <description>The Oberonia Aurea Empire's active support rifle has a consistent kill ability at all ranges, and accuracy at mid-range that rivals sniper rifles.</description>
    <!-- 金鸢尾兰帝国的现役制式支援步枪，在全距离都有着稳定的杀伤能力，中距离的精度足以与狙击枪媲美。 -->
    <graphicData>
        <texPath>Weapons/OA_BlitzSSR</texPath>
    </graphicData>
    <statBases>
        <WorkToMake>61500</WorkToMake>
        <Mass>3.6</Mass>
        <AccuracyTouch>0.82</AccuracyTouch>
        <AccuracyShort>0.91</AccuracyShort>
        <AccuracyMedium>0.82</AccuracyMedium>
        <AccuracyLong>0.74</AccuracyLong>
        <RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
    </statBases>
    <equippedStatOffsets>
        <MoveSpeed>0.15</MoveSpeed>
    </equippedStatOffsets>
    <verbs>
        <li>
            <verbClass>Verb_Shoot</verbClass>
            <defaultProjectile>OA_RK_BlitzSSRBullet</defaultProjectile>
            <soundCast>OA_RKSO_BlitzSSRFire</soundCast>
            <soundCastTail>OA_RKSO_MediumUraniumBulletTail</soundCastTail>
            <hasStandardCommand>true</hasStandardCommand>
            <warmupTime>0.4</warmupTime>
            <range>46</range>
            <burstShotCount>1</burstShotCount>
            <ticksBetweenBurstShots>20</ticksBetweenBurstShots>
            <muzzleFlashScale>8</muzzleFlashScale>
        </li>
    </verbs>
    <tools>
        <li>
            <label>刺刀</label>
            <!-- 刺刀 -->
            <capacities>
                <li>Stab</li>
            </capacities>
            <power>18.5</power>
            <cooldownTime>1.95</cooldownTime>
            <armorPenetration>0.84</armorPenetration>
            <chanceFactor>3.8</chanceFactor>
        </li>
        <li>
            <label>枪托</label>
            <!-- 枪托 -->
            <capacities>
                <li>Blunt</li>
            </capacities>
            <power>7</power>
            <cooldownTime>2.00</cooldownTime>
            <armorPenetration>0.16</armorPenetration>
            <chanceFactor>0.8</chanceFactor>
        </li>
    </tools>
    <weaponTags>
        <li>OA_RK_Advanced_Weapon</li>
        <li>OA_RK_Advanced_Support_Weapon</li>
    </weaponTags>
	<recipeMaker>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Crafting</workSkill>
        <effectWorking>Smith</effectWorking>
        <soundWorking>Recipe_Smith</soundWorking>
        <recipeUsers>
            <li>FabricationBench</li>
        </recipeUsers>
        <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
        <researchPrerequisite>OA_RK_Weapon_C</researchPrerequisite>
        <skillRequirements>
            <Crafting>12</Crafting>
        </skillRequirements>
        <displayPriority>204</displayPriority>
    </recipeMaker>
    <costList>
		<Uranium>110</Uranium>
		<ComponentIndustrial>12</ComponentIndustrial>
    </costList>
</ThingDef>
<ThingDef ParentName="OA_RKBase_Bullet">
    <defName>OA_RK_BlitzSSRBullet</defName>
    <label>铀弹</label>
    <!-- 铀弹 -->
    <graphicData>
        <texPath>Bullets/OA_MediumUraniumBullet</texPath>
    </graphicData>
    <projectile>
        <damageDef>Bullet</damageDef>
        <damageAmountBase>15</damageAmountBase>
        <armorPenetrationBase>0.58</armorPenetrationBase>
        <stoppingPower>0.5</stoppingPower>
        <speed>80</speed>
    </projectile>
</ThingDef>
  
</Defs>
