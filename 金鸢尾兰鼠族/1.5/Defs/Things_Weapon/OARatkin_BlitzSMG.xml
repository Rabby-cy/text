            <burstShotCount>5</burstShotCount>
            <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
            <muzzleFlashScale>4</muzzleFlashScale>
        </li>
    </verbs>
    <tools>
        <li>
            <label>枪管</label>
            <!-- 枪管 -->
            <capacities>
                <li>Blunt</li>
            </capacities>
            <power>7.5</power>
            <cooldownTime>1.50</cooldownTime>
            <armorPenetration>0.16</armorPenetration>
            <chanceFactor>1</chanceFactor>
        </li>
        <li>
            <label>枪托</label>
            <!-- 枪托 -->
            <capacities>
                <li>Blunt</li>
            </capacities>
            <power>7</power>
            <cooldownTime>1.50</cooldownTime>
            <armorPenetration>0.16</armorPenetration>
            <chanceFactor>0.8</chanceFactor>
        </li>
    </tools>
    <weaponTags>
        <li>OA_RK_Advanced_Weapon_II</li>
    </weaponTags>
	<recipeMaker>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Crafting</workSkill>
        <effectWorking>Smith</effectWorking>
        <soundWorking>Recipe_Smith</soundWorking>
        <recipeUsers>
            <li>FabricationBench</li>
        </recipeUsers>
        <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
        <researchPrerequisite>OA_RK_Weapon_G</researchPrerequisite>
        <skillRequirements>
            <Crafting>13</Crafting>
        </skillRequirements>
        <displayPriority>206</displayPriority>
    </recipeMaker>
    <costList>
		<Uranium>120</Uranium>
		<ComponentIndustrial>14</ComponentIndustrial>
		<ComponentSpacer>1</ComponentSpacer>
    </costList>
</ThingDef>
