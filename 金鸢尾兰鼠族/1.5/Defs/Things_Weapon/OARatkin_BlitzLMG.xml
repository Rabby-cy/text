<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<ThingDef ParentName="OARatkin_RangedWeaponBase">
    <defName>OA_RK_BlitzLMG</defName>
    <label>Blitz Combat Support LMG</label>
    <!-- 突袭作战支援机枪 -->
    <description>The Oberonia Aurea Empire's current standard machine gun boasts outstanding light unit killing capabilities while trying to guarantee accuracy and shot stability, and performs particularly well when providing suppressive fire.</description>
    <!-- 金鸢尾兰帝国的现役制式机枪，在尽量保障精度与射击稳定的同时，还拥有着杰出的轻单位杀伤能力，在提供火力压制时表现尤为出色。 -->
    <graphicData>
        <texPath>Weapons/OA_BlitzLMG</texPath>
    </graphicData>
    <statBases>
        <WorkToMake>88000</WorkToMake>
        <Mass>7.5</Mass>
        <AccuracyTouch>0.51</AccuracyTouch>
        <AccuracyShort>0.62</AccuracyShort>
        <AccuracyMedium>0.42</AccuracyMedium>
        <AccuracyLong>0.29</AccuracyLong>
        <RangedWeapon_Cooldown>2.5</RangedWeapon_Cooldown>
    </statBases>
    <equippedAngleOffset>45</equippedAngleOffset>
    <equippedStatOffsets>
        <MoveSpeed>0.1</MoveSpeed>
    </equippedStatOffsets>
    <verbs>
        <li>
            <verbClass>Verb_Shoot</verbClass>
            <defaultProjectile>OA_RK_BlitzLMGBullet</defaultProjectile>
            <soundCast>OA_RKSO_BlitzLMGFire_C</soundCast>
            <soundCastTail>OA_RKSO_MediumUraniumBulletTail</soundCastTail>
            <hasStandardCommand>true</hasStandardCommand>
            <warmupTime>1.2</warmupTime>
            <range>37</range>
            <burstShotCount>11</burstShotCount>
            <ticksBetweenBurstShots>7</ticksBetweenBurstShots>
            <muzzleFlashScale>8</muzzleFlashScale>
        </li>
    </verbs>
    <tools>
        <li>
            <label>枪管</label>
            <!-- 枪管 -->
            <capacities>
                <li>Blunt</li>
            </capacities>
            <power>8.5</power>
            <cooldownTime>2.40</cooldownTime>
            <armorPenetration>0.16</armorPenetration>
            <chanceFactor>1</chanceFactor>
        </li>
        <li>
            <label>枪托</label>
            <!-- 枪托 -->
            <capacities>
                <li>Blunt</li>
            </capacities>
            <power>11</power>
            <cooldownTime>2.80</cooldownTime>
            <armorPenetration>0.24</armorPenetration>
            <chanceFactor>1</chanceFactor>
        </li>
    </tools>
    <weaponTags>
        <li>OA_RK_Advanced_heavy_Weapon</li>
    </weaponTags>
	<recipeMaker>
       <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Crafting</workSkill>
        <effectWorking>Smith</effectWorking>
        <soundWorking>Recipe_Smith</soundWorking>
        <recipeUsers>
            <li>FabricationBench</li>
        </recipeUsers>
        <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
        <researchPrerequisite>OA_RK_Weapon_C</researchPrerequisite>
        <skillRequirements>
            <Crafting>14</Crafting>
        </skillRequirements>
        <displayPriority>207</displayPriority>
    </recipeMaker>
    <costList>
		<Uranium>220</Uranium>
		<ComponentIndustrial>12</ComponentIndustrial>
    </costList>
</ThingDef>
<ThingDef ParentName="OA_RKBase_Bullet">
    <defName>OA_RK_BlitzLMGBullet</defName>
    <label>铀弹</label>
    <!-- 铀弹 -->
    <graphicData>
        <texPath>Bullets/OA_MediumUraniumBullet</texPath>
    </graphicData>
    <projectile>
        <damageDef>Bullet</damageDef>
        <damageAmountBase>13</damageAmountBase>
        <armorPenetrationBase>0.36</armorPenetrationBase>
        <stoppingPower>0.5</stoppingPower>
        <speed>60</speed>
    </projectile>
</ThingDef>
  
</Defs>
