<Defs>

    <!-- 金鸢尾兰工业背心  -->
    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_CourtApparelMakeableBase">
        <defName>OA_RK_New_Sandwich_A</defName>
        <label>Oberonia Aurea Industrial Vest</label>
        <description>The standard work uniform adopted by the Ministry of Industry of the Oberonia Aurea Palace has weak protective properties and can carry many light tools for easy use during construction.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Sandwich_A</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <techLevel>Spacer</techLevel>
        <statBases>
            <MaxHitPoints>220</MaxHitPoints>
            <WorkToMake>29900</WorkToMake>
            <Mass>1.0</Mass>
            <ArmorRating_Sharp>0.34</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.34</ArmorRating_Blunt>
            <ArmorRating_Heat>0.50</ArmorRating_Heat>
            <Insulation_Cold>7.5</Insulation_Cold>
            <Insulation_Heat>6.0</Insulation_Heat>
            <EquipDelay>3</EquipDelay>
        </statBases>
        <costList>
            <Synthread>75</Synthread>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>
        <equippedStatOffsets>
            <CarryingCapacity>20</CarryingCapacity>
            <WorkSpeedGlobal>0.08</WorkSpeedGlobal>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
            </bodyPartGroups>
            <wornGraphicPath>Apparel/OA_RK_New_Sandwich_A</wornGraphicPath>
            <layers>
                <li>Middle</li>
            </layers>
            <tags>
                <li>OARatkin_IndustrialApparel</li>
            </tags>
        </apparel>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
            <researchPrerequisite>OA_RK_Apparel_E</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

