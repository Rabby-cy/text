<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- 金鸢尾兰自清洁服 -->
    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_CourtApparelMakeableBase">
        <defName>OA_RK_Professional_Uniforms_A</defName>
        <label>Oberonia Aurea self-cleaning dress</label>
        <description>Made of advanced self-cleaning fabrics, the dress is effective in keeping surfaces clean, while the upper vest adds a touch of vibrancy to itself, and most of Oberonia Aurea's researchers enjoy wearing them.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_Professional_Uniforms_A</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <MaxHitPoints>175</MaxHitPoints>
            <WorkToMake>21200</WorkToMake>
            <Mass>1.2</Mass>
            <Insulation_Cold>15.5</Insulation_Cold>
            <Insulation_Heat>13</Insulation_Heat>
            <ArmorRating_Sharp>0.34</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.26</ArmorRating_Blunt>
            <ArmorRating_Heat>0.75</ArmorRating_Heat>
            <Flammability>0.25</Flammability>
            <EquipDelay>4.0</EquipDelay>
        </statBases>
        <costList>
            <Synthread>105</Synthread>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <equippedStatOffsets>
            <ResearchSpeed>0.20</ResearchSpeed>
            <MedicalSurgerySuccessChance>0.10</MedicalSurgerySuccessChance>
            <SocialImpact>0.05</SocialImpact>
            <FoodPoisonChance>-0.25</FoodPoisonChance>
            <ImmunityGainSpeed>0.05</ImmunityGainSpeed>
        </equippedStatOffsets>
        <apparel>
            <wornGraphicPath>Apparel/OA_RK_Professional_Uniforms_A</wornGraphicPath>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
                <li>Neck</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>OARatkin_ProfessionalUniform</li>
            </tags>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>OA_RK_Apparel_B</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <!-- 金鸢尾兰祭服 -->
