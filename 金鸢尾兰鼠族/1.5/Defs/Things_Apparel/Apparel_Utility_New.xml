<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- EMP冲击腰带  -->
    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_UtilityMakeableBase">
        <defName>OA_RK_New_Belt_A</defName>
        <label>EMP impact waistband</label>
        <description>The technical department of the Oberonia Aurea developed a belt that can release EMP impact to counter the mechanical clan, but unfortunately, its practical effectiveness is not high, so it was not standardized for installation. \n\nWhen wearing, you can target yourself and release an EMP impact within a radius of 11 squares.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Belt_A</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <tickerType>Normal</tickerType>
        <techLevel>Spacer</techLevel>
        <statBases>
            <Mass>0.3</Mass>
            <WorkToMake>26500</WorkToMake>
            <EquipDelay>1.5</EquipDelay>
            <MaxHitPoints>250</MaxHitPoints>
        </statBases>
        <comps>
            <li Class="CompProperties_ApparelReloadable">
                <maxCharges>1</maxCharges>
                <ammoDef>ComponentSpacer</ammoDef>
                <ammoCountPerCharge>1</ammoCountPerCharge>
                <baseReloadTicks>120</baseReloadTicks>
                <soundReload>Standard_Reload</soundReload>
                <hotKey>Misc4</hotKey>
                <chargeNoun>高级零部件</chargeNoun>
                <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
            </li>
        </comps>
        <verbs>
            <li>
                <verbClass>Verb_LaunchProjectileStatic</verbClass>
                <label>release EMP impact</label>
                <hasStandardCommand>true</hasStandardCommand>
                <onlyManualCast>True</onlyManualCast>
                <range>1</range>
                <forcedMissRadius>0.1</forcedMissRadius>
                <warmupTime>0.25</warmupTime>
                <noiseRadius>4</noiseRadius>
                <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
                <soundCast>OA_RKSO_AdvancedBlitzSMGFire</soundCast>
                <soundCastTail>OA_RKSO_LightUraniumBulletTail</soundCastTail>
                <muzzleFlashScale>18</muzzleFlashScale>
                <drawHighlightWithLineOfSight>true</drawHighlightWithLineOfSight>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
                <defaultProjectile>OA_RK_EMP_Belt_A</defaultProjectile>
                <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
            </li>
        </verbs>
        <costList>
            <Plasteel>15</Plasteel>
            <ComponentIndustrial>5</ComponentIndustrial>
            <Uranium>35</Uranium>
            <ComponentSpacer>1</ComponentSpacer>
        </costList>
        <apparel>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <wearPerDay>0.14</wearPerDay>
            <tags>
                <li>OARatkin_TechnicalBelt</li>
            </tags>
        </apparel>
        <recipeMaker>
            <useIngredientsForColor>false</useIngredientsForColor>
            <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
            <researchPrerequisite>OA_RK_Apparel_E</researchPrerequisite>
        </recipeMaker>
    </ThingDef>
    <!-- EMP冲击  -->
    <ThingDef>
        <defName>OA_RK_EMP_Belt_A</defName>
        <label>EMP Shock</label>
        <thingClass>Projectile_Explosive</thingClass>
        <category>Projectile</category>
        <tickerType>Normal</tickerType>
        <altitudeLayer>Projectile</altitudeLayer>
        <useHitPoints>False</useHitPoints>
        <neverMultiSelect>True</neverMultiSelect>
        <graphicData>
            <texPath>Ui/OA_RK_EMP_Jineng</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1</drawSize>
        </graphicData>
        <projectile>
            <damageDef>EMP</damageDef>
            <explosionRadius>10.9</explosionRadius>
            <speed>999</speed>
            <damageAmountBase>32</damageAmountBase>
            <arcHeightFactor>0.34</arcHeightFactor>
            <soundExplode>Explosion_Rocket</soundExplode>
        </projectile>
    </ThingDef>

    <!-- 金鸢尾兰信号腰带  -->
