    <!-- 学习辅助设施  -->
    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_UtilityMakeableBase">
        <defName>OA_RK_New_Component_B</defName>
        <label>Learning assistance facilities</label>
        <description>The Oberonia Aurea Palace uses a learning device with built-in complex AI that can accurately point out work errors and inform wearers of the correct approach, thereby assisting new attendants in quickly adapting to the work environment,.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Component_B</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <tickerType>Normal</tickerType>
        <techLevel>Spacer</techLevel>
        <statBases>
            <Mass>0.25</Mass>
            <WorkToMake>20800</WorkToMake>
            <EquipDelay>2.0</EquipDelay>
            <MaxHitPoints>250</MaxHitPoints>
        </statBases>
        <equippedStatOffsets>
            <GlobalLearningFactor>0.40</GlobalLearningFactor>
        </equippedStatOffsets>
        <costList>
            <Steel>30</Steel>
            <ComponentIndustrial>6</ComponentIndustrial>
            <Uranium>20</Uranium>
        </costList>
        <apparel>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <wearPerDay>0.14</wearPerDay>
            <tags>
                <li>OARatkin_Belt</li>
            </tags>
        </apparel>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
            <researchPrerequisite>OA_RK_Apparel_B</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <!-- 金鸢尾兰远行者紧急呼叫设备  -->
    <ThingDef ParentName="OrbitalUtilityBase">
        <defName>OA_RK_New_Component_C</defName>
        <label>Oberonia Aurea Far Walker Emergency Call Equipment</label>
        <description>The rescue equipment developed by the Oberonia Aurea Empire for distant travelers can summon a standby raid team from their current location to rescue them in case of danger.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Component_C</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <generateCommonality>0</generateCommonality>
        <generateAllowChance>0</generateAllowChance>
        <statBases>
            <MarketValue>400</MarketValue>
        </statBases>
        <apparel>
            <bodyPartGroups>
                <li>Waist</li>
            </bodyPartGroups>
            <layers>
                <li>Belt</li>
            </layers>
            <tags>
                <li>OARatkin_Belt</li>
            </tags>
            <ai_pickUpOpportunistically>true</ai_pickUpOpportunistically>
        </apparel>
        <verbs>
            <li>
                <verbClass>OberoniaAurea.Verb_TargetCellAid</verbClass>
                <label>emergency call</label>
                <hasStandardCommand>true</hasStandardCommand>
                <warmupTime>5.0</warmupTime>
                <ai_AvoidFriendlyFireRadius>15</ai_AvoidFriendlyFireRadius>
                <range>9.9</range>
                <burstShotCount>1</burstShotCount>
                <soundAiming>OrbitalTargeter_Aiming</soundAiming>
                <soundCast>OrbitalTargeter_Fire</soundCast>
                <onlyManualCast>true</onlyManualCast>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
            </li>
        </verbs>
        <comps>
            <li Class="CompProperties_ApparelReloadable">
                <maxCharges>1</maxCharges>
                <destroyOnEmpty>true</destroyOnEmpty>
                <hotKey>Misc4</hotKey>
                <chargeNoun>charge</chargeNoun>
                <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
            </li>
        </comps>
        <tradeTags>
            <li>Clothing</li>
        </tradeTags>
    </ThingDef>

    <!-- 旋翼飞行托盘  -->
    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_UtilityMakeableBase">
        <defName>OA_RK_New_Component_D</defName>
        <label>Rotor flight tray</label>
        <description>A foldable transport aircraft developed by the technical department of the Oberonia Aurea for the convenience of moving objects, with a built-in voice controlled AI that can stably accompany and fly around. \n\nEven though the technical department repeatedly prohibits it, there are still occasional attendants sitting on pallets to experience ground clearance.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Component_D</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1.5</drawSize>
        </graphicData>
        <tickerType>Normal</tickerType>
        <techLevel>Spacer</techLevel>
        <statBases>
            <Mass>4.0</Mass>
            <WorkToMake>24000</WorkToMake>
            <EquipDelay>3.0</EquipDelay>
            <MaxHitPoints>400</MaxHitPoints>
        </statBases>
        <equippedStatOffsets>
            <CarryingCapacity>75</CarryingCapacity>
        </equippedStatOffsets>
        <costList>
            <Steel>65</Steel>
            <ComponentIndustrial>7</ComponentIndustrial>
            <Uranium>10</Uranium>
        </costList>
        <apparel>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <wearPerDay>0.14</wearPerDay>
            <tags>
                <li>OARatkin_Belt</li>
            </tags>
        </apparel>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
            <researchPrerequisite>OA_RK_Apparel_E</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

</Defs>