    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_CommonApparelMakeableBase">
        <defName>OA_RK_Apparel_A</defName>
        <label>Oberonia Aurea one-piece dress</label>
        <description>One of the common Oberonia Aurea everyday dresses. Its thick shawl is effective against the cold, and the iris sash bow tied around the waistband adds a touch of elegance to this already aesthetically pleasing outfit.</description>
