            <texPath>Apparel/OA_RK_Apparel_A</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>12200</WorkToMake>
            <Mass>1.2</Mass>
            <StuffEffectMultiplierArmor>0.21</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.50</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.38</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3.5</EquipDelay>
        </statBases>
        <costList>
            <Synthread>45</Synthread>
        </costList>
        <costStuffCount>50</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <equippedStatOffsets>
            <GeneralLaborSpeed>0.10</GeneralLaborSpeed>
            <SocialImpact>0.15</SocialImpact>
        </equippedStatOffsets>
        <apparel>
            <wornGraphicPath>Apparel/OA_RK_Apparel_A</wornGraphicPath>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
                <li>Neck</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>OARatkin_CourtApparel</li>
            </tags>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>OA_RK_Apparel_A</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

