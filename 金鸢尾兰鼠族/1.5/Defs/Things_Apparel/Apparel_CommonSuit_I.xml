                <li>Torso</li>
            </bodyPartGroups>
            <wornGraphicPath>Apparel/OA_RK_Sandwich_A</wornGraphicPath>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <layers>
                <li>Middle</li>
            </layers>
            <tags>
                <li>OARatkin_IndustrialApparel</li>
                <li>OARatkin_TechnicalApparel</li>
                <li>OARatkin_CourtApparel</li>
