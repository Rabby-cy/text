        <label>Oberonia Aurea Technical Uniform</label>
        <description>The standard uniform adopted by the technical department of the Oberonia Aurea Palace has a thick skirt pressure that provides certain protection and thermal insulation performance. The technical tools on the belt can provide certain support for technical work.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Professional_Uniforms_B</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>26800</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>1.5</Mass>
            <ArmorRating_Heat>0.60</ArmorRating_Heat>
            <ArmorRating_Blunt>0.42</ArmorRating_Blunt>
            <StuffEffectMultiplierArmor>0.36</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.65</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.40</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3.0</EquipDelay>
        </statBases>
        <costList>
            <Synthread>65</Synthread>
