<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- 金鸢尾兰工业制服  -->
    <ThingDef Class="NewRatkin.CustomThingDef" ParentName="OARatkin_CourtApparelMakeableBase">
        <defName>OA_RK_New_Professional_Uniforms_A</defName>
        <label>Oberonia Aurea Industrial Uniform</label>
        <description>The standard uniform used by the Ministry of Industry of the Oberonia Aurea Palace, along with safety belts, can effectively prevent the risk of falling during construction operations. Regular communication devices and toolkits can slightly improve work efficiency.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Professional_Uniforms_A</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>26000</WorkToMake>
            <MaxHitPoints>240</MaxHitPoints>
            <Mass>1.5</Mass>
            <ArmorRating_Blunt>0.36</ArmorRating_Blunt>
            <StuffEffectMultiplierArmor>0.42</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.45</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.50</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3.0</EquipDelay>
        </statBases>
        <costList>
            <Synthread>60</Synthread>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <costStuffCount>60</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <equippedStatOffsets>
            <ConstructionSpeed>0.25</ConstructionSpeed>
            <GeneralLaborSpeed>0.08</GeneralLaborSpeed>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
                <li>Neck</li>
                <li>Arms</li>
                <li>Legs</li>
                <li>Feet</li>
            </bodyPartGroups>
            <wornGraphicPath>Apparel/OA_RK_New_Professional_Uniforms_A</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>OARatkin_IndustrialApparel</li>
            </tags>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>OA_RK_Apparel_E</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

