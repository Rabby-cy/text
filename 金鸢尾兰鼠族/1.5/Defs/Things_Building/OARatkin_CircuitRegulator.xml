<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BuildingBase"><!--很好，某个策划看不懂一点这个的代码（），于是没有对应的翻译--><!--稳定度损失：基础2000W每小时损失0.5%，超过10000W损失度乘以200%，超过20000W损失度乘以500%，超过30000W损失度乘以2000%-->
        <defName>OA_RK_CircuitRegulator</defName>
        <label>Oberonia Aurea Circuit Control Cabinet</label>
        <description>The Oberonia Aurea Empire has specially developed an automatic circuit control cabinet to ensure the stability of the power grid. When the circuit stability of the cabinet is high, there will be no short circuit accidents caused by non precipitation. \n\nThe stability of the circuit will slowly decrease, and the rate of decrease is related to the power load of the cabinet. All cabinets in the same power grid will share the load power equally. When the load power of a single cabinet exceeds 20000W, the stability loss will be significantly exacerbated.\nThe maintenance speed of the cabinet is affected by the building speed.</description>
        <graphicData>
            <texPath>Building/OA_RK_CircuitRegulator</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(1.9,1.7)</drawSize>
        </graphicData>
        <size>(2,1)</size>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.35</staticSunShadowHeight>
        <altitudeLayer>Building</altitudeLayer>
        <thingCategories>
            <li>BuildingsPower</li>
        </thingCategories>
        <statBases>
            <Mass>15.0</Mass>
            <MaxHitPoints>250</MaxHitPoints>
            <WorkToBuild>9000</WorkToBuild>
        </statBases>
        <pathCost>50</pathCost>
        <fillPercent>1.0</fillPercent>
        <blockWind>False</blockWind>
        <canOverlapZones>false</canOverlapZones>
        <tickerType>Rare</tickerType>
        <minifiedDef>MinifiedThing</minifiedDef>
        <passability>PassThroughOnly</passability>
        <designationCategory>Power</designationCategory>
        <costList>
            <Steel>80</Steel>
			<Uranium>15</Uranium>
			<ComponentIndustrial>3</ComponentIndustrial>
        </costList>
	<researchPrerequisites>
      <li>OA_RK_Constant_Temperature_Hydroponics</li>
    </researchPrerequisites>
        <building>
            <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
        </building>
        <comps>
            <li Class="OberoniaAurea.CompProperties_CircuitRegulator">
                <basePowerConsumption>0</basePowerConsumption>
                <transmitsPower>True</transmitsPower>
            </li>
            <li Class="CompProperties_Flickable" />
        </comps>
		 <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    </ThingDef>

    <JobDef>
        <defName>OA_RK_RepairCircuitRegulator</defName>
        <driverClass>OberoniaAurea.JobDriver_CircuitRegulator</driverClass>
        <reportString>维护中。</reportString>
        <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
    </JobDef>

    <WorkGiverDef>
        <defName>OA_RK_RepairCircuitRegulator</defName>
        <label>维护电路调控器</label>
        <giverClass>OberoniaAurea.WorkGiver_CircuitRegulator</giverClass>
        <workType>Construction</workType>
        <verb>维护</verb>
        <gerund>维护于</gerund>
        <priorityInType>100</priorityInType>
        <requiredCapacities>
            <li>Manipulation</li>
        </requiredCapacities>
        <canBeDoneByMechs>false</canBeDoneByMechs>
    </WorkGiverDef>

</Defs>