<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>OA_RK_EMP</defName>
    <label>EMP generator</label>
    <tickerType>Normal</tickerType>
    <description>A defense facility developed by the Oberonia Aurea Empire after reckonings on military development of other galactical entities. When activated, it causes a single indiscriminate EMP blast over a wide area.</description>
    <graphicData>
      <texPath>Building/OA_RK_EMP_A</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shadowData>
        <volume>(0.3, 0.2, 0.3)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <drawSize>(2.75,2.8)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>5</Mass>
    </statBases>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <fillPercent>0.4</fillPercent>
    <costList>
      <Steel>180</Steel>
      <Plasteel>90</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <size>(2,2)</size>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1400</basePowerConsumption>
        <idlePowerDraw>40</idlePowerDraw>
      </li>
      <li Class="OberoniaAurea.CompProperties_ChargedExplosion">
        <chargeTicks>6000</chargeTicks>
        <explosiveRadius>37.9</explosiveRadius>
        <explosiveDamageType>EMP</explosiveDamageType>
        <requiredDamageTypeToExplode>OA_RK_ExtraStun</requiredDamageTypeToExplode> <!-- 用于次生爆炸 -->
        <startWickHitPointsPercent>-1</startWickHitPointsPercent>
        <explosionSound>Explosion_EMP</explosionSound>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>2</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>true</drawOutOfFuelOverlay>
        <drawFuelGaugeInMap>false</drawFuelGaugeInMap>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <fuelLabel>高级零部件</fuelLabel>
        <fuelGizmoLabel>高级零部件</fuelGizmoLabel>
        <outOfFuelMessage>零部件不足</outOfFuelMessage>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(204,148,74,0)</glowColor>
        <colorPickerEnabled>true</colorPickerEnabled>
        <darklightToggle>true</darklightToggle>
      </li>
    </comps>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <pathCost>14</pathCost>
    <designationCategory>Security</designationCategory>
    <rotatable>false</rotatable>
    <researchPrerequisites>
      <li>OA_RK_EMP_Building</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>OA_RK_EMPInst</defName>
    <label>Single-use EMP generator</label>
    <tickerType>Normal</tickerType>
    <description>An EMP generator that has been airdropped. It was attached with a self-destruct device to prevent being reverse engineered.</description>
