    <rotatable>false</rotatable>
  </ThingDef>

  <TerrainDef ParentName="FloorBase">
    <defName>OA_RK_Floor</defName>
    <label>Oberonia Aurea self-cleaning carpet</label>
    <renderPrecedence>200</renderPrecedence>
    <description>Carpets knitted with Oberonia Aurea's signature self-cleaning fabric. Oberonia Aurea's special embroidery process makes them more aesthetically pleasing than normal carpets and easier to clean and maintain.</description>
    <texturePath>Building/OA_RK_Floor</texturePath>
    <color>(0.67, 0.67, 0.67)</color>
    <pollutionTintColor>(0.95, 0.95, 0.93, 1)</pollutionTintColor>
    <isPaintable>true</isPaintable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <statBases>
      <WorkToBuild>3800</WorkToBuild>
      <Cleanliness>1.0</Cleanliness>
      <CleaningTimeFactor>0.66</CleaningTimeFactor>
      <Beauty>8</Beauty>
    </statBases>
    <costList>
      <Synthread>18</Synthread>
      <Silver>15</Silver>
    </costList>
    <tags>
      <li>Floor</li>
      <li>FineFloor</li>
    </tags>
    <constructEffect>ConstructMetal</constructEffect>
    <designationHotKey>Misc4</designationHotKey>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>OA_RK_Basic_Building</li>
    </researchPrerequisites>
    <uiOrder>2115</uiOrder>
  </TerrainDef>

  <ThingDef ParentName="BuildingBase">
    <defName>OA_RK_Constant_Temperature_Hydroponics</defName>
    <label>Oberonia Aurea thermostatic hydroponic tank</label>
    <description>Developed based on Oberonia Aurea thermostat, this thermostatic hydroponic tank is able to slowly heat up the greenhouse. Comparing with the conventional hydroponic tank, it has more favorable soil fertility and is beautifully decorated.</description>
    <thingClass>Building_PlantGrower</thingClass>
    <graphicData>
      <texPath>Building/OA_RK_Constant_Temperature_Hydroponics</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.55,2.9)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <uiIconScale>1.25</uiIconScale>
    <castEdgeShadows>true</castEdgeShadows>
    <altitudeLayer>LowPlant</altitudeLayer>
    <defaultPlacingRot>East</defaultPlacingRot>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <constructEffect>ConstructMetal</constructEffect>
    <fillPercent>0.40</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <statBases>
      <WorkToBuild>10800</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Beauty>24</Beauty>
    </statBases>
    <size>(3,2)</size>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <fertility>3.40</fertility>
    <placeWorkers>
      <li>PlaceWorker_Heater</li>
    </placeWorkers>
    <building>
      <defaultPlantToGrow>Plant_Rice</defaultPlantToGrow>
      <sowTag>Hydroponic</sowTag>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
    </building>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>6</heatPerSecond>
        <heatPushMaxTemperature>26</heatPushMaxTemperature>
      </li>
    </comps>
    <researchPrerequisites>
      <li>OA_RK_Constant_Temperature_Hydroponics</li>
    </researchPrerequisites>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Production</designationCategory>
  </ThingDef>

