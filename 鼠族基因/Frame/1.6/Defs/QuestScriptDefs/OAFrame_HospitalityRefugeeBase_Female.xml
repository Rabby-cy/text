<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <QuestScriptDef Name="OAFrame_HospitalityRefugeeBase_Female" Abstract="True">
        <rootMinPoints>0</rootMinPoints>
        <isRootSpecial>true</isRootSpecial>
        <affectedByPoints>false</affectedByPoints>
        <defaultCharity>true</defaultCharity>
        <successHistoryEvent MayRequire="Ludeon.RimWorld.Ideology">CharityFulfilled_HospitalityRefugees</successHistoryEvent>
        <failedOrExpiredHistoryEvent MayRequire="Ludeon.RimWorld.Ideology">CharityRefused_HospitalityRefugees</failedOrExpiredHistoryEvent>
        <questNameRules>
            <rulesStrings>
                <li>athe->一位</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>

                <li>questDescription(uniqueQuestDesc!=True)->[approachInfo][claimInfo][asker_nameDef]请求你允许在[map_definite]待上 [questDurationTicks_duration]来让[lodgersPronoun]能够重整旗鼓。\n\n作为回报， [lodgersPronoun][offer] 在此期间内免费为你工作和战斗。\n\n[joinInfo] [futureRewardInfo]\n\n[playerBetrayInfo]</li>

                <li>offer(lodgerCount==1)->提议</li>
                <li>offer(lodgerCount>=2)->提议</li>

                <li>lodgersPronoun(lodgerCount==1)->[asker_pronoun]</li>
                <li>lodgersPronoun(lodgerCount>=2)->她们</li>

                <li>lodgersPreposition(lodgerCount==1)->[asker_objective]自己</li>
                <li>lodgersPreposition(lodgerCount>=2)->她们自己</li>

                <li>lodgersObjective(lodgerCount==1)->[asker_objective]</li>
                <li>lodgersObjective(lodgerCount>=2)->她们</li>

                <li>lodgersPossessive(lodgerCount==1)->[asker_possessive]</li>
                <li>lodgersPossessive(lodgerCount>=2)->她们的</li>

                <li>lodgersSingularOrPluralDef(lodgerCount==1)->[asker_nameDef]</li>
                <li>lodgersSingularOrPluralDef(lodgerCount>=2)->[lodgersLabelPlural]</li>

                <li>travelerInfo(lodgerCount==1)->这名[faction_pawnSingular]</li>
                <li>travelerInfo(lodgerCount>=2)->这些[faction_pawnsPlural]</li>

                <li>joinInfo(allowJoinOffer!=True)-></li>
                <li>joinInfo(allowJoinOffer==True,lodgerCount==1)->如果你能让[asker_objective]开心，[asker_pronoun]可能会提议加入你。</li>
                <li>joinInfo(allowJoinOffer==True,lodgerCount>=2)->如果你能让她们开心，她们中的一部分可能会提议加入你。</li>

                <li>futureRewardInfo(allowFutureReward!=True)-></li>
                <li>futureRewardInfo(allowFutureReward==True)->[lodgersPronoun]可能会在过后酬谢你对[lodgersObjective]的帮助。</li>

                <li>playerBetrayInfo(isMainFaction!=True)->[travelerInfo]不属于任何主要派系。 如果你愿意，你可以选择杀害、逮捕、出售或者采割[lodgersObjective]，并且不会产生任何外交后果。</li>
                <li>playerBetrayInfo(isMainFaction==True)->[travelerInfo]属于[asker_factionName]。 如果你选择杀害、逮捕、出售或者采割[lodgersObjective]，将产生十分严重的外交后果。</li>

            </rulesStrings>
        </questDescriptionRules>

        <questContentRules>
            <rulesStrings>

                <li>lastOrNot(lodgerCount==1)-></li>
                <li>lastOrNot(lodgerCount>=2)->最后的</li>

                <li>lodgersPronoun(lodgerCount==1)->[asker_pronoun]</li>
                <li>lodgersPronoun(lodgerCount>=2)->她们</li>

                <li>lodgersPossessive(lodgerCount==1)->[asker_possessive]</li>
                <li>lodgersPossessive(lodgerCount>=2)->她们的</li>

                <li>lodgersLabelSingularOrPlural(lodgerCount==1)->[lodgersLabel]</li>
                <li>lodgersLabelSingularOrPlural(lodgerCount>=2)->[lodgersLabelPlural]</li>
                <li>lodgersArriveLetterLabel->[lodgersLabelSingularOrPlural] 抵达</li>
                <li>lodgersArriveLetterText->[lodgersSingularOrPluralDef] [hasHave] 抵达。 [lodgersPronoun]将会和你共处[questDurationTicks_duration]来重整旗鼓。</li>

                <li>hasHave(lodgerCount==1)->已经</li>
                <li>hasHave(lodgerCount>=2)->已经</li>

                <li>appalledButNoAction->The {PAWNSALIVECOUNT_multiple ? 其她人似乎 : 最后的 [lodgersLabel]} 对此感到震惊，但是并不会对你采取行动。</li>
                <li>othersWillNotAccept->The {PAWNSALIVECOUNT_multiple ? 其她人 : 最后的 [lodgersLabel]} 不乐意接受</li>
                <li>turnedViolent->[othersWillNotAccept]， 并且对你十分生气。</li>
                <li>decidedToLeave->[othersWillNotAccept]， 并且决定离开。</li>
                <li>whoAskedToStay->请求与你共处的人</li>
                <li>oneOfThe->其中一个绝望的 [whoAskedToStay]</li>
                <li>questOver->任务 '[resolvedQuestName]' 已经结束。</li>

                <li>letterIntroDeath->{SUBJECT_definite}， [oneOfThe] 已经死亡。</li>
                <li>lodgerDiedMemoryThoughtLetterLabel->[lodgersLabel] 死亡：愤怒</li>
                <li>lodgerDiedMemoryThoughtLetterText->[letterIntroDeath]\n\n[appalledButNoAction]</li>
                <li>lodgerDiedAttackPlayerLetterLabel->[lodgersLabel] 死亡：复仇</li>
                <li>lodgerDiedAttackPlayerLetterText->[letterIntroDeath]\n\n[turnedViolent]</li>
                <li>lodgerDiedLeaveMapLetterLabel->[lodgersLabel] 死亡：离开</li>
                <li>lodgerDiedLeaveMapLetterText->[letterIntroDeath]\n\n[decidedToLeave]</li>
                <li>lodgersAllDiedLetterLabel->任务失败</li>
                <li>lodgersAllDiedLetterText->{SUBJECT_definite}， [lastOrNot] 绝望的 [faction_pawnSingular] （[whoAskedToStay]）， 已经死亡。\n\n[questOver]</li>

                <li>letterIntroArrested->你逮捕了 {SUBJECT_definite} （[oneOfThe]）。</li>
                <li>lodgerArrestedMemoryThoughtLetterLabel->[lodgersLabel] 逮捕：愤怒</li>
                <li>lodgerArrestedMemoryThoughtLetterText->[letterIntroArrested]\n\n[appalledButNoAction]</li>
                <li>lodgerArrestedAttackPlayerLetterLabel->[lodgersLabel] 逮捕：复仇</li>
                <li>lodgerArrestedAttackPlayerLetterText->[letterIntroArrested]\n\n[turnedViolent]</li>
                <li>lodgerArrestedLeaveMapLetterLabel->[lodgersLabel] 逮捕：离开</li>
                <li>lodgerArrestedLeaveMapLetterText->[letterIntroArrested]\n\n[decidedToLeave]</li>
                <li>lodgersAllArrestedLetterLabel->任务失败</li>
                <li>lodgersAllArrestedLetterText->你逮捕了 {SUBJECT_definite}, [lastOrNot] 绝望的 [faction_pawnSingular] （[whoAskedToStay]）。\n\n[questOver]</li>

                <li>letterIntroLeftBehind->[oneOfThe]，{SUBJECT_definite}，被丢下了。</li>
                <li>lodgerLeftBehindMemoryThoughtLetterLabel->[lodgersLabel]被丢下：愤怒</li>
                <li>lodgerLeftBehindMemoryThoughtLetterText->[letterIntroLeftBehind]\n\n[appalledButNoAction]</li>
                <li>lodgerLeftBehindLeaveMapLetterLabel->[lodgersLabel]被丢下: 离开</li>
                <li>lodgerLeftBehindLeaveMapLetterText->[letterIntroLeftBehind]\n\n[decidedToLeave]</li>

                <li>letterIntroViolated->{SUBJECT_definite}， （[oneOfThe]）， 被执行了非法的手术。</li>
                <li>lodgerViolatedMemoryThoughtLetterLabel->[lodgersLabel] 违约：愤怒</li>
                <li>lodgerViolatedMemoryThoughtLetterText->[letterIntroViolated]\n\n[appalledButNoAction]</li>
                <li>lodgerViolatedAttackPlayerLetterLabel->[lodgersLabel] 违约：复仇</li>
                <li>lodgerViolatedAttackPlayerLetterText->[letterIntroViolated]\n\n[turnedViolent]</li>
                <li>lodgerViolatedLeaveMapLetterLabel->[lodgersLabel] 违约：离开</li>
                <li>lodgerViolatedLeaveMapLetterText->[letterIntroViolated]\n\n[decidedToLeave]</li>

                <li>letterIntroPsychicRitualTarget->{SUBJECT_definite}, [oneOfThe],成为了灵能仪式的祭品。</li>
                <li>lodgerPsychicRitualTargetMemoryThoughtLetterLabel->[lodgersLabel]违约：愤怒</li>
                <li>lodgerPsychicRitualTargetMemoryThoughtLetterText->[letterIntroPsychicRitualTarget]\n\n[appalledButNoAction]</li>
                <li>lodgerPsychicRitualTargetAttackPlayerLetterLabel->[lodgersLabel] 违约: 复仇</li>
                <li>lodgerPsychicRitualTargetAttackPlayerLetterText->[letterIntroPsychicRitualTarget]\n\n[turnedViolent]</li>
                <li>lodgerPsychicRitualTargetLeaveMapLetterLabel->[lodgersLabel] 违约：离开</li>
                <li>lodgerPsychicRitualTargetLeaveMapLetterText->[letterIntroPsychicRitualTarget]\n\n[decidedToLeave]</li>
                <li>lodgerViolatedLeaveMapLetterText->[letterIntroViolated]\n\n[decidedToLeave]</li>

                <li>mutinyLetterLabel->背叛</li>
                <li>mutinyLetterText->[lodgersSingularOrPluralDef] （[whoAskedToStay]） 与你为敌！\n\n看起来[lodgersPronoun]早就计划好了这场背叛。</li>

                <li>areIs(lodgerCount==1)->正</li>
                <li>areIs(lodgerCount>=2)->正</li>
                <li>lodgersLeavingLetterLabel->[lodgersLabelSingularOrPlural] 离开</li>
                <li>lodgersLeavingLetterText(uniqueLeavingLetter!=True)->[asker_nameDef]感谢你允许[lodgersLabelSingularOrPlural]在[questDurationTicks_duration]里待在[map_definite]。 [lodgersPronoun]现在正与[lodgersPossessive]的伙伴们一同前进。\n\n[asker_nameDef]说[lodgersPronoun]永远不会忘记你做的这些事。</li>
            </rulesStrings>
        </questContentRules>
    </QuestScriptDef>

</Defs>