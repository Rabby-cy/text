<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Human"]/comps/li[@Class="OberoniaAurea_Frame.CompProperties_PawnPreApplyDamage"]</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="Human"]/comps</xpath>
            <value>
                <li Class="OberoniaAurea_Frame.CompProperties_PawnPreApplyDamage" />
            </value>
        </nomatch>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Humanoid Alien Races</li>
            <li>Humanoid Alien Races ~ Dev</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationConditional">
                    <xpath>Defs/AlienRace.ThingDef_AlienRace[race/intelligence="Humanlike"]/comps</xpath>
                    <match Class="PatchOperationConditional">
                        <xpath>Defs/AlienRace.ThingDef_AlienRace[race/intelligence="Humanlike"]/comps/li[@Class="OberoniaAurea_Frame.CompProperties_PawnPreApplyDamage"]</xpath>
                        <nomatch Class="PatchOperationAdd">
                            <xpath>Defs/AlienRace.ThingDef_AlienRace[race/intelligence="Humanlike"]/comps</xpath>
                            <value>
                                <li Class="OberoniaAurea_Frame.CompProperties_PawnPreApplyDamage" />
                            </value>
                        </nomatch>
                    </match>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>Defs/AlienRace.ThingDef_AlienRace[race/intelligence="Humanlike"]</xpath>
                        <value>
                            <comps>
                                <li Class="OberoniaAurea_Frame.CompProperties_PawnPreApplyDamage" />
                            </comps>
                        </value>
                    </nomatch>
                </li>
            </operations>
        </match>
    </Operation>

</Patch>