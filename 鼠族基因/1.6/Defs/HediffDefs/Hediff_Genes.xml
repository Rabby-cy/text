<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef Name="OAHediff_GeneGiveBase" Abstract="true">
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <duplicationAllowed>false</duplicationAllowed>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    </HediffDef>

    <HediffDef ParentName="OAHediff_GeneGiveBase">
        <defName>OAGene_EfficientNeuron</defName>
        <label>Efficient nervous system</label>
        <description>Carriers of this gene have an abnormally developed nervous system, which makes their thinking speed much faster than that of ordinary people, but such a developed nervous system can also have a certain impact on the body.</description>
        <stages>
            <li>
                <becomeVisible>false</becomeVisible>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.08</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="OAHediff_GeneGiveBase">
        <defName>OAGene_SurvivalInstinct</defName>
        <label>Survival Instinct</label>
        <description>Due to the enemy's approach, an instinctive fear response was triggered, and adrenaline levels rapidly increased.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <initialSeverity>1.0</initialSeverity>
        <minSeverity>1.0</minSeverity>
        <maxSeverity>2.0</maxSeverity>
        <stages>
            <li>
                <minSeverity>1.0</minSeverity>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.1</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.10</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>2.0</minSeverity>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.25</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.20</offset>
                    </li>
                </capMods>
                <statOffsets>
                    <MentalBreakThreshold>0.1</MentalBreakThreshold>
                </statOffsets>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>500</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="OAHediff_GeneGiveBase">
        <defName>OAGene_BloodCellsAutophagy</defName>
        <label>Autophagy of blood cells</label>
        <description>Due to malnutrition, the body begins to spontaneously break down blood cells, which is a slow process. However, if malnutrition persists, it can also escalate into a fatal condition.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <!--stages>
            <li>
                <hungerRateFactor>0.5</hungerRateFactor>
            </li>
        </stages-->
        <comps>
            <li Class="OberoniaAureaGene.HediffCompProperties_BloodLoss">
                <bleedRatePreTick>0.0000122</bleedRatePreTick>
            </li>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>30000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="OAHediff_GeneGiveBase">
        <defName>OAGene_DeepSleep</defName>
        <label>Deep Sleep</label>
        <description>The loss of hunger caused by the deep sleep gene is reduced.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <stages>
            <li>
                <becomeVisible>false</becomeVisible>
                <hungerRateFactor>0.25</hungerRateFactor>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>750</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="OAHediff_GeneGiveBase">
        <defName>OAGene_ObedientServitudeHidden</defName>
        <label>(Hidden)Obedient Servitude</label>
        <description>(Hidden)奴役顺从隐藏状态</description>
        <hediffClass>HediffWithComps</hediffClass>
        <stages>
            <li>
                <becomeVisible>false</becomeVisible>
                <blocksInspirations>true</blocksInspirations>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="OAHediff_GeneGiveBase">
        <defName>OAGene_ObeyOrderForceJob</defName>
        <label>Blind obedience to commands</label>
        <description>Thanks to the innate obedience to commands, one can wholeheartedly focus on executing itself. It should not appear at present.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <stages>
            <li>
				<becomeVisible>false</becomeVisible>
                <!--statOffsets>
                    <WorkSpeedGlobal>0.25</WorkSpeedGlobal>
                    <MentalBreakThreshold>-0.1</MentalBreakThreshold>
                </statOffsets-->
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1250</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="OAHediff_GeneGiveBase">
        <defName>OAGene_ObeyOrderWorking</defName>
        <label>Blind obedience control</label>
        <description>Due to the innate obedience in genes, it can ensure that there is no unnecessary mental disturbance during work.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <stages>
            <li>
                <statOffsets>
                    <MoveSpeed>0.2</MoveSpeed>
					<WorkSpeedGlobal>0.05</WorkSpeedGlobal>
                    <MentalBreakThreshold>-0.08</MentalBreakThreshold>
                    <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.2</SlaveSuppressionOffset>
                </statOffsets>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1250</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="OAHediff_GeneGiveBase">
        <defName>OAGene_ObeyOrderNonDraft</defName>
        <label>Not conscripted</label>
        <description>The nature of genes yearns for commands. When there is no direct command for a long time, conflicts between oneself and genes gradually arise, which in turn affects work enthusiasm.</description>
        <hediffClass>OberoniaAureaGene.Hediff_ObeyOrderNonDraft</hediffClass>
        <stages>
            <li>
                <statOffsets>
                    <WorkSpeedGlobal>-0.08</WorkSpeedGlobal>
                </statOffsets>
            </li>
            <li>
                <minSeverity>2.0</minSeverity>
                <statOffsets>
                    <WorkSpeedGlobal>-0.16</WorkSpeedGlobal>
                </statOffsets>
            </li>
            <li>
                <minSeverity>3.0</minSeverity>
                <statOffsets>
                    <WorkSpeedGlobal>-0.24</WorkSpeedGlobal>
                </statOffsets>
            </li>
            <li>
                <minSeverity>4.0</minSeverity>
                <statOffsets>
                    <WorkSpeedGlobal>-0.32</WorkSpeedGlobal>
                </statOffsets>
            </li>
            <li>
                <minSeverity>5.0</minSeverity>
                <statOffsets>
                    <WorkSpeedGlobal>-0.40</WorkSpeedGlobal>
                </statOffsets>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1250</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

</Defs>