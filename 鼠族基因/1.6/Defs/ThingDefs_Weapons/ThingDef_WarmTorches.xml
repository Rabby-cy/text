<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BaseMeleeWeapon">
        <defName>OAGene_PortableTorch</defName>
        <label>手提火把</label>
        <description>一只简易的手提式火把，能够为携带者提供一定的温暖。\n装备时会缓慢的降低低温症，同时耐久度也会缓慢的降低。\n\n极端暴风雪天气会导致耐久度快速下降。</description>

        <graphicData>
            <texPath>Things/Equipment/OAGene_PortableTorch</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.85,0.85)</drawSize>
        </graphicData>
        <uiIconScale>1.2</uiIconScale>
        <equippedAngleOffset>-65</equippedAngleOffset>
        <tickerType>Rare</tickerType>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToMake>2700</WorkToMake>
            <Mass>1.2</Mass>
        </statBases>
        <possessionCount>1</possessionCount>
        <techLevel>Medieval</techLevel>
        <equippedStatOffsets>
            <ComfyTemperatureMin>-10.6</ComfyTemperatureMin>
        </equippedStatOffsets>
        <costList>
            <WoodLog>20</WoodLog>
        </costList>
        <recipeMaker>
            <recipeUsers>
                <li>CraftingSpot</li>
            </recipeUsers>
            <!--skillRequirements>
                <Crafting>3</Crafting>
            </skillRequirements-->
            <displayPriority>400</displayPriority>
        </recipeMaker>
        <comps>
            <li Class="OberoniaAureaGene.CompProperties_WarmTorch"> <!-- 这个comp通过Hediff实现低温症减少和耐久降低 -->
                <hypothermiaReducePerHour>0.028</hypothermiaReducePerHour>
                <hitPointsReducePerHour>1</hitPointsReducePerHour>
                <hitPointsExtraReducePerHourSnowStorm>5</hitPointsExtraReducePerHourSnowStorm>
                <warmTorchHediff>OAGene_WarmTorch</warmTorchHediff>
            </li>
        </comps>
        <weaponTags>
            <li>MedievalMeleeDecent</li>
        </weaponTags>
        <weaponClasses>
            <li>MeleeBlunt</li>
        </weaponClasses>
        <tools>
            <li>
                <label>杖尾</label>
                <capacities>
                    <li>Poke</li>
                </capacities>
                <power>6</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>杖头</label>
                <!--labelUsedInLogging>false</labelUsedInLogging-->
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9.5</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
    </ThingDef>

    <ThingDef ParentName="BaseMeleeWeapon">
        <defName>OAGene_AntiSnowTorch</defName>
        <label>风雪火把</label>
        <description>一支特地加装了防风罩的火把，能够为风雪中的旅人提供相当的温暖，并且坚硬的杖尖在必要的情况下可以当做武器使用。\n装备时会缓慢的降低低温症，同时耐久度也会缓慢的降低。\n\n极端暴风雪天气会导致耐久度快速下降。</description>
        <graphicData>
            <texPath>Things/Equipment/OAGene_AntiSnowTorch</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.85,0.85)</drawSize>
        </graphicData>
        <uiIconScale>1.2</uiIconScale>
        <equippedAngleOffset>-65</equippedAngleOffset>
        <statBases>
            <MaxHitPoints>200</MaxHitPoints>
            <WorkToMake>6600</WorkToMake>
            <Mass>2.0</Mass>
        </statBases>
        <generateCommonality>0</generateCommonality>
        <generateAllowChance>0</generateAllowChance>
        <possessionCount>1</possessionCount>
        <tickerType>Rare</tickerType>
        <techLevel>Medieval</techLevel>
        <equippedStatOffsets>
            <ComfyTemperatureMin>-15.2</ComfyTemperatureMin>
        </equippedStatOffsets>
        <costList>
            <WoodLog>30</WoodLog>
            <Steel>20</Steel>
        </costList>
        <recipeMaker>
            <recipeUsers>
                <li>CraftingSpot</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>2</Crafting>
            </skillRequirements>
            <displayPriority>400</displayPriority>
        </recipeMaker>
        <comps>
            <li Class="OberoniaAureaGene.CompProperties_WarmTorch">
                <hypothermiaReducePerHour>0.038</hypothermiaReducePerHour>
                <hitPointsReducePerHour>1</hitPointsReducePerHour>
                <hitPointsExtraReducePerHourSnowStorm>5</hitPointsExtraReducePerHourSnowStorm>
                <warmTorchHediff>OAGene_WarmTorch</warmTorchHediff>
            </li>
        </comps>
        <weaponTags>
            <li>MedievalMeleeDecent</li>
        </weaponTags>
        <weaponClasses>
            <li>MeleeBlunt</li>
        </weaponClasses>
        <tools>
            <li>
                <label>杖尾</label>
                <capacities>
                    <li>Poke</li>
                </capacities>
                <power>8.5</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>杖尖</label>
                <!--labelUsedInLogging>false</labelUsedInLogging-->
                <capacities>
                    <li>Poke</li>
                </capacities>
                <power>13</power>
                <cooldownTime>2</cooldownTime>
            </li>
			<li>
                <label>杖头</label>
                <labelUsedInLogging>false</labelUsedInLogging>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>15.5</power>
				<chanceFactor>2.4</chanceFactor>
                <cooldownTime>2.2</cooldownTime>
            </li>
        </tools>
    </ThingDef>

    <HediffDef>
        <defName>OAGene_WarmTorch</defName>
        <label>火把</label>
        <description>实现火把功能的隐藏状态，玩家不需要在意这一条哦（摸摸）</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <duplicationAllowed>false</duplicationAllowed>
        <stages>
            <li>
                <label>Hidden（好像是这么拼的吧？）</label>
                <becomeVisible>false</becomeVisible>
            </li>
        </stages>
        <comps>
            <li Class="OberoniaAureaGene.HediffCompProperties_WarmTorch" />
        </comps>
    </HediffDef>

</Defs>