<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef MayRequire="OARK.RatkinFaction.OberoniaAurea" ParentName="BuildingBase">
        <defName>OAGene_OAGeneRepairInstrument</defName>
        <label>金鸢尾兰基因修复仪</label>
        <description>金鸢尾兰帝国为了治愈基因链受损的患者而研发的一种基因治愈仪器，能够修复受损的基因，加快基因重构进程，并治愈基因缺失带来的冲击。</description>
        <thingClass>OberoniaAureaGene.Building_OAGeneRepairInstrument</thingClass>
        <containedPawnsSelectable>true</containedPawnsSelectable>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.4</fillPercent>
        <castEdgeShadows>true</castEdgeShadows>
        <drawerType>MapMeshAndRealTime</drawerType>
        <tickerType>Normal</tickerType>
        <graphicData>
            <texPath>Things/Building/Production/OAGeneRepairInstrument</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(2, 2)</drawSize>
            <shadowData>
                <volume>(1.7, 0.8, 1.7)</volume>
            </shadowData>
        </graphicData>
        <size>(2, 2)</size>
        <canOverlapZones>false</canOverlapZones>
        <hasInteractionCell>true</hasInteractionCell>
        <interactionCellOffset>(0, 0, 2)</interactionCellOffset>
        <defaultPlacingRot>South</defaultPlacingRot>
        <designationCategory>Biotech</designationCategory>
        <uiOrder>2100</uiOrder>
        <researchPrerequisites>
            <li>OA_RK_RatkinGene</li>
        </researchPrerequisites>
        <building>
            <buildingTags>
                <li>Biotech</li>
            </buildingTags>
        </building>
        <statBases>
            <MaxHitPoints>250</MaxHitPoints>
            <WorkToBuild>30000</WorkToBuild>
            <Mass>55</Mass>
            <Flammability>0.5</Flammability>
        </statBases>
        <costList>
            <Steel>105</Steel>
			<Uranium>25</Uranium>
			<Plasteel>50</Plasteel>
            <ComponentIndustrial>6</ComponentIndustrial>
        </costList>
        <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>800</basePowerConsumption>
                <idlePowerDraw>300</idlePowerDraw>
            </li>
            <li Class="CompProperties_Flickable" />
			<li Class="CompProperties_Glower">
				<glowRadius>2</glowRadius>
				<glowColor>(200,180,180,0)</glowColor>
				<colorPickerEnabled>false</colorPickerEnabled>
				<darklightToggle>false</darklightToggle>
			</li>
        </comps>
    </ThingDef>

</Defs>