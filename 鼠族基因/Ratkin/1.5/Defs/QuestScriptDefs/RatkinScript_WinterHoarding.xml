<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <QuestScriptDef>
        <defName>OAGene_WinterHoarding</defName>
        <rootSelectionWeight>0.8</rootSelectionWeight>
        <rootMinProgressScore>8</rootMinProgressScore>
        <defaultChallengeRating>1</defaultChallengeRating>
        <expireDaysRange>4~8</expireDaysRange>
        <minRefireDays>30</minRefireDays>
        <questNameRules>
            <rulesStrings>
                <li>questName->过冬囤积</li>
                <li>questName->冬日储备</li>
                <li>questName->[settlement_label]的过冬储备</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <li>questDescription->附近的鼠族定居点[settlement_label]，向我们发来了一份特殊的交易订单。\n为了迎接不日后到来的寒流，并保证她们在和谐中度过这个冬季，为此她们想要采购以下物资：\n\n任意[requestedCategory_label]共计 x [requestedThingCount]（总价值：[requestedThingMarketValue_money]）\n\n如果我们接受这份交易订单，则需要派出一支携带相应物资的远行队前往目标地点。\n旅途预估时间：[estimatedTravelTime_duration]。</li>
            </rulesStrings>
        </questDescriptionRules>
        <root Class="QuestNode_Sequence">
            <nodes>
                <li Class="OberoniaAurea_Frame.QuestNode_EarliestDayPassed"> <!-- 落地时间限制 -->
                    <earliestDayPassed>60</earliestDayPassed>
                </li>

                <li Class="QuestNode_GetMap" />

                <li Class="OberoniaAurea_Frame.QuestNode_SeasonalRestriction"> <!-- 季节限制 -->
                    <allowSpring>false</allowSpring>
                    <allowWinter>false</allowWinter>
                </li>

                <li Class="OberoniaAurea_Frame.QuestNode_GetRatkinFaction"> <!-- 获取鼠鼠派系 -->
                    <allowAlly>true</allowAlly>
                    <allowNeutral>true</allowNeutral>
                    <allowEnemy>false</allowEnemy>
                    <storeAs>ratkinFaction</storeAs>
                </li>
                <li Class="OberoniaAurea_Frame.QuestNode_GetFactionLeader"> <!-- 获取派系领导人 -->
                    <faction>$ratkinFaction</faction>
                    <storeAs>asker</storeAs>
                </li>
                <li Class="OberoniaAurea_Frame.QuestNode_GetNearbySettlementOfFaction"> <!-- 获取临近的派系定居点 -->
                    <maxTileDistance>24</maxTileDistance>
                    <faction>$ratkinFaction</faction>
                    <storeAs>settlement</storeAs>
                </li>

                <li Class="QuestNode_TradeRequest_RandomOfferDuration">
                    <settlement>$settlement</settlement>
                    <storeAs>timeout</storeAs>
                    <storeEstimatedTravelTimeAs>estimatedTravelTime</storeEstimatedTravelTimeAs>
                </li>

                <li Class="OberoniaAurea_Frame.QuestNode_RequestThingCount">
                    <storeAs>requestedThingCount</storeAs>
                    <baseRange>500</baseRange>
                    <baseOffset>0~0.2</baseOffset>
                    <preOffsetWealth>10000</preOffsetWealth>
                    <preOffsetCount>200</preOffsetCount>
                    <maxCountLimit>12000</maxCountLimit>
                </li>

                <li Class="QuestNode_Chance">
                    <chance>0.5</chance>
                    <node Class="QuestNode_Sequence"> <!-- 肉类 -->
                        <nodes>
                            <li Class="OberoniaAurea_Frame.QueseNode_GetExpectedCategoryMarketValue">
                                <storeThingCategoryAs>requestedCategory</storeThingCategoryAs>
                                <storeMarketValueAs>requestedThingMarketValue</storeMarketValueAs>
                                <expectedThingCategory>MeatRaw</expectedThingCategory>
                                <storeThingCategory>true</storeThingCategory>
                                <unitPrice>1.8</unitPrice>
                                <expectedThingCount>$requestedThingCount</expectedThingCount>
                            </li>
                            <li Class="QuestNode_Set">
                                <name>requestIsMeat</name>
                                <value>true</value>
                            </li>
                        </nodes>
                    </node>
                    <elseNode Class="QuestNode_Sequence"> <!-- 素食 -->
                        <nodes>
                            <li Class="OberoniaAurea_Frame.QueseNode_GetExpectedCategoryMarketValue">
                                <storeThingCategoryAs>requestedCategory</storeThingCategoryAs>
                                <storeMarketValueAs>requestedThingMarketValue</storeMarketValueAs>
                                <expectedThingCategory>PlantFoodRaw</expectedThingCategory>
                                <storeThingCategory>true</storeThingCategory>
                                <unitPrice>1.02</unitPrice> <!-- 物品单价 -->
                                <expectedThingCount>$requestedThingCount</expectedThingCount>
                            </li>
                            <li Class="QuestNode_Set">
                                <name>requestIsMeat</name>
                                <value>false</value>
                            </li>
                        </nodes>
                    </elseNode>
                </li>

                <li Class="OberoniaAurea_Frame.QuestNode_InitiateCategoryTradeRequest">
                    <settlement>$settlement</settlement>
                    <requestedCategoryDef>$requestedCategory</requestedCategoryDef>
                    <requestedThingCount>$requestedThingCount</requestedThingCount>
                    <duration>$timeout</duration>
                    <requestIsMeat>$requestIsMeat</requestIsMeat>
                </li>

                <!-- Rewards -->
                <li Class="QuestNode_Set">
                    <name>rewardValue</name>
                    <value>$($requestedThingMarketValue * randFloat(1.25, 1.35))</value>
                </li>

                <li Class="QuestNode_GiveRewards">
                    <inSignal>settlement.OAFrame_CategoryRQFulfilled</inSignal>
                    <parms>
                        <thingRewardItemsOnly>true</thingRewardItemsOnly>
                        <giveToCaravan>true</giveToCaravan>
                    </parms>
                    <useDifficultyFactor>false</useDifficultyFactor> <!-- we only care about requested total market value -->
                </li>

                <!-- End conditions -->
                <li Class="QuestNode_Letter">
                    <inSignal>ratkinFaction.BecameHostileToPlayer</inSignal>
                    <label TKey="LetterLabelQuestFailed">任务失败：[resolvedQuestName]</label>
                    <text TKey="LetterTextQuestFailed">[ratkinFaction_name]开始与你敌对了。</text>
                </li>

                <li Class="QuestNode_Delay">
                    <delayTicks>$timeout</delayTicks>
                    <isQuestTimeout>true</isQuestTimeout>
                    <outSignalComplete>TradeRequestTimeout</outSignalComplete>
                </li>

                <!-- End outcomes -->

                <li Class="QuestNode_AnySignal">
                    <inSignals>
                        <li>ratkinFaction.BecameHostileToPlayer</li>
                        <li>TradeRequestTimeout</li>
                    </inSignals>
                    <node Class="QuestNode_End">
                        <outcome>Fail</outcome>
                    </node>
                </li>

                <li Class="QuestNode_End">
                    <inSignal>settlement.OAFrame_CategoryRQFulfilled</inSignal>
                    <outcome>Success</outcome>
                    <sendStandardLetter>true</sendStandardLetter>
                </li>

            </nodes>
        </root>
    </QuestScriptDef>

</Defs>