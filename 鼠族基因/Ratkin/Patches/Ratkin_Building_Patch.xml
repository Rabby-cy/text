<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>[OA]Ratkin Faction: Oberonia aurea</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/ThingDef/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities[./li[text()="GeneBank"]]</xpath>
                    <value>
                        <li>OAGene_OAGeneBank</li>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/ThingDef/descriptionHyperlinks[./ThingDef[text()="GeneBank"]]</xpath>
                    <value>
                        <ThingDef>OAGene_OAGeneBank</ThingDef>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/ThingDef/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities[./li[text()="GeneProcessor"]]</xpath>
                    <value>
                        <li>OAGene_OAGeneProcessor</li>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/ThingDef/descriptionHyperlinks[./ThingDef[text()="GeneProcessor"]]</xpath>
                    <value>
                        <ThingDef>OAGene_OAGeneProcessor</ThingDef>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>

</Patch>