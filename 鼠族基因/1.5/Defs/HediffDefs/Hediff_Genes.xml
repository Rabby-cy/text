<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef Name="OAHediff_GeneGiveBase" Abstract="true">
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <duplicationAllowed>false</duplicationAllowed>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    </HediffDef>

    <HediffDef ParentName="OAHediff_GeneGiveBase">
        <defName>OAGene_EfficientNeuron</defName>
        <label>Efficient nervous system</label>
        <description>Carriers of this gene have an abnormally developed nervous system, which makes their thinking speed much faster than that of ordinary people, but such a developed nervous system can also have a certain impact on the body.</description>
        <stages>
            <li>
                <becomeVisible>false</becomeVisible>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.08</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef ParentName="OAHediff_GeneGiveBase">
        <defName>OAGene_SurvivalInstinct</defName>
        <label>Survival Instinct</label>
        <description>Due to the enemy's approach, an instinctive fear response was triggered, and adrenaline levels rapidly increased.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <initialSeverity>1.0</initialSeverity>
        <minSeverity>1.0</minSeverity>
        <maxSeverity>2.0</maxSeverity>
        <stages>
            <li>
                <minSeverity>1.0</minSeverity>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.1</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.05</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>2.0</minSeverity>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.2</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.15</offset>
                    </li>
                </capMods>
                <statOffsets>
                    <MentalBreakThreshold>0.1</MentalBreakThreshold>
                </statOffsets>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>500</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="OAHediff_GeneGiveBase">
        <defName>OAGene_BloodCellsAutophagy</defName>
        <label>Autophagy of blood cells</label>
        <description>Due to malnutrition, the body begins to spontaneously break down blood cells, which is a slow process. However, if malnutrition persists, it can also escalate into a fatal condition.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <!--stages>
            <li>
                <hungerRateFactor>0.5</hungerRateFactor>
            </li>
        </stages-->
        <comps>
            <li Class="OberoniaAureaGene.HediffCompProperties_BloodLoss">
                <bleedRatePreTick>0.0000112</bleedRatePreTick>
            </li>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>30000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="OAHediff_GeneGiveBase">
        <defName>OAGene_DeepSleep</defName>
        <label>Deep Sleep</label>
        <description>The loss of hunger caused by the deep sleep gene is reduced.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <stages>
            <li>
				<becomeVisible>false</becomeVisible>
                <hungerRateFactor>0.25</hungerRateFactor>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>750</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

</Defs>