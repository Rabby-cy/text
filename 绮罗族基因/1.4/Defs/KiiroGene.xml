<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneCategoryDef>
    <defName>Kiiro_GeneCategory</defName>
    <label>kiiro</label>
    <displayPriorityInXenotype>530</displayPriorityInXenotype>
  </GeneCategoryDef>

  <GeneDef Name="KiiroGeneBase" Abstract="True">
    <displayCategory>Kiiro_GeneCategory</displayCategory>
	<randomChosen>true</randomChosen>
  </GeneDef>

  <!--慵懒-->
  <GeneDef ParentName="KiiroGeneBase">
    <defName>Kiiro_Lethargic</defName>
    <label>lethargic</label>
    <description>Carriers of this gene become sleepy easier, and have trouble concentrating while studying and researching.</description>
    <iconPath>Kiiro/Icon/Gene_lethargic</iconPath>
    <displayOrderInCategory>10</displayOrderInCategory>
	<!-- <selectionWeight>0.2</selectionWeight> -->
    <statFactors>
      <RestFallRateFactor>1.1</RestFallRateFactor>
      <RestRateMultiplier>0.9</RestRateMultiplier>
	  <GlobalLearningFactor>0.9</GlobalLearningFactor>
	  <ResearchSpeed>0.8</ResearchSpeed>
    </statFactors>
    <biostatMet>2</biostatMet>
	<exclusionTags>
      <li>Sleep</li>
    </exclusionTags>
	<symbolPack>
      <prefixSymbols>
        <li><symbol>sleep</symbol></li>
        <li><symbol>bed</symbol></li>
        <li><symbol>somno</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>loaf</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

  <!--交际猫-->
  <GeneDef ParentName="KiiroGeneBase">
    <defName>Kiiro_SocialCat</defName>
    <label>social cat</label>
    <description>Carriers of this gene become more social.</description>
    <iconPath>Kiiro/Icon/Gene_SocialCat</iconPath>
	<socialFightChanceFactor>0</socialFightChanceFactor>
    <displayOrderInCategory>20</displayOrderInCategory>
	<!-- <selectionWeight>0.2</selectionWeight> -->
    <statFactors>
      <SocialImpact>1.2</SocialImpact>
      <TradePriceImprovement>1.2</TradePriceImprovement>
    </statFactors>
    <biostatMet>-1</biostatMet>
	<exclusionTags>
      <li>Kiiro_SocialCat</li>
    </exclusionTags>
  </GeneDef>
  
  <!--细心烹饪-->
  <GeneDef ParentName="KiiroGeneBase">
    <defName>Kiiro_FineCook</defName>
    <label>fine cook</label>
    <description>Carriers of this gene spend more time to cook, but greatly reduce poisonous food probability; also spend more time butchering to produce more.</description>
    <iconPath>Kiiro/Icon/Gene_FineCook</iconPath>
    <displayOrderInCategory>30</displayOrderInCategory>
	<!-- <selectionWeight>0.2</selectionWeight> -->
    <statFactors>
      <CookSpeed>0.6</CookSpeed>
      <FoodPoisonChance>0.2</FoodPoisonChance>
	  <ButcheryFleshEfficiency>1.15</ButcheryFleshEfficiency>
      <ButcheryFleshSpeed>0.6</ButcheryFleshSpeed>
    </statFactors>
    <biostatMet>-1</biostatMet>
	<exclusionTags>
      <li>Kiiro_FineCook</li>
      <li>Kiiro_FineCook</li>
    </exclusionTags>
  </GeneDef>
  
  <!--不擅医疗-->
  <GeneDef ParentName="KiiroGeneBase">
    <defName>Kiiro_MedicWeak</defName>
    <label>medic weakness</label>
    <description>Carriers of this gene not good at medicine.</description>
    <iconPath>Kiiro/Icon/Gene_MedicWeak</iconPath>
    <displayOrderInCategory>40</displayOrderInCategory>
	<!-- <selectionWeight>0.2</selectionWeight> -->
    <statFactors>
      <DrugSynthesisSpeed>0.75</DrugSynthesisSpeed>
	  <MedicalTendSpeed>0.75</MedicalTendSpeed>
	  <MedicalTendQuality>0.85</MedicalTendQuality>
	  <MedicalSurgerySuccessChance>0.8</MedicalSurgerySuccessChance>
    </statFactors>
    <biostatMet>2</biostatMet>
	<exclusionTags>
      <li>Kiiro_MedicWeak</li>
    </exclusionTags>
  </GeneDef>
  
  <!--不擅机械-->
  <GeneDef ParentName="KiiroGeneBase">
    <defName>Kiiro_MechineWeak</defName>
    <label>machine weakness</label>
    <description>Carriers of this gene not good at machine.</description>
    <iconPath>Kiiro/Icon/Gene_MechineWeak</iconPath>
    <displayOrderInCategory>50</displayOrderInCategory>
	<!-- <selectionWeight>0.2</selectionWeight> -->
    <statFactors>
      <ButcheryMechanoidEfficiency>0.8</ButcheryMechanoidEfficiency>
      <ButcheryMechanoidSpeed>0.8</ButcheryMechanoidSpeed>
    </statFactors>
    <biostatMet>1</biostatMet>
	<exclusionTags>
      <li>Kiiro_MechineWeak</li>
    </exclusionTags>
  </GeneDef>
  
  <!--不擅种植-->
  <GeneDef ParentName="KiiroGeneBase">
    <defName>Kiiro_PlantsWeak</defName>
    <label>plants weakness</label>
    <description>Carriers of this gene not good at plants.</description>
    <iconPath>Kiiro/Icon/Gene_PlantsWeak</iconPath>
    <displayOrderInCategory>60</displayOrderInCategory>
	<!-- <selectionWeight>0.2</selectionWeight> -->
    <statFactors>
      <PlantWorkSpeed>0.6</PlantWorkSpeed>
	  <PlantHarvestYield>0.8</PlantHarvestYield>
    </statFactors>
    <biostatMet>2</biostatMet>
	<exclusionTags>
      <li>Kiiro_PlantWeak</li>
    </exclusionTags>
  </GeneDef>
  
  <!--不擅采矿-->
  <GeneDef ParentName="KiiroGeneBase">
    <defName>Kiiro_MiningWeak</defName>
    <label>mining weakness</label>
    <description>Carriers of this gene not good at mining.</description>
    <iconPath>Kiiro/Icon/Gene_MiningWeak</iconPath>
    <displayOrderInCategory>70</displayOrderInCategory>
	<!-- <selectionWeight>0.2</selectionWeight> -->
    <statFactors>
      <MiningSpeed>0.4</MiningSpeed>
	  <MiningYield>0.75</MiningYield>
    </statFactors>
    <biostatMet>2</biostatMet>
	<exclusionTags>
      <li>Kiiro_MiningWeak</li>
    </exclusionTags>
  </GeneDef>
  
  <!--敏捷格斗-->
  <GeneDef ParentName="KiiroGeneBase">
    <defName>Kiiro_NimbleCombat</defName>
    <label>nimble combat</label>
    <description>Carriers of this gene born with nimble combat skills.</description>
    <iconPath>Kiiro/Icon/Gene_NimbleCombat</iconPath>
    <displayOrderInCategory>80</displayOrderInCategory>
	<!-- <selectionWeight>0.2</selectionWeight> -->
    <statFactors>
      <MeleeDodgeChance>1.2</MeleeDodgeChance>
	  <MeleeHitChance>1.5</MeleeHitChance>
    </statFactors>
    <biostatMet>-2</biostatMet>
	<biostatCpx>2</biostatCpx>
	<exclusionTags>
      <li>Kiiro_NimbleCombat</li>
      <li>MeleeDamage</li>
    </exclusionTags>
	<symbolPack>
      <prefixSymbols>
        <li><symbol>death</symbol></li>
        <li><symbol>kill</symbol></li>
        <li><symbol>slay</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>killer</symbol></li>
        <li><symbol>slayer</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>
  
  <!--精确射击-->
  <GeneDef ParentName="KiiroGeneBase">
    <defName>Kiiro_PreciseAiming</defName>
    <label>precise aiming</label>
    <description>Carriers of this gene born with higher shooting accuracy.</description>
    <iconPath>Kiiro/Icon/Gene_PreciseAiming</iconPath>
    <displayOrderInCategory>90</displayOrderInCategory>
	<!-- <selectionWeight>0.2</selectionWeight> -->
    <statFactors>
      <ShootingAccuracyPawn>1.5</ShootingAccuracyPawn>
	  <AimingDelayFactor>1.1</AimingDelayFactor>
    </statFactors>
    <biostatMet>-2</biostatMet>
	<biostatCpx>2</biostatCpx>
	<exclusionTags>
      <li>Kiiro_PreciseAiming</li>
      <li>ShootingAccuracy</li>
    </exclusionTags>
  </GeneDef>
  
  <!--易碎的心-->
  <GeneDef ParentName="KiiroGeneBase">
    <defName>Kiiro_FragileHeart</defName>
    <label>fragile heart</label>
    <description>Carriers of this gene become easier mental break.</description>
    <iconPath>Kiiro/Icon/Gene_FragileHeart</iconPath>
    <displayOrderInCategory>100</displayOrderInCategory>
	<!-- <selectionWeight>0.2</selectionWeight> -->
    <statFactors>
      <MentalBreakThreshold>1.4</MentalBreakThreshold>
    </statFactors>
    <biostatMet>3</biostatMet>
	<exclusionTags>
      <li>Kiiro_FragileHeart</li>
    </exclusionTags>
  </GeneDef>
  
  <!--怕痛-->
  <GeneDef ParentName="KiiroGeneBase">
    <defName>Kiiro_PainFearing</defName>
    <label>pain fearing</label>
    <description>Carriers of this gene become easier pain shock.</description>
    <iconPath>Kiiro/Icon/Gene_PainFearing</iconPath>
    <displayOrderInCategory>110</displayOrderInCategory>
	<!-- <selectionWeight>0.2</selectionWeight> -->
    <statFactors>
      <PainShockThreshold>0.8</PainShockThreshold>
    </statFactors>
    <biostatMet>1</biostatMet>
	<exclusionTags>
      <li>Kiiro_PainFearing</li>
      <li>Toughness</li>
    </exclusionTags>
  </GeneDef>


</Defs>